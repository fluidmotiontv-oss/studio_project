    <script>
        // --- WEB AUDIO MIXER SYNTH ENGINE ---
        let audioCtx = null;
        let isPlaying = false;
        
        // Node holders
        let drumsNode = null, bassNode = null, melodyNode = null, vocalsNode = null;
        let drumsGain = null, bassGain = null, melodyGain = null, vocalsGain = null;

        // Mixer fader/mute state
        let mixerState = {
            drums: { val: 0.8, muted: false },
            bass: { val: 0.8, muted: false },
            melody: { val: 0.8, muted: false },
            vocals: { val: 0.8, muted: false },
            tempo: 120
        };

        const defaultTracks = [
            { id: "beat6", title: "FUTURE FRWARD BEAT 6", desc: "High-resonance drum synth and filtered vocal loop matrix.", tempo: 120, synth: "beat6" },
            { id: "bassline", title: "DEEP SYNTH DRONES", desc: "Low-end analog sawtooth drones and metallic melody clicks.", tempo: 90, synth: "bassline" },
            { id: "harmony", title: "RAINBOW IN THE DARK", desc: "Lively retro detuned arpeggiators and floating synth chords.", tempo: 135, synth: "harmony" }
        ];

        let currentTrackId = 'beat6';

        function getTrackById(trackId) {
            return currentSettings.tracks.find(t => t.id === trackId) || defaultTracks[0];
        }

        function initAudioEngine() {
            if (audioCtx) return;
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();

            // Create Gain Nodes
            drumsGain = audioCtx.createGain();
            bassGain = audioCtx.createGain();
            melodyGain = audioCtx.createGain();
            vocalsGain = audioCtx.createGain();

            // Connect Gain Nodes to destination
            drumsGain.connect(audioCtx.destination);
            bassGain.connect(audioCtx.destination);
            melodyGain.connect(audioCtx.destination);
            vocalsGain.connect(audioCtx.destination);

            applyMixerGainValues();
            startSynthLoops();
        }

        function applyMixerGainValues() {
            if (!audioCtx) return;
            drumsGain.gain.setValueAtTime(mixerState.drums.muted ? 0 : mixerState.drums.val, audioCtx.currentTime);
            bassGain.gain.setValueAtTime(mixerState.bass.muted ? 0 : mixerState.bass.val, audioCtx.currentTime);
            melodyGain.gain.setValueAtTime(mixerState.melody.muted ? 0 : mixerState.melody.val, audioCtx.currentTime);
            vocalsGain.gain.setValueAtTime(mixerState.vocals.muted ? 0 : mixerState.vocals.val, audioCtx.currentTime);
        }

        function setStemVolume(stem, val) {
            mixerState[stem].val = parseFloat(val);
            applyMixerGainValues();
        }

        function toggleMute(stem) {
            mixerState[stem].muted = !mixerState[stem].muted;
            const btn = document.getElementById(`mute-${stem}`);
            if (mixerState[stem].muted) {
                btn.classList.add('active');
                btn.innerText = "MUTED";
            } else {
                btn.classList.remove('active');
                btn.innerText = "MUTE";
            }
            applyMixerGainValues();
        }

        // --- WEB AUDIO POLYPHONIC LOOP GENERATOR ---
        function startSynthLoops() {
            if (!audioCtx) return;

            // Simple Drum Loop (White noise click + low bass drum)
            drumsNode = audioCtx.createScriptProcessor(4096, 0, 1);
            let drumsPhase = 0;
            drumsNode.onaudioprocess = function(e) {
                const out = e.outputBuffer.getChannelData(0);
                const step = 60 / mixerState.tempo / 4; // 16th note step
                const sampleRate = audioCtx.sampleRate;
                const samplesPerStep = Math.floor(step * sampleRate);

                for (let i = 0; i < out.length; i++) {
                    const stepIdx = Math.floor((drumsPhase + i) / samplesPerStep) % 16;
                    const clickIdx = (drumsPhase + i) % samplesPerStep;

                    let sample = 0;
                    // Kick Drum on steps 0, 4, 8, 12
                    if (stepIdx % 4 === 0 && clickIdx < samplesPerStep * 0.25) {
                        const freq = 120 * Math.exp(-clickIdx / (samplesPerStep * 0.08));
                        sample += Math.sin(2 * Math.PI * freq * (clickIdx / sampleRate)) * 0.8;
                    }
                    // Snare click on steps 4, 12
                    if ((stepIdx === 4 || stepIdx === 12) && clickIdx < samplesPerStep * 0.15) {
                        sample += (Math.random() - 0.5) * 0.25;
                    }
                    // Hi-hat on odd steps
                    if (stepIdx % 2 !== 0 && clickIdx < samplesPerStep * 0.05) {
                        sample += (Math.random() - 0.5) * 0.15;
                    }
                    out[i] = sample * 0.5;
                }
                drumsPhase += out.length;
            };
            drumsNode.connect(drumsGain);

            // Simple Bass Synth Loop
            bassNode = audioCtx.createScriptProcessor(4096, 0, 1);
            let bassPhase = 0;
            const bassNotes = {
                beat6: [55.00, 55.00, 65.41, 65.41, 73.42, 73.42, 55.00, 82.41], // A1, C2, D2, E2
                bassline: [41.20, 41.20, 48.99, 48.99, 51.91, 51.91, 41.20, 61.74], // E1, G1, Ab1, B1
                harmony: [65.41, 65.41, 82.41, 82.41, 73.42, 73.42, 98.00, 87.31] // C2, E2, D2, G2
            };
            bassNode.onaudioprocess = function(e) {
                const out = e.outputBuffer.getChannelData(0);
                const step = 60 / mixerState.tempo / 2; // 8th note step
                const sampleRate = audioCtx.sampleRate;
                const samplesPerStep = Math.floor(step * sampleRate);

                const activeTrack = currentSettings.tracks.find(t => t.id === currentTrackId) || { synth: 'beat6' };
                const synthProfile = activeTrack.synth || 'beat6';

                for (let i = 0; i < out.length; i++) {
                    const stepIdx = Math.floor((bassPhase + i) / samplesPerStep) % 8;
                    const clickIdx = (bassPhase + i) % samplesPerStep;

                    const notes = bassNotes[synthProfile] || bassNotes['beat6'];
                    const freq = notes[stepIdx];
                    // Triangle Wave bassline
                    const t = (bassPhase + i) / sampleRate;
                    let sample = Math.abs((t * freq) % 1 - 0.5) * 4 - 1; // Triangle wave approximation
                    
                    // Filter decay envelope
                    const env = Math.exp(-clickIdx / (samplesPerStep * 0.7));
                    out[i] = sample * env * 0.35;
                }
                bassPhase += out.length;
            };
            bassNode.connect(bassGain);

            // Arpeggiated Melody Synth Loop
            melodyNode = audioCtx.createScriptProcessor(4096, 0, 1);
            let melodyPhase = 0;
            const melodyPitches = {
                beat6: [220.00, 275.00, 330.00, 412.50, 440.00, 550.00, 660.00, 825.00],
                bassline: [147.01, 196.00, 220.00, 294.02, 330.00, 392.00, 440.00, 587.33],
                harmony: [261.63, 329.63, 392.00, 523.25, 659.25, 783.99, 1046.50, 880.00]
            };
            melodyNode.onaudioprocess = function(e) {
                const out = e.outputBuffer.getChannelData(0);
                const step = 60 / mixerState.tempo / 4; // 16th note step
                const sampleRate = audioCtx.sampleRate;
                const samplesPerStep = Math.floor(step * sampleRate);

                const activeTrack = currentSettings.tracks.find(t => t.id === currentTrackId) || { synth: 'beat6' };
                const synthProfile = activeTrack.synth || 'beat6';

                for (let i = 0; i < out.length; i++) {
                    const stepIdx = Math.floor((melodyPhase + i) / samplesPerStep) % 8;
                    const clickIdx = (melodyPhase + i) % samplesPerStep;

                    const pitches = melodyPitches[synthProfile] || melodyPitches['beat6'];
                    const freq = pitches[stepIdx];
                    // Sine Wave arpeggiator
                    const t = (melodyPhase + i) / sampleRate;
                    const sample = Math.sin(2 * Math.PI * freq * t);
                    
                    // Decaying click envelope
                    const env = Math.exp(-clickIdx / (samplesPerStep * 0.3));
                    out[i] = sample * env * 0.25;
                }
                melodyPhase += out.length;
            };
            melodyNode.connect(melodyGain);

            // Filtered Chords/Vocal Pad Loop
            vocalsNode = audioCtx.createScriptProcessor(4096, 0, 1);
            let vocalsPhase = 0;
            const chordPitches = {
                beat6: [220.0, 330.0],
                bassline: [164.8, 246.9],
                harmony: [261.6, 392.0]
            };
            vocalsNode.onaudioprocess = function(e) {
                const out = e.outputBuffer.getChannelData(0);
                const sampleRate = audioCtx.sampleRate;

                const activeTrack = currentSettings.tracks.find(t => t.id === currentTrackId) || { synth: 'beat6' };
                const synthProfile = activeTrack.synth || 'beat6';
                
                for (let i = 0; i < out.length; i++) {
                    const t = (vocalsPhase + i) / sampleRate;
                    const chords = chordPitches[synthProfile] || chordPitches['beat6'];
                    const f1 = chords[0];
                    const f2 = chords[1];

                    // Combined sine chords filter sweep simulation
                    const mod = Math.sin(2 * Math.PI * 0.25 * t); // Slow LFO
                    const sample = (Math.sin(2 * Math.PI * f1 * t) + Math.sin(2 * Math.PI * f2 * t)) * (0.3 + 0.1 * mod);
                    out[i] = sample * 0.3;
                }
                vocalsPhase += out.length;
            };
            vocalsNode.connect(vocalsGain);
        }

        function stopSynthLoops() {
            if (drumsNode) { drumsNode.disconnect(); drumsNode = null; }
            if (bassNode) { bassNode.disconnect(); bassNode = null; }
            if (melodyNode) { melodyNode.disconnect(); melodyNode = null; }
            if (vocalsNode) { vocalsNode.disconnect(); vocalsNode = null; }
        }

        function toggleMasterPlay() {
            const btn = document.getElementById('btn-master-play');
            const vinyl = document.getElementById('vinyl-disc');
            if (isPlaying) {
                // Stop audio
                stopSynthLoops();
                isPlaying = false;
                btn.innerText = "⚡ START AUDIO RESONANCE";
                btn.style.background = "rgba(0, 229, 255, 0.1)";
                btn.style.borderColor = "var(--accent)";
                vinyl.style.animationPlayState = 'paused';
            } else {
                // Start Audio context & loops
                initAudioEngine();
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                isPlaying = true;
                btn.innerText = "🛑 HALT AUDIO RESONANCE";
                btn.style.background = "rgba(255, 0, 128, 0.15)";
                btn.style.borderColor = "var(--highlight)";
                vinyl.style.animationPlayState = 'running';
            }
        }

        function changeTrack(trackId) {
            currentTrackId = trackId;
            const track = getTrackById(trackId);
            mixerState.tempo = track.tempo;
            document.getElementById('current-track-name').innerText = track.title.toUpperCase();
            document.getElementById('current-track-desc').innerText = track.desc;
        }

        // --- WHITE-LABEL ADMIN STATE & LOCAL STORAGE ---
        let currentSettings = {
            crateTitle: "Sovereign Stem Crate",
            artistName: "Corey",
            vaultKey: "BEATS_FLOW",
            price: "$25.00 USD",
            accentColor: "#00e5ff",
            tracks: []
        };
        let tempSettings = null; // Hold draft settings while editing

        function loadAdminSettings() {
            const saved = localStorage.getItem('d9_stemcrate_settings');
            if (saved) {
                currentSettings = JSON.parse(saved);
            }
            if (!currentSettings.tracks || currentSettings.tracks.length === 0) {
                currentSettings.tracks = JSON.parse(JSON.stringify(defaultTracks));
            }
            applyConfigSettings();
        }

        function applyConfigSettings() {
            // Apply variables
            document.getElementById('portal-logo').innerText = currentSettings.crateTitle.toUpperCase();
            document.getElementById('session-brand').innerText = `LICENSED FOR: ${currentSettings.artistName.toUpperCase()}`;
            document.getElementById('lock-card-title').innerText = currentSettings.crateTitle;
            document.getElementById('lock-card-subtitle').innerText = `Exclusive Digital Album by ${currentSettings.artistName}`;
            document.getElementById('price-tag-display').innerText = `LICENSE VALUE: ${currentSettings.price}`;
            document.getElementById('hint-key-label').innerText = currentSettings.vaultKey;

            // Apply theme color
            document.documentElement.style.setProperty('--accent', currentSettings.accentColor);
            
            let r = 0, g = 229, b = 255;
            if (currentSettings.accentColor.startsWith('#')) {
                const hex = currentSettings.accentColor.substring(1);
                if (hex.length === 6) {
                    r = parseInt(hex.substring(0, 2), 16);
                    g = parseInt(hex.substring(2, 4), 16);
                    b = parseInt(hex.substring(4, 6), 16);
                }
            }
            document.documentElement.style.setProperty('--accent-glow', `rgba(${r}, ${g}, ${b}, 0.25)`);

            // Rebuild track list select dropdown
            const selectEl = document.getElementById('track-mix-select');
            const savedSelectedVal = selectEl.value;
            selectEl.innerHTML = '';
            
            currentSettings.tracks.forEach((track, idx) => {
                const opt = document.createElement('option');
                opt.value = track.id;
                opt.innerText = `TRACK ${String(idx + 1).padStart(2, '0')}: ${track.title.toUpperCase()}`;
                selectEl.appendChild(opt);
            });

            // Restore selection or select the first track
            const trackExists = currentSettings.tracks.some(t => t.id === savedSelectedVal);
            if (trackExists) {
                selectEl.value = savedSelectedVal;
                changeTrack(savedSelectedVal);
            } else if (currentSettings.tracks.length > 0) {
                const firstId = currentSettings.tracks[0].id;
                selectEl.value = firstId;
                changeTrack(firstId);
            }
        }

        function switchAdminTab(tabName) {
            const configTab = document.getElementById('admin-tab-config');
            const songsTab = document.getElementById('admin-tab-songs');
            const configBtn = document.getElementById('tab-btn-config');
            const songsBtn = document.getElementById('tab-btn-songs');

            if (tabName === 'config') {
                configTab.style.display = 'block';
                songsTab.style.display = 'none';
                configBtn.style.background = 'var(--accent)';
                configBtn.style.color = '#000';
                songsBtn.style.background = 'rgba(255,255,255,0.05)';
                songsBtn.style.color = '#888';
            } else {
                configTab.style.display = 'none';
                songsTab.style.display = 'block';
                configBtn.style.background = 'rgba(255,255,255,0.05)';
                configBtn.style.color = '#888';
                songsBtn.style.background = 'var(--accent)';
                songsBtn.style.color = '#000';
                renderAdminSongsList();
            }
        }

        function renderAdminSongsList() {
            const listContainer = document.getElementById('admin-songs-list');
            listContainer.innerHTML = '';
            
            const tracks = tempSettings ? tempSettings.tracks : currentSettings.tracks;
            
            if (!tracks || tracks.length === 0) {
                listContainer.innerHTML = '<div style="color: var(--text-muted); text-align: center; padding: 10px;">No tracks added yet.</div>';
                return;
            }

            tracks.forEach((track, index) => {
                const item = document.createElement('div');
                item.style.display = 'flex';
                item.style.justifyContent = 'space-between';
                item.style.alignItems = 'center';
                item.style.padding = '6px 8px';
                item.style.background = 'rgba(255, 255, 255, 0.02)';
                item.style.border = '1px solid rgba(255, 255, 255, 0.05)';
                item.style.borderRadius = '4px';

                item.innerHTML = `
                    <div style="flex-grow: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 10px;">
                        <span style="color: var(--accent); font-weight: bold;">[${track.synth.toUpperCase()}]</span> 
                        <span style="color: #fff;">${track.title}</span> 
                        <span style="color: var(--text-muted); font-size: 0.65rem;">(${track.tempo} BPM)</span>
                    </div>
                    <button onclick="removeSong(${index})" style="background: rgba(255, 0, 128, 0.15); border: 1px solid var(--highlight); color: var(--highlight); padding: 2px 6px; font-size: 0.6rem; cursor: pointer; border-radius: 3px; font-family: 'Orbitron', sans-serif;">DELETE</button>
                `;
                listContainer.appendChild(item);
            });
        }

        function removeSong(index) {
            if (confirm("Are you sure you want to remove this track?")) {
                if (tempSettings && tempSettings.tracks) {
                    tempSettings.tracks.splice(index, 1);
                } else {
                    currentSettings.tracks.splice(index, 1);
                }
                renderAdminSongsList();
            }
        }

        function addNewSongToState() {
            const titleInput = document.getElementById('new-song-title');
            const descInput = document.getElementById('new-song-desc');
            const synthInput = document.getElementById('new-song-synth');
            const bpmInput = document.getElementById('new-song-bpm');

            const title = titleInput.value.trim();
            const desc = descInput.value.trim() || "Dynamic synth loop track.";
            const synth = synthInput.value;
            const tempo = parseInt(bpmInput.value) || 120;

            if (!title) {
                alert("Please enter a track title!");
                return;
            }

            const newTrackId = 'track_' + Date.now();
            const newTrack = {
                id: newTrackId,
                title: title,
                desc: desc,
                tempo: tempo,
                synth: synth
            };

            const target = tempSettings || currentSettings;
            if (!target.tracks) {
                target.tracks = [];
            }
            target.tracks.push(newTrack);

            // Reset inputs
            titleInput.value = '';
            descInput.value = '';
            bpmInput.value = '120';

            renderAdminSongsList();
            alert(`Added "${title}" to the list! Don't forget to click "PUBLISH ALBUM ASSET" to save all changes.`);
        }

        function toggleAdminPanel() {
            const panel = document.getElementById('admin-modal');
            const isOpen = panel.classList.toggle('open');
            if (isOpen) {
                // Create copy for editing
                tempSettings = JSON.parse(JSON.stringify(currentSettings));
                
                // Populate inputs
                document.getElementById('admin-crate-title').value = tempSettings.crateTitle;
                document.getElementById('admin-artist-name').value = tempSettings.artistName;
                document.getElementById('admin-vault-key').value = tempSettings.vaultKey;
                document.getElementById('admin-price').value = tempSettings.price;
                document.getElementById('admin-color-select').value = tempSettings.accentColor;

                switchAdminTab('config');
            } else {
                tempSettings = null;
            }
        }

        function saveAdminSettings() {
            if (!tempSettings) return;

            tempSettings.crateTitle = document.getElementById('admin-crate-title').value.trim() || "Sovereign Stem Crate";
            tempSettings.artistName = document.getElementById('admin-artist-name').value.trim() || "Corey";
            tempSettings.vaultKey = document.getElementById('admin-vault-key').value.trim() || "BEATS_FLOW";
            tempSettings.price = document.getElementById('admin-price').value.trim() || "$25.00 USD";
            tempSettings.accentColor = document.getElementById('admin-color-select').value;

            currentSettings = tempSettings;
            localStorage.setItem('d9_stemcrate_settings', JSON.stringify(currentSettings));
            applyConfigSettings();
            toggleAdminPanel();

            alert(`[MINT SUCCESS] Stem Crate Minted!\n\nLicensed Creator: ${currentSettings.artistName.toUpperCase()}\nTracks registered inside Fluid Motion TV network.`);
        }

        async function exportStandaloneHTML() {
            try {
                // Ensure latest edits from input fields are gathered first
                const tempCrateTitle = document.getElementById('admin-crate-title').value.trim() || "Sovereign Stem Crate";
                const tempArtistName = document.getElementById('admin-artist-name').value.trim() || "Corey";
                const tempVaultKey = document.getElementById('admin-vault-key').value.trim() || "BEATS_FLOW";
                const tempPrice = document.getElementById('admin-price').value.trim() || "$25.00 USD";
                const tempAccentColor = document.getElementById('admin-color-select').value;

                // Sync to draft settings if in editing modal
                const exportSettings = tempSettings ? JSON.parse(JSON.stringify(tempSettings)) : JSON.parse(JSON.stringify(currentSettings));
                exportSettings.crateTitle = tempCrateTitle;
                exportSettings.artistName = tempArtistName;
                exportSettings.vaultKey = tempVaultKey;
                exportSettings.price = tempPrice;
                exportSettings.accentColor = tempAccentColor;

                // Fetch the source HTML of stemcrate.html
                const response = await fetch(window.location.href.split('?')[0]);
                if (!response.ok) throw new Error("Failed to fetch source HTML.");
                let htmlText = await response.text();

                // Build the target replacement block for currentSettings
                const settingsPattern = /let currentSettings = \{[\s\S]*?crateTitle:[\s\S]*?artistName:[\s\S]*?vaultKey:[\s\S]*?price:[\s\S]*?accentColor:[\s\S]*?tracks:[\s\S]*?\};/;
                
                const newSettingsBlock = `let currentSettings = ${JSON.stringify(exportSettings, null, 12)};`;

                if (settingsPattern.test(htmlText)) {
                    htmlText = htmlText.replace(settingsPattern, newSettingsBlock);
                } else {
                    const simplePattern = /let currentSettings = \{[\s\S]*?\};/g;
                    htmlText = htmlText.replace(simplePattern, (match) => {
                        if (match.includes('crateTitle')) {
                            return newSettingsBlock;
                        }
                        return match;
                    });
                }

                // Create blob and download it
                const blob = new Blob([htmlText], { type: 'text/html' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `${exportSettings.crateTitle.toLowerCase().replace(/[^a-z0-9]/g, '_')}_vault.html`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);

                alert("Standalone sealed digital asset generated successfully! You can now send this single HTML file directly to your clients or upload it to your storefront.");
            } catch (err) {
                console.error(err);
                alert("Failed to export standalone HTML: " + err.message);
            }
        }

        // Initialize admin settings
        loadAdminSettings();

        // --- LOCK SCREEN LOGIC ---
        function handleKey(e) {
            if (e.key === 'Enter') {
                attemptDecrypt();
            }
        }

        function attemptDecrypt() {
            const val = document.getElementById('vault-pass').value.trim();
            const err = document.getElementById('error-alert');
            const lock = document.getElementById('lock-screen');
            const portal = document.getElementById('portal-view');

            if (val === currentSettings.vaultKey || val.toLowerCase() === currentSettings.vaultKey.toLowerCase()) {
                err.classList.remove('visible');
                lock.style.opacity = '0';
                lock.style.transform = 'translateY(-100vh)';
                
                setTimeout(() => {
                    lock.style.display = 'none';
                    portal.style.display = 'flex';
                }, 800);
            } else {
                err.classList.add('visible');
                setTimeout(() => { err.classList.remove('visible'); }, 3000);
            }
        }

        // --- BACKGROUND RETRO MATRIX DOT GLOWS ---
        const canvas = document.createElement('canvas');
        canvas.style.position = 'fixed';
        canvas.style.top = '0';
        canvas.style.left = '0';
        canvas.style.width = '100vw';
        canvas.style.height = '100vh';
        canvas.style.zIndex = '1';
        canvas.style.pointerEvents = 'none';
        document.body.prepend(canvas);

        const ctx = canvas.getContext('2d');
        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

        const particles = [];
        for (let i = 0; i < 30; i++) {
            particles.push({
                x: Math.random() * width,
                y: Math.random() * height,
                vx: (Math.random() - 0.5) * 0.3,
                vy: (Math.random() - 0.5) * 0.3,
                radius: Math.random() * 2 + 1,
                alpha: Math.random() * 0.4 + 0.1
            });
        }

        function drawParticles() {
            ctx.clearRect(0, 0, width, height);
            
            // Draw background flow color
            const grad = ctx.createRadialGradient(width/2, height/2, 10, width/2, height/2, width*0.8);
            grad.addColorStop(0, '#04070d');
            grad.addColorStop(1, '#010204');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, width, height);

            const colorTheme = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#00e5ff';
            ctx.strokeStyle = colorTheme;

            particles.forEach((p, idx) => {
                p.x += p.vx;
                p.y += p.vy;

                if (p.x < 0 || p.x > width) p.vx *= -1;
                if (p.y < 0 || p.y > height) p.vy *= -1;

                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(0, 229, 255, ${p.alpha})`;
                ctx.fill();

                for (let j = idx + 1; j < particles.length; j++) {
                    const p2 = particles[j];
                    const dist = Math.hypot(p.x - p2.x, p.y - p2.y);
                    if (dist < 200) {
                        ctx.beginPath();
                        ctx.moveTo(p.x, p.y);
                        ctx.lineTo(p2.x, p2.y);
                        ctx.strokeStyle = `rgba(0, 229, 255, ${(1 - dist/200) * 0.06})`;
                        ctx.stroke();
                    }
                }
            });
            requestAnimationFrame(drawParticles);
        }
        drawParticles();
    </script>
</body>
</html>
