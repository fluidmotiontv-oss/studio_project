            <div style="margin-top:10px;">
                <a href="../systems.html" class="nav-btn-link">← Return to Systems Hub</a>
            </div>
        </div>
    </div>

    <!-- Head-Up Display -->
    <div class="hud-overlay">
        <div class="hud-header">
            <div class="logo-area">
                <h1>⚡ PLASMA <span>XRACER</span></h1>
                <span class="sub">Dragon 9 Plasma Pilot v1.0</span>
            </div>
            
            <div class="hud-stats">
                <div class="stat-item">
                    <span class="stat-label">Energy Stability</span>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span class="stat-value purple" id="hud-shield">100%</span>
                        <div class="shield-bar-container">
                            <div class="shield-bar-fill" id="shield-fill"></div>
                        </div>
                    </div>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Solfeggio Crystals</span>
                    <span class="stat-value gold" id="hud-crystals">0</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Velocity</span>
                    <span class="stat-value cyan" id="hud-speed">150 Tw</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Distance</span>
                    <span class="stat-value" id="hud-distance">0m</span>
                </div>
            </div>
        </div>

        <!-- Mobile Touch Controllers Overlay -->
        <div class="touch-controls">
            <div class="pad-group">
                <div class="control-pad-btn" id="touch-left">◀</div>
                <div class="control-pad-btn" id="touch-right">▶</div>
            </div>
            <div style="pointer-events: auto; padding: 6px 12px; border: 1px solid var(--border-color); border-radius: 6px; background: rgba(0,0,0,0.6); font-family: 'Share Tech Mono', monospace; font-size: 0.55rem; color: var(--accent-cyan);">
                TOUCH BINDINGS ACTIVE
            </div>
            <div class="pad-group">
                <div class="control-pad-btn boost-btn" id="touch-boost">▲</div>
                <div class="control-pad-btn" id="touch-slow" style="border-color:rgba(255,255,255,0.15);">▼</div>
            </div>
        </div>
    </div>

    <!-- App Script (ES Module) -->
    <script type="module" src="script.js"></script>

</body>
