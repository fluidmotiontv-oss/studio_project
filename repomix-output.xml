// --- SYSTEM STATE ---
const state = {
    theme: 'classic',
    soundEnabled: false,
    audioCtx: null,
    oscGroup: null,
    nodes: [],
    links: [],
    selectedNodeIndex: null,
    activePulses: 0,
    packetCounter: 0,
    volumetrics: 0,
    lastTime: null,
    calibrating: false
};

// --- WEBSOCKET CLIENT & SYNC PROTOCOL ---
let ws = null;
let reconnectTimeout = null;

function connectWebSocket() {
    if (ws) return;
    const wsUrl = `ws://${window.location.hostname || 'localhost'}:9100`;
    ws = new WebSocket(wsUrl);

    ws.onopen = () => {
        log("Connected to Dragon 9 Fabric Server (WS://localhost:9100)", "success");
        if (reconnectTimeout) {
            clearTimeout(reconnectTimeout);
            reconnectTimeout = null;
        }
    };

    ws.onclose = () => {
        if (!reconnectTimeout) {
            log("Disconnected from Fabric Server. Operating in standalone simulation mode.", "warn");
        }
        ws = null;
        reconnectTimeout = setTimeout(connectWebSocket, 5000);
    };

    ws.onerror = (err) => {
        // Silent error to prevent console spam when server is down
    };

    ws.onmessage = (event) => {
        try {
            const data = JSON.parse(event.data);
            handleSocketMessage(data);
        } catch (e) {
            console.error("Error decoding message payload:", e);
        }
    };
}

function handleSocketMessage(data) {
    switch (data.action) {
        case "SYNC_STATE":
            if (data.node_states) {
                Object.keys(data.node_states).forEach(idxStr => {
                    const idx = parseInt(idxStr, 10);
                    if (state.nodes[idx]) {
                        state.nodes[idx].status = data.node_states[idxStr];
                    }
                });
                updateNodeListDOM();
                updateGlowTheme();
            }
            break;
        case "GOSSIP_PULSE":
            triggerLocalGossipPulseAtNode(data.origin);
            break;
        case "CALIBRATE":
            runLocalCalibrationSweep();
            break;
        case "TEST_FLOOD":
            runLocalFloodNetworkPackets();
            break;
        case "HEAL":
            runLocalHealAllFaults();
            break;
        case "NODE_STATUS_CHANGE":
            const idx = parseInt(data.index, 10);
            const status = data.status;
            if (state.nodes[idx]) {
                const node = state.nodes[idx];
                node.status = status;
                if (status === 'offline') {
                    node.drift = 0;
                    log(`CRITICAL: Connection lost with Node '${node.name}' (IP: ${node.ip}).`, "error");
                    playFaultTone();
                } else {
                    node.drift = (Math.random() - 0.5) * 0.012;
                    log(`Node '${node.name}' booted up. Connection handshakes complete. IP: ${node.ip}`, "success");
                    playBeep(660, 'sine', 0.15, 0.05);
                }
                if (state.selectedNodeIndex === idx) {
                    selectNode(idx);
                }
                updateNodeListDOM();
                updateGlowTheme();
            }
            break;
        case "NODE_JOINED":
            log(`External raw TCP node registered: '${data.node_id}' at ${data.ip} (${data.type})`, "success");
            playBeep(750, 'sine', 0.1, 0.04);
            break;
    }
}

// --- DOM ELEMENTS ---
const dom = {
    masterClock: document.getElementById('master-clock'),
