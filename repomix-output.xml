                <div class="control-label">Resonance Synthesizer Tone</div>
                <button class="preset-btn" style="text-align: center; display: block;" id="tone-btn" onclick="toggleSynthTone()">
                    🔊 Enable Test Frequency
                </button>
            </div>

            <div class="control-group" id="synth-controls" style="display: none;">
                <div class="control-label">Freq (Solfeggio) <span class="value" id="val-freq">528 Hz</span></div>
