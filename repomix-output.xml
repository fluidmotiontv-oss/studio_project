                justify-content: center;
                text-align: center;
            }
            .nav-links {
                justify-content: center;
                flex-wrap: wrap;
            }
        }

        .nav-links {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .nav-btn {
