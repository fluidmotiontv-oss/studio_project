        async function cashoutArtistEarnings() {
            const artistName = (document.getElementById('artist-name').value || currentSettings.artistName || "Corey").toLowerCase().trim();
            const notesEl = document.getElementById('artist-ledger-notes');
            if (!notesEl) return;
