            z-index: -2;
            overflow: hidden;
            filter: blur(120px);
            pointer-events: none;
        }

        .blob {
            position: absolute;
            border-radius: 50%;
            opacity: 0.18;
            animation: drift 25s infinite ease-in-out alternate;
        }

        .blob-cyan {
            width: 50vw; height: 50vw;
            background: linear-gradient(135deg, var(--accent-cyan), #002266);
            top: -10%; left: -10%;
        }

        .blob-gold {
            width: 45vw; height: 45vw;
            background: linear-gradient(135deg, var(--accent-gold), #4a1d96);
            bottom: -10%; right: -10%;
            animation-delay: -5s;
        }

        @keyframes drift {
            0% { transform: translate(0, 0) scale(1) rotate(0deg); }
            100% { transform: translate(80px, -50px) scale(1.15) rotate(60deg); }
        }

        /* Scanline HUD mesh overlay */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: 
                linear-gradient(rgba(255, 255, 255, 0.005) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.005) 1px, transparent 1px);
            background-size: 30px 30px;
            z-index: -1;
            pointer-events: none;
