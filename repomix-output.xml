                cssText = cssText.replace(/url\(['"]?\.\.\/assets\/crew\/night_fish\/images\/head\.png['"]?\)/g, `url("${headB64}")`);
                cssText = cssText.replace(/url\(['"]?\.\.\/assets\/crew\/night_fish\/images\/fin_left\.png['"]?\)/g, `url("${finLeftB64}")`);
                cssText = cssText.replace(/url\(['"]?\.\.\/assets\/crew\/night_fish\/images\/fin_right\.png['"]?\)/g, `url("${finRightB64}")`);
                cssText = cssText.replace(/url\(['"]?\.\.\/assets\/crew\/night_fish\/images\/tail_large\.png['"]?\)/g, `url("${tailLargeB64}")`);
                cssText = cssText.replace(/url\(['"]?\.\.\/assets\/crew\/night_fish\/images\/tail_small\.png['"]?\)/g, `url("${tailSmallB64}")`);

                // Swap images in HTML
                htmlText = htmlText.replace(/src="assets\/menu\/fluid_motion_logo_yellow_black\.png"/g, `src="${logoB64}"`);

                // Swap images in JS
                jsText = jsText.replace(/assets\/crew\/night_fish\/images\/night_fish_Night%20fish%20for%20afx%20holo\.png/g, headB64);

                // Inject CSS
                const cssLinkTag = '<link rel="stylesheet" href="scripts/night_fish.css">';
