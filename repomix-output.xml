            pointer-events: none;
        }

        .water-wheel {
            position: absolute;
            width: 100%; height: 100%;
            border: 2px solid currentColor;
            border-radius: 50%;
            transition: transform 0.1s linear;
        }

        .bucket {
            position: absolute;
            width: 18px; height: 14px;
            background: currentColor;
            left: 101px; top: 0;
            transform-origin: 9px 110px;
        }

        .station-content { z-index: 10; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
        
