        } else {
            projectorItem.classList.remove('completed');
            chkProjector.innerText = '⬡';
        }
    }
    
    const progressEl = document.getElementById('quest-hud-progress');
    if (progressEl) {
        progressEl.innerText = `${count}/3`;
