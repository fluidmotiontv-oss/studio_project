<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dragon 9 | Sovereign Community Portal</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;900&family=Share+Tech+Mono&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #050a14;
            --panel-bg: rgba(10, 15, 25, 0.75);
            --gold: #d4af37;
            --gold-glow: rgba(212, 175, 55, 0.25);
            --text-main: #f4e4bc;
            --text-muted: #8c85a3;
            --accent: #00e5ff;
            --accent-glow: rgba(0, 229, 255, 0.2);
            --pastel-pink: rgba(255, 182, 193, 0.06);
            --pastel-blue: rgba(173, 216, 230, 0.06);
            --pastel-purple: rgba(221, 160, 221, 0.06);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body { 
            background: linear-gradient(135deg, #050a14 0%, #1a1a1a 100%);
            color: var(--text-main); 
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        /* Iridescent Ambient Shimmer Background Blobs */
        body::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: 
                linear-gradient(rgba(255,255,255,0.005) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.005) 1px, transparent 1px);
            background-size: 35px 35px;
            z-index: 1;
            pointer-events: none;
        }

        body::after {
            content: "";
            position: fixed;
            top: -20%; left: -20%; width: 140%; height: 140%;
            background: radial-gradient(circle, rgba(255, 182, 193, 0.02) 0%, rgba(173, 216, 230, 0.02) 40%, rgba(221, 160, 221, 0.02) 80%);
            pointer-events: none;
            z-index: 0;
        }

        .header {
            width: 100%;
            padding: 15px 30px;
            border-bottom: 1.5px solid var(--gold);
            background: rgba(5, 10, 20, 0.85);
            backdrop-filter: blur(20px);
            z-index: 100;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5), 0 0 15px var(--gold-glow);
        }

        .logo {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.2rem;
