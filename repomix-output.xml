    </style>
</head>
<body>

    <!-- Systems Gate Authorization Overlay -->
    <div id="systemsGateOverlay">
        <span style="font-size: 4rem; filter: drop-shadow(0 0 15px rgba(255, 0, 85, 0.4));">🔒</span>
