            box-shadow: 0 0 10px rgba(212, 175, 55, 0.2) !important;
        }

        /* Upgrade PRO button in header */
        .btn-upgrade-pro {
            background: linear-gradient(135deg, var(--gold-accent), #b48a1d);
            border: 1px solid var(--gold-accent);
            color: #020617;
            padding: 8px 16px;
            border-radius: 8px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
            pointer-events: auto;
        }
        .btn-upgrade-pro:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(212, 175, 55, 0.6);
            background: #fff;
            color: #000;
            border-color: #fff;
        }

        /* PRO Modal Styling */
        .pro-modal {
            display: none;
            position: fixed;
            z-index: 99999;
            left: 0;
            top: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(2, 6, 23, 0.85);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            justify-content: center;
            align-items: center;
            pointer-events: auto;
        }
        .pro-modal-content {
            background: rgba(9, 13, 26, 0.9);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 20px;
            padding: 40px;
            max-width: 500px;
            width: 90%;
            text-align: center;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.8), 0 0 40px rgba(212, 175, 55, 0.2);
            position: relative;
            animation: modal-zoom 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes modal-zoom {
            from { transform: scale(0.9); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
        .pro-close {
            position: absolute;
            top: 15px;
            right: 20px;
            color: #94a3b8;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
            transition: color 0.3s;
        }
        .pro-close:hover {
            color: #fff;
        }
        .pro-modal h2 {
            font-family: 'Cinzel', serif;
            font-size: 2rem;
            color: var(--text-main);
            margin-bottom: 10px;
            letter-spacing: 2px;
        }
        .pro-modal h2 span {
            color: var(--gold-accent);
            text-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
        }
        .pro-upgrade-btn {
            font-family: 'Orbitron', sans-serif;
            font-weight: 700;
            letter-spacing: 1.5px;
            background: linear-gradient(135deg, var(--gold-accent), #b48a1d);
            color: #020617;
            border: none;
            padding: 14px 28px;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 20px;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
            width: 100%;
        }
        .pro-upgrade-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(212, 175, 55, 0.5);
            background: #fff;
            color: #000;
        }

        /* Dropdown custom style */
        select.control-dropdown {
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid var(--glass-border);
            color: #fff;
            padding: 10px;
            border-radius: 8px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            letter-spacing: 1px;
            outline: none;
            cursor: pointer;
            transition: all 0.3s;
        }
        select.control-dropdown:hover {
            border-color: var(--cyan-glow);
        }

        /* Right Panel - Synth & Loop */
        .right-sidebar {
            grid-column: 3;
            grid-row: 2;
            gap: 15px;
        }

        .slider-container {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .slider-header {
            display: flex;
            justify-content: space-between;
            font-size: 0.7rem;
            color: #94a3b8;
        }

        input[type="range"] {
            -webkit-appearance: none;
            width: 100%;
            height: 5px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
            outline: none;
        }

        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: var(--cyan-glow);
            cursor: pointer;
            box-shadow: 0 0 8px var(--cyan-glow);
            transition: transform 0.1s;
        }

        /* Looper Buttons */
        .loop-controls {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }
        .btn-loop {
            flex: 1;
            padding: 12px;
            border-radius: 8px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s;
            border: 1px solid var(--glass-border);
            color: #fff;
            background: rgba(255, 255, 255, 0.03);
            text-align: center;
        }
        .btn-loop:hover {
            border-color: var(--cyan-glow);
        }
        .btn-loop.rec-active {
            background: rgba(239, 68, 68, 0.2);
            border-color: var(--alert-red);
            color: var(--alert-red);
            box-shadow: 0 0 10px rgba(239, 68, 68, 0.3);
            animation: pulse-red 1.5s infinite ease-in-out;
        }
        .btn-loop.play-active {
            background: rgba(16, 185, 129, 0.2);
            border-color: var(--success-green);
            color: var(--success-green);
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.3);
        }

        @keyframes pulse-red {
            0%, 100% { opacity: 0.8; }
            50% { opacity: 0.4; }
        }

        /* Bottom Status bar */
        .bottom-bar {
            grid-column: 1 / 4;
            grid-row: 3;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 10px 30px;
            backdrop-filter: blur(10px);
            pointer-events: auto;
        }

        .status-metric {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.85rem;
            letter-spacing: 1px;
            color: #94a3b8;
        }
        .status-metric span {
            color: var(--cyan-glow);
            font-weight: 700;
        }

        .instructions {
            position: absolute;
            left: 50%;
            top: 22%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
            font-family: 'Cinzel', serif;
            font-size: 1.1rem;
            letter-spacing: 4px;
            color: rgba(255, 255, 255, 0.6);
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
            animation: pulse-slow 3s infinite ease-in-out;
        }

        @keyframes pulse-slow {
            0%, 100% { opacity: 0.3; }
            50% { opacity: 0.8; }
        }

        .btn-loop-small {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #94a3b8;
            border-radius: 4px;
            cursor: pointer;
            font-family: 'Orbitron', sans-serif;
            transition: all 0.2s;
        }
        .btn-loop-small:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            border-color: rgba(255, 255, 255, 0.2);
        }
        .btn-loop-small.active {
            background: var(--cyan-glow);
            color: #000;
            border-color: var(--cyan-glow);
            font-weight: bold;
            box-shadow: 0 0 8px var(--cyan-glow);
        }
        .btn-loop-small.muted-active {
            background: #ef4444;
            color: #fff;
            border-color: #ef4444;
            box-shadow: 0 0 8px #ef4444;
        }

        .toggle-btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--glass-border);
            color: #fff;
            padding: 10px 15px;
            border-radius: 8px;
            cursor: pointer;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            transition: all 0.3s;
        }
        .toggle-btn:hover {
            border-color: var(--cyan-glow);
        }
        .toggle-btn span.indicator {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            transition: all 0.3s;
        }
        .toggle-btn.active span.indicator {
            background: var(--cyan-glow);
            box-shadow: 0 0 8px var(--cyan-glow);
        }

        #network-map {
            position: absolute;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            z-index: 1;
            pointer-events: none;
            opacity: 0.85;
            transition: opacity 0.5s;
        }

        /* --- PLAY MODE BUTTON & TRANSITIONS --- */
        header, .left-sidebar, .right-sidebar, .instructions, .bottom-bar {
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1) !important;
        }

        .btn-play-mode {
            position: fixed;
            bottom: 100px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10000;
            background: rgba(9, 13, 26, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #fff;
            padding: 10px 20px;
            border-radius: 20px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            letter-spacing: 1.5px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            gap: 6px;
            pointer-events: auto;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
        }
        .btn-play-mode:hover {
            border-color: var(--cyan-glow);
            color: var(--cyan-glow);
            box-shadow: 0 0 15px rgba(0, 229, 255, 0.3);
            transform: translateX(-50%) translateY(-1px);
        }
        .btn-play-mode.active {
            border-color: var(--gold-accent);
            color: var(--gold-accent);
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
            background: rgba(212, 175, 55, 0.1);
        }

        body.play-mode-active header {
            transform: translateY(-120%);
            opacity: 0;
            pointer-events: none;
        }
        body.play-mode-active .left-sidebar {
            transform: translateX(-120%);
            opacity: 0;
            pointer-events: none;
        }
        body.play-mode-active .right-sidebar {
            transform: translateX(120%);
            opacity: 0;
            pointer-events: none;
        }
        body.play-mode-active .instructions {
            opacity: 0.15;
        }
        body.play-mode-active .bottom-bar {
            transform: translateY(120%);
            opacity: 0;
            pointer-events: none;
        }

    </style>
</head>
<body>
    <!-- Fluid Background -->
    <div class="fluid-bg" id="fluid-bg">
        <div class="blob-wrap blob-wrap-1"><div class="blob blob-1"></div></div>
        <div class="blob-wrap blob-wrap-2"><div class="blob blob-2"></div></div>
    </div>

    <!-- WebGL Canvas Container -->
    <div id="canvas-container"></div>

    <!-- Constellation SVG Map (Behind WebGL) -->
    <svg id="network-map" viewBox="0 0 1000 700" style="position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1; pointer-events: none; opacity: 0.85; transition: opacity 0.5s;">
        <defs>
            <filter id="glow-cyan" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="8" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
            </filter>
            <filter id="glow-gold" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="8" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
            </filter>
        </defs>
        
        <!-- Triad 1 (Top Left) -->
        <polygon points="180,180 320,130 260,280" stroke="rgba(0, 229, 255, 0.15)" stroke-width="1.5" fill="rgba(0, 229, 255, 0.01)" id="triad-poly-0" style="transition: all 0.5s;" />
        <circle cx="180" cy="180" r="7" fill="#090d16" stroke="rgba(0, 229, 255, 0.3)" stroke-width="2" id="node-0-0" style="transition: all 0.5s;" />
        <circle cx="320" cy="130" r="7" fill="#090d16" stroke="rgba(0, 229, 255, 0.3)" stroke-width="2" id="node-0-1" style="transition: all 0.5s;" />
        <circle cx="260" cy="280" r="7" fill="#090d16" stroke="rgba(0, 229, 255, 0.3)" stroke-width="2" id="node-0-2" style="transition: all 0.5s;" />
        
        <!-- Triad 2 (Top Right) -->
        <polygon points="720,160 840,250 780,110" stroke="rgba(212, 175, 55, 0.15)" stroke-width="1.5" fill="rgba(212, 175, 55, 0.01)" id="triad-poly-1" style="transition: all 0.5s;" />
        <circle cx="720" cy="160" r="7" fill="#090d16" stroke="rgba(212, 175, 55, 0.3)" stroke-width="2" id="node-1-0" style="transition: all 0.5s;" />
        <circle cx="840" cy="250" r="7" fill="#090d16" stroke="rgba(212, 175, 55, 0.3)" stroke-width="2" id="node-1-1" style="transition: all 0.5s;" />
        <circle cx="780" cy="110" r="7" fill="#090d16" stroke="rgba(212, 175, 55, 0.3)" stroke-width="2" id="node-1-2" style="transition: all 0.5s;" />

        <!-- Triad 3 (Bottom Left) -->
        <polygon points="170,520 290,590 230,460" stroke="rgba(212, 175, 55, 0.15)" stroke-width="1.5" fill="rgba(212, 175, 55, 0.01)" id="triad-poly-2" style="transition: all 0.5s;" />
        <circle cx="170" cy="520" r="7" fill="#090d16" stroke="rgba(212, 175, 55, 0.3)" stroke-width="2" id="node-2-0" style="transition: all 0.5s;" />
        <circle cx="290" cy="590" r="7" fill="#090d16" stroke="rgba(212, 175, 55, 0.3)" stroke-width="2" id="node-2-1" style="transition: all 0.5s;" />
        <circle cx="230" cy="460" r="7" fill="#090d16" stroke="rgba(212, 175, 55, 0.3)" stroke-width="2" id="node-2-2" style="transition: all 0.5s;" />

        <!-- Triad 4 (Bottom Right) -->
        <polygon points="730,490 850,550 790,410" stroke="rgba(0, 229, 255, 0.15)" stroke-width="1.5" fill="rgba(0, 229, 255, 0.01)" id="triad-poly-3" style="transition: all 0.5s;" />
        <circle cx="730" cy="490" r="7" fill="#090d16" stroke="rgba(0, 229, 255, 0.3)" stroke-width="2" id="node-3-0" style="transition: all 0.5s;" />
        <circle cx="850" cy="550" r="7" fill="#090d16" stroke="rgba(0, 229, 255, 0.3)" stroke-width="2" id="node-3-1" style="transition: all 0.5s;" />
        <circle cx="790" cy="410" r="7" fill="#090d16" stroke="rgba(0, 229, 255, 0.3)" stroke-width="2" id="node-3-2" style="transition: all 0.5s;" />
    </svg>

    <!-- UI Overlay -->
    <div class="glass-overlay">
        <header>
            <a href="index.html" class="nav-back">← LANDING PAGE</a>
            <h1>LOTUS <span>NEXUS</span></h1>
            <button class="btn-upgrade-pro" id="btn-header-pro">★ KOHA / DONATE</button>
        </header>

        <!-- Left Sidebar - Settings -->
        <div class="interactive-panel left-sidebar">
            <h2 class="panel-title">Lotus Settings</h2>
            
            <div class="control-group">
                <label class="control-label">Aesthetic Vibe</label>
                <button class="btn-select active" id="btn-vibe-harmonic">Harmonic Dawn</button>
                <button class="btn-select locked" id="btn-vibe-void">🔒 Void Resonance (PRO)</button>
            </div>
            
            <div class="control-group">
                <label class="control-label">Striker Tool</label>
                <button class="btn-select active" id="btn-tool-finger">Glowing Finger</button>
                <button class="btn-select" id="btn-tool-wand">Magic Wand</button>
                <button class="btn-select" id="btn-tool-drumstick">Drumstick</button>
            </div>

            <div class="control-group">
                <label class="control-label">Music Box Tunes</label>
                <select class="control-dropdown" id="dropdown-melodies">
                    <option value="none">-- Select Melody --</option>
                    <option value="harmonic">Harmonic Sunrise</option>
                    <option value="joy" data-pro="true">🔒 Ode to Joy (PRO)</option>
                    <option value="cosmic" data-pro="true">🔒 Cosmic Scale Run (PRO)</option>
                </select>
            </div>

            <div class="control-group">
                <label class="control-label">Synth Models</label>
                <button class="btn-select active" id="btn-preset-piano">Ambient Piano</button>
                <button class="btn-select locked" id="btn-preset-pad">🔒 Cosmic Pad (PRO)</button>
                <button class="btn-select locked" id="btn-preset-pluck">🔒 Crystal Bell (PRO)</button>
            </div>

            <div class="control-group">
                <label class="control-label">Petal Shape</label>
                <select class="control-dropdown" id="dropdown-shapes">
                    <option value="lotus">Lotus (Pointed)</option>
                    <option value="round" data-pro="true">🔒 Rose (Rounded) (PRO)</option>
                    <option value="star" data-pro="true">🔒 Crystal (Diamond) (PRO)</option>
                </select>
            </div>

            <div class="slider-container" style="margin-top: 5px;">
                <div class="slider-header" style="font-size: 0.7rem; color: #94a3b8;">
                    <span>Petal Spacing</span>
                    <span id="val-spacing">100%</span>
                </div>
                <input type="range" id="slider-spacing" min="50" max="185" value="100">
            </div>

            <div class="control-group" style="margin-top: 5px;">
                <button class="toggle-btn active" id="btn-toggle-labels">
                    <span>Show Note Labels</span>
                    <span class="indicator"></span>
                </button>
            </div>

            <div class="control-group" style="margin-top: 5px;">
                <button class="toggle-btn" id="btn-drum-loop">
                    <span>Backing Beat (112 BPM)</span>
                    <span class="indicator"></span>
                </button>
            </div>

            <!-- Petal Sampler Editor -->
            <div class="control-group" id="petal-editor-panel" style="margin-top: 15px; display: none; border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 12px; gap: 8px;">
                <label class="control-label" style="color: var(--cyan-glow); font-weight: 600;">Petal Sampler Editor</label>
                <div style="font-size: 0.75rem; color: var(--gold-accent); margin-bottom: 2px;">Selected Note: <span id="editor-note-name" style="font-weight:700;">-</span></div>
                
                <div class="control-group">
                    <label class="control-label" style="font-size: 0.6rem;">Load Sound (.mp3, .wav)</label>
                    <input type="file" id="input-audio" accept="audio/*" class="control-dropdown" style="font-size: 0.65rem; padding: 4px;">
                </div>
                
                <div class="control-group" style="margin-top: 3px;">
                    <label class="control-label" style="font-size: 0.6rem;">Load Image (.png, .jpg)</label>
                    <input type="file" id="input-image" accept="image/*" class="control-dropdown" style="font-size: 0.65rem; padding: 4px;">
                </div>
            </div>

            <div class="control-group" style="margin-top: 10px;">
                <label class="control-label" style="color: var(--gold-accent);">Network Gateway</label>
                <button class="btn-loop" id="btn-start-game" style="border-color: var(--gold-accent); color: var(--gold-accent);">Start Triad Challenge</button>
            </div>

            <div class="control-group" style="margin-top: auto;">
                <button class="toggle-btn" id="btn-auto-spin">
                    <span>Auto-Spin Orbit</span>
                    <span class="indicator"></span>
                </button>
            </div>
        </div>

        <!-- Right Sidebar - Synth & Looper -->
        <div class="interactive-panel right-sidebar">
            <h2 class="panel-title">Synth Controls</h2>
            
            <div class="slider-container">
                <div class="slider-header">
                    <span>Master Volume</span>
                    <span id="val-vol">75%</span>
                </div>
                <input type="range" id="slider-vol" min="0" max="100" value="75">
            </div>

            <div class="slider-container">
                <div class="slider-header">
                    <span>Filter Cutoff</span>
                    <span id="val-cutoff">60%</span>
                </div>
                <input type="range" id="slider-cutoff" min="10" max="100" value="60">
            </div>

            <div class="slider-container">
                <div class="slider-header">
                    <span>Filter Q (Resonance)</span>
                    <span id="val-res">40%</span>
                </div>
                <input type="range" id="slider-res" min="0" max="100" value="40">
            </div>

            <div class="slider-container">
                <div class="slider-header">
                    <span>Envelope Attack</span>
                    <span id="val-attack">0.1s</span>
                </div>
                <input type="range" id="slider-attack" min="1" max="100" value="10">
            </div>

            <div class="slider-container">
                <div class="slider-header">
                    <span>Envelope Decay</span>
                    <span id="val-decay">1.5s</span>
                </div>
                <input type="range" id="slider-decay" min="10" max="400" value="150">
            </div>

            <div class="slider-container">
                <div class="slider-header">
                    <span>Delay Feedback</span>
                    <span id="val-delay">30%</span>
                </div>
                <input type="range" id="slider-delay" min="0" max="90" value="30">
            </div>

            <h2 class="panel-title" style="margin-top: 15px; border-bottom-color: rgba(0, 229, 255, 0.2); color: var(--cyan-glow);">4-Track Loop Pedal</h2>
            
            <div class="slider-container" style="margin-bottom: 8px;">
                <div class="slider-header" style="font-size: 0.65rem;">
                    <span>Loop Progress (8s)</span>
                    <span id="val-loop-prog">0.0s</span>
                </div>
                <input type="range" id="slider-loop-prog" min="0" max="100" value="0" disabled style="opacity:0.6;">
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px;">
                <!-- Track 1 -->
                <div style="display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.02); padding: 5px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05); gap: 6px;">
                    <button class="btn-loop-small active" id="btn-track-0" style="padding: 4px 6px; font-size: 0.65rem; flex-grow: 1; text-align: left; height:24px;">Track 1</button>
