<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dragon 9 | Sovereign Surf Rider - 3D Water Tunnel</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;900&family=Share+Tech+Mono&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #00050c;
            --panel-bg: rgba(5, 12, 22, 0.85);
            --gold: #d4af37;
            --gold-glow: rgba(212, 175, 55, 0.35);
            --cyan: #00e5ff;
            --cyan-glow: rgba(0, 229, 255, 0.35);
            --magenta: #ff0055;
            --text-main: #f4e4bc;
            --text-muted: #4e6a8d;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body { 
            background: var(--bg-dark); 
            color: var(--text-main); 
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        body::after {
            content: " ";
            display: block;
            position: fixed;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.2) 50%);
            background-size: 100% 4px;
            z-index: 9999;
            pointer-events: none;
            opacity: 0.15;
        }

        .header {
            width: 100%;
            padding: 15px 30px;
            border-bottom: 1px solid rgba(0, 229, 255, 0.18);
            background: var(--panel-bg);
            backdrop-filter: blur(15px);
            z-index: 100;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }

        .logo {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.15rem;
            letter-spacing: 3px;
            font-weight: 900;
            color: #fff;
            text-transform: uppercase;
            text-shadow: 0 0 10px var(--cyan-glow);
        }

        .logo span {
            color: var(--cyan);
        }

        .nav-btn {
            text-decoration: none;
            color: var(--cyan);
            background: rgba(0, 229, 255, 0.05);
            border: 1px solid rgba(0, 229, 255, 0.2);
            border-radius: 6px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 8px 16px;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-btn:hover {
            background: var(--cyan);
            color: #000;
            box-shadow: 0 0 15px var(--cyan-glow);
        }

        /* HUD Panels */
        .hud-overlay {
            position: absolute;
            top: 80px; left: 0; width: 100%; height: calc(100% - 80px);
            pointer-events: none;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px;
            z-index: 10;
        }

        .hud-top {
            display: flex;
            justify-content: space-between;
            width: 100%;
        }

        .hud-panel {
            background: rgba(4, 12, 24, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--cyan);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6), inset 0 0 10px var(--cyan-glow);
            border-radius: 10px;
            padding: 12px 18px;
            pointer-events: auto;
            font-family: 'Share Tech Mono', monospace;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .hud-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            letter-spacing: 1.5px;
            color: var(--cyan);
            text-transform: uppercase;
            font-weight: 700;
        }

        .hud-value {
            font-size: 1.6rem;
            font-weight: 900;
            color: #fff;
            text-shadow: 0 0 8px var(--cyan-glow);
        }

        /* Shield Container */
        .shield-container {
            width: 120px;
            height: 8px;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 4px;
            overflow: hidden;
            margin-top: 4px;
        }

        .shield-bar {
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, var(--magenta), var(--cyan));
            transition: width 0.3s;
        }

        /* Active/Relax Clock indicator */
        .clock-sync {
            font-family: 'Orbitron', sans-serif;
            font-size: 1rem;
            color: var(--gold);
        }

        .relax-indicator {
            background: var(--magenta);
            color: #fff;
            font-size: 0.58rem;
            padding: 1px 4px;
            border-radius: 3px;
            font-weight: bold;
            letter-spacing: 1px;
            animation: pulse-relax 1s infinite alternate;
            margin-top: 3px;
            display: inline-block;
        }

        @keyframes pulse-relax {
            0% { opacity: 0.5; box-shadow: 0 0 2px var(--magenta); }
            100% { opacity: 1; box-shadow: 0 0 8px var(--magenta); }
        }

        /* Canvas game window */
        .game-window {
            flex: 1;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
            background: #00050c;
        }

        /* Screens */
        .screen-modal {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(2, 6, 15, 0.9);
            backdrop-filter: blur(8px);
            z-index: 100;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 20px;
            box-sizing: border-box;
            font-family: 'Orbitron', sans-serif;
        }

        .screen-modal.hidden {
            display: none;
        }

        .screen-title {
            font-size: 2.2rem;
            font-weight: 900;
            letter-spacing: 4px;
            color: var(--cyan);
            text-shadow: 0 0 15px var(--cyan-glow);
            margin-bottom: 15px;
            text-transform: uppercase;
        }

        .screen-desc {
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            color: var(--text-main);
            max-width: 440px;
            line-height: 1.6;
            margin-bottom: 25px;
            opacity: 0.8;
        }

        .key-layout {
            display: flex;
            gap: 15px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.72rem;
            color: var(--text-muted);
            margin-bottom: 25px;
        }

        .key-badge {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 4px;
