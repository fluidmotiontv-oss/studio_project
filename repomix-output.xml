        // Mathematical figure-8 Lemniscate formula
        function getLemniscatePosition(t, scale) {
            const denom = 1 + Math.sin(t) * Math.sin(t);
            const x = (scale * 1.7 * Math.cos(t)) / denom;
            const z = (scale * 0.9 * Math.sin(t) * Math.cos(t)) / denom;
            const y = Math.sin(t * 2) * (scale * 0.3);
            return new THREE.Vector3(x, y, z);
        }

        function init3DCarousel() {
