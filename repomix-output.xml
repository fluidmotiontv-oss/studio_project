        </div>
    </div>

    <script>
        // Check session auth on load
        const overlay = document.getElementById('lockOverlay');
        const input = document.getElementById('lockInput');
        const error = document.getElementById('lockError');

        if (sessionStorage.getItem('systems_auth') === 'granted') {
            overlay.classList.add('unlocked');
            document.body.style.overflowY = 'auto';
        } else {
            document.body.style.overflowY = 'hidden';
            // Auto focus input
            setTimeout(() => input.focus(), 100);
        }

        // Trigger verify on enter key
        input.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                verifyPasscode();
            }
        });

        function verifyPasscode() {
            if (input.value === 'dragon9') {
                sessionStorage.setItem('systems_auth', 'granted');
                overlay.classList.add('unlocked');
                document.body.style.overflowY = 'auto';
                error.classList.remove('visible');
            } else {
                error.classList.add('visible');
                input.value = '';
                input.focus();
            }
        }

        function relockConsole() {
            sessionStorage.removeItem('systems_auth');
            location.reload();
        }
    </script>
