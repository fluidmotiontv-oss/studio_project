        // --- 8. LOOP PEDAL ENGINE (RECORDER) ---
        // --- 8. LOOP PEDAL ENGINE (RECORDER & 4-TRACK MIXER) ---
        function toggleRecording() {
            const recBtn = document.getElementById('btn-record');
            
            if (!loopState.isRecording) {
                loopState.isRecording = true;
                // Clear active track to overwrite
                loopState.tracks[loopState.activeTrackIndex] = [];
                loopState.recordStartTime = Date.now();
                
                recBtn.innerText = "RECORDING (8s)...";
                recBtn.className = "btn-loop rec-active";
                
                // Track progress bar on UI
                let elapsedMs = 0;
                clearInterval(loopState.progressIntervalId);
                document.getElementById('slider-loop-prog').value = 0;
                
                loopState.progressIntervalId = setInterval(() => {
                    elapsedMs = Date.now() - loopState.recordStartTime;
                    const pct = (elapsedMs / loopState.loopDuration) * 100;
                    document.getElementById('slider-loop-prog').value = Math.min(pct, 100);
                    document.getElementById('val-loop-prog').innerText = `${(elapsedMs/1000).toFixed(1)}s`;
                }, 50);

                // Stop loop after 8 seconds and autoplay
                loopState.loopTimer = setTimeout(() => {
                    stopRecording();
                }, loopState.loopDuration);
            } else {
                stopRecording();
            }
        }

        function stopRecording() {
            if (!loopState.isRecording) return;
            loopState.isRecording = false;
            
            clearTimeout(loopState.loopTimer);
            clearInterval(loopState.progressIntervalId);
            
            const recBtn = document.getElementById('btn-record');
            recBtn.innerText = "PLAYING LOOPS";
            recBtn.className = "btn-loop play-active";
            
            updateTrackUI();
            startLoopPlayback();
        }

        function startLoopPlayback() {
            stopLoopPlayback();
            
            const totalEvents = loopState.tracks.reduce((sum, t) => sum + t.length, 0);
            if (totalEvents === 0) return;
            
            loopState.isLoopPlaying = true;
            playLoopCycle();
            
            // Loop progress tracking on playback
            let loopCycleStart = Date.now();
            loopState.progressIntervalId = setInterval(() => {
                const elapsedMs = (Date.now() - loopCycleStart) % loopState.loopDuration;
                const pct = (elapsedMs / loopState.loopDuration) * 100;
                document.getElementById('slider-loop-prog').value = pct;
                document.getElementById('val-loop-prog').innerText = `${(elapsedMs/1000).toFixed(1)}s`;
            }, 50);
        }

        function playLoopCycle() {
            if (!loopState.isLoopPlaying) return;
            
            // Schedule playback for all unmuted tracks
            loopState.tracks.forEach((trackEvents, trackIdx) => {
                if (loopState.trackMuted[trackIdx]) return;
                
                trackEvents.forEach(evt => {
                    const t = setTimeout(() => {
                        const petal = petalsArray.find(p => p.userData.id === evt.petalId);
                        triggerSynthNote(evt.frequency, evt.velocity, petal);
                        
                        if (petal) {
                            petal.material.emissiveIntensity = 1.8;
                            petal.scale.setScalar(petal.userData.originalScale * 1.25);
                            setTimeout(() => {
                                petal.material.emissiveIntensity = petal.userData.originalEmissive;
                                petal.scale.setScalar(petal.userData.originalScale);
                            }, 250);
                        }
                    }, evt.time);
                    loopState.loopPlayTimeouts.push(t);
                });
            });
            
            // Schedule next iteration
            const nextCycleId = setTimeout(() => {
                playLoopCycle();
            }, loopState.loopDuration);
            loopState.loopPlayTimeouts.push(nextCycleId);
        }

        function stopLoopPlayback() {
            loopState.isLoopPlaying = false;
            clearInterval(loopState.progressIntervalId);
            loopState.loopPlayTimeouts.forEach(t => clearTimeout(t));
            loopState.loopPlayTimeouts = [];
        }

        function clearLoop() {
            stopRecording();
            stopLoopPlayback();
            loopState.tracks = [ [], [], [], [] ];
            loopState.trackMuted = [ false, false, false, false ];
            
            const recBtn = document.getElementById('btn-record');
            recBtn.innerText = "Record Loop";
            recBtn.className = "btn-loop";
            document.getElementById('slider-loop-prog').value = 0;
            document.getElementById('val-loop-prog').innerText = "0.0s";
            
            updateTrackUI();
        }

        function updateTrackUI() {
            for (let i = 0; i < 4; i++) {
                const trackBtn = document.getElementById(`btn-track-${i}`);
                const muteBtn = document.getElementById(`btn-mute-${i}`);
                
                if (loopState.activeTrackIndex === i) {
                    trackBtn.classList.add('active');
                } else {
                    trackBtn.classList.remove('active');
                }
                
                if (loopState.tracks[i].length > 0) {
                    trackBtn.innerText = `Track ${i+1} (${loopState.tracks[i].length} notes)`;
                } else {
                    trackBtn.innerText = `Track ${i+1} (Empty)`;
                }
                
                if (loopState.trackMuted[i]) {
                    muteBtn.classList.add('muted-active');
                    muteBtn.innerText = "Muted";
                } else {
                    muteBtn.classList.remove('muted-active');
                    muteBtn.innerText = "Mute";
                }
            }
        }

        // --- 8.5 LIVE DEVICE MASTER RECORDER ENGINE ---
        let mediaRecorder = null;
        let recordedChunks = [];
        let isDeviceRecording = false;
        let recDestNode = null;

        function initDeviceRecorder() {
            if (!audioCtx || recDestNode) return;
            recDestNode = audioCtx.createMediaStreamDestination();
            if (limiter) {
                limiter.connect(recDestNode);
            } else {
                mainGainNode.connect(recDestNode);
            }
        }

        function toggleDeviceRecording() {
            initAudio();
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            initDeviceRecorder();

            if (!isDeviceRecording) {
                recordedChunks = [];
                try {
                    mediaRecorder = new MediaRecorder(recDestNode.stream, { mimeType: 'audio/webm' });
                } catch(e) {
                    console.warn("audio/webm not supported, falling back to default media recorder");
                    mediaRecorder = new MediaRecorder(recDestNode.stream);
                }
                
                mediaRecorder.ondataavailable = (e) => {
                    if (e.data.size > 0) {
                        recordedChunks.push(e.data);
                    }
                };
                
                mediaRecorder.onstop = () => {
                    const blob = new Blob(recordedChunks, { type: 'audio/webm' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `lotus-nexus-jam-${Date.now()}.webm`;
                    document.body.appendChild(a);
                    a.click();
                    setTimeout(() => {
                        document.body.removeChild(a);
                        URL.revokeObjectURL(url);
                    }, 100);
                };
                
                mediaRecorder.start();
                isDeviceRecording = true;
                document.getElementById('btn-export-audio').innerText = "STOP RECORDING";
                document.getElementById('btn-export-audio').style.borderColor = "#ef4444";
                document.getElementById('btn-export-audio').style.color = "#ef4444";
                showNotification("RECORDING MASTER OUTPUT...", "var(--gold-accent)");
            } else {
                mediaRecorder.stop();
                isDeviceRecording = false;
                document.getElementById('btn-export-audio').innerText = "Record Master Output";
                document.getElementById('btn-export-audio').style.borderColor = "var(--gold-accent)";
                document.getElementById('btn-export-audio').style.color = "var(--gold-accent)";
                showNotification("DOWNLOADING MIX!", "var(--cyan-glow)");
            }
        }

        document.getElementById('btn-record').addEventListener('click', toggleRecording);
        document.getElementById('btn-clear-loop').addEventListener('click', clearLoop);

        // --- 9. MUSIC BOX PLAYBACK (MELODIES) ---
        const melodies = {
            none: [],
            harmonic: [
                { note: 5, time: 0 }, { note: 7, time: 400 }, { note: 9, time: 800 }, { note: 10, time: 1200 },
                { note: 9, time: 1600 }, { note: 7, time: 2000 }, { note: 5, time: 2400 }, { note: 2, time: 2800 },
                { note: 4, time: 3200 }, { note: 5, time: 3600 }, { note: 7, time: 4000 }, { note: 5, time: 4800 }
            ],
            joy: [
                { note: 7, time: 0 }, { note: 7, time: 400 }, { note: 8, time: 800 }, { note: 9, time: 1200 },
                { note: 9, time: 1600 }, { note: 8, time: 2000 }, { note: 7, time: 2400 }, { note: 6, time: 2800 },
                { note: 5, time: 3200 }, { note: 5, time: 3600 }, { note: 6, time: 4000 }, { note: 7, time: 4400 },
                { note: 7, time: 4800 }, { note: 6, time: 5400 }, { note: 6, time: 5800 }
            ],
            cosmic: [
                { note: 0, time: 0 }, { note: 4, time: 200 }, { note: 7, time: 400 }, { note: 11, time: 600 },
                { note: 12, time: 800 }, { note: 7, time: 1000 }, { note: 4, time: 1200 }, { note: 0, time: 1400 },
                { note: 2, time: 1800 }, { note: 6, time: 2000 }, { note: 9, time: 2200 }, { note: 13, time: 2400 },
                { note: 14, time: 2600 }, { note: 9, time: 2800 }, { note: 6, time: 3000 }, { note: 2, time: 3200 }
            ]
        };

        let melodyPlaying = false;
        let melodyTimeouts = [];

        function stopMelody() {
            melodyPlaying = false;
            melodyTimeouts.forEach(t => clearTimeout(t));
            melodyTimeouts = [];
        }

        function playMelody(melodyName) {
            stopMelody();
            const melody = melodies[melodyName];
            if (!melody || melody.length === 0) return;
            
            melodyPlaying = true;
            
            melody.forEach(item => {
                const timeoutId = setTimeout(() => {
                    if (!melodyPlaying) return;
                    const freq = pentatonicScale[item.note];
                    const petal = petalsArray.find(p => p.userData.noteIndex === item.note);
                    triggerSynthNote(freq, 1.2, petal);
                    
                    // Flash petal in 3D
                    if (petal) {
                        petal.material.emissiveIntensity = 1.8;
                        petal.scale.setScalar(petal.userData.originalScale * 1.25);
                        setTimeout(() => {
                            petal.material.emissiveIntensity = petal.userData.originalEmissive;
                            petal.scale.setScalar(petal.userData.originalScale);
                        }, 300);
                    }
                    
                    // Add subtle rotation impulse for the music-box feel
                    lotusGroup.rotation.y += 0.05;
                }, item.time);
                melodyTimeouts.push(timeoutId);
            });
            
            // Loop the melody
            const totalDuration = melody[melody.length - 1].time + 1200;
            const loopTimeoutId = setTimeout(() => {
                if (melodyPlaying) playMelody(melodyName);
            }, totalDuration);
            melodyTimeouts.push(loopTimeoutId);
        }

        const dropDownMelodies = document.getElementById('dropdown-melodies');
        dropDownMelodies.addEventListener('change', (e) => {
            initAudio();
            const selected = e.target.value;
            if (selected === 'none') {
                stopMelody();
            } else {
                playMelody(selected);
            }
        });

        // --- 10. ARPEGGIATOR (SPIN CLICK ENGINE) ---
        let arpeggioCounter = 0;
        const triggerAngleStep = (Math.PI * 2) / 12; // play note every 30 degrees rotation
        let accumulatedRotation = 0;

        function getRPM() {
            const rps = (rotationVelocity * 60) / (Math.PI * 2);
            return Math.round(Math.abs(rps * 60));
        }

        // --- 11. RENDER LOOP ---
        const clock = new THREE.Clock();

        function updateStriker(delta) {
            // Striker model follows target3D cursor position
            if (activeStrikerMesh) {
                activeStrikerMesh.position.lerp(target3D, 0.15);
                
                // Tilt striker based on position from center (make it look hand-held)
                if (currentToolType === 'wand' || currentToolType === 'drumstick') {
                    // Tilt the stick inwards towards the center of the lotus
                    const angleFromCenter = Math.atan2(activeStrikerMesh.position.z, activeStrikerMesh.position.x);
                    activeStrikerMesh.rotation.y = -angleFromCenter - Math.PI / 2;
                    activeStrikerMesh.rotation.x = 0.5; // pen tilt
                }
                
                // Collision plucking detection
                const tipPos = new THREE.Vector3();
                if (currentToolType === 'wand') {
                    // Tip is at end of wand cylinder (approx length 1.5, offset z = -0.75)
                    tipPos.set(0, 0, -0.75).applyMatrix4(activeStrikerMesh.matrixWorld);
                } else if (currentToolType === 'drumstick') {
                    // Tip is drum head (offset z = -0.6)
                    tipPos.set(0, 0, -0.6).applyMatrix4(activeStrikerMesh.matrixWorld);
                } else {
                    // Finger is just the sphere position
                    tipPos.copy(activeStrikerMesh.position);
                }

                // Check distance between striker tip and each petal
                petalsArray.forEach(petal => {
                    const petalPos = new THREE.Vector3();
                    petal.getWorldPosition(petalPos);
                    
                    const dist = tipPos.distanceTo(petalPos);
                    if (dist < 0.40) { // plucking collision boundary
                        // Debounce: trigger once per 250ms per petal
                        if (!petal.userData.lastStruckTime || Date.now() - petal.userData.lastStruckTime > 250) {
                            petal.userData.lastStruckTime = Date.now();
                            
                            // Audio trigger
                            triggerSynthNote(petal.userData.frequency, 1.2, petal);
                            
                            // Check Triad hit
                            checkStruckGameNote(petal);
                            
                            // Visual glow/scale pulse
                            petal.material.emissiveIntensity = 1.6;
                            petal.scale.setScalar(petal.userData.originalScale * 1.2);
                            setTimeout(() => {
                                petal.material.emissiveIntensity = petal.userData.originalEmissive;
                                petal.scale.setScalar(petal.userData.originalScale);
                            }, 250);
                            
                            // Sparkles
                            triggerSparkExplosion(tipPos, petal.userData.frequency);
                        }
                    }
                });
            }
        }

        function animate() {
            requestAnimationFrame(animate);
            
            const delta = clock.getDelta();
            
            if (autoSpin) {
                rotationVelocity = 0.014; // Capped at max 8 RPM (0.014 rad/frame)
                lotusGroup.rotation.y += rotationVelocity;
            } else if (!isDragging) {
                // Inertial rotation
                lotusGroup.rotation.y += rotationVelocity;
                // Friction
                rotationVelocity *= 0.985;
            }

            // Arpeggiator: play arpeggio when spun quickly
            if (Math.abs(rotationVelocity) > 0.002) {
                accumulatedRotation += Math.abs(rotationVelocity);
                if (accumulatedRotation >= triggerAngleStep) {
                    accumulatedRotation = 0;
                    
                    // Trigger note in sequence
                    const noteIndex = arpeggioCounter % pentatonicScale.length;
                    const freq = pentatonicScale[noteIndex];
                    const petal = petalsArray.find(p => p.userData.noteIndex === noteIndex);
                    
                    // Faster rotation = brighter/louder plucked notes
                    const velocityFactor = Math.min(Math.abs(rotationVelocity) * 12, 1.6);
                    triggerSynthNote(freq, velocityFactor, petal);
                    
                    // Check Triad hit
                    if (petal) checkStruckGameNote(petal);
                    
                    // Flash a random petal
                    const flashPetal = petalsArray[Math.floor(Math.random() * petalsArray.length)];
                    flashPetal.material.emissiveIntensity = 1.0;
                    
                    arpeggioCounter++;
                }
            }

            // Update Striker pointer tools
            updateStriker(delta);

            // Update particle physics
            particlePool.forEach(spark => {
                if (spark.visible) {
                    spark.position.x += spark.userData.vx * delta;
                    spark.position.y += spark.userData.vy * delta;
                    spark.position.z += spark.userData.vz * delta;
                    
                    // Gravity pulling down
                    spark.userData.vy -= 9.8 * delta;
                    
                    // Fade over time
                    spark.userData.life -= delta * 2.0; 
                    if (spark.userData.life <= 0) {
                        spark.visible = false;
                    }
                }
            });

            // Adjust delay time based on spin velocity (creates cool pitch bends/warps!)
            if (delayNode && Math.abs(rotationVelocity) > 0.001) {
                const targetDelayTime = Math.max(0.1, Math.min(0.8 - (Math.abs(rotationVelocity) * 2), 0.7));
                delayNode.delayTime.setValueAtTime(targetDelayTime, audioCtx.currentTime);
            }

            // Update metrics
            document.getElementById('metric-speed').innerText = `${getRPM()} RPM`;

            // Soft organic hover/bobbing animation
            lotusGroup.position.y = Math.sin(Date.now() * 0.0012) * 0.15;
            // Wobble slightly when spinning
            lotusGroup.rotation.x = Math.sin(Date.now() * 0.002) * 0.05 + (rotationVelocity * 0.2);
            lotusGroup.rotation.z = Math.cos(Date.now() * 0.002) * 0.05;

            // Audio visualizer data processing
            if (analyser && freqDataArray) {
                analyser.getByteFrequencyData(freqDataArray);
                let sum = 0;
                for (let i = 0; i < freqDataArray.length; i++) {
                    sum += freqDataArray[i];
                }
                const avg = sum / freqDataArray.length; // 0 to 255
                const pct = avg / 255;
                
                // Drive CSS fluid scales on the background wrapping nodes
                document.documentElement.style.setProperty('--audio-scale-1', 1 + pct * 0.35);
                document.documentElement.style.setProperty('--audio-scale-2', 1 + pct * 0.3);
                
                // Drive SVG Network constellation lines stroke weight
                const strokeVal = 1.0 + pct * 3.5;
                document.querySelectorAll('#network-map polygon, #network-map line').forEach(el => {
                    el.setAttribute('stroke-width', strokeVal);
                });
            }

            renderer.render(scene, camera);
        }

        animate();

        // --- 11.5 PROCEDURAL BACKING DRUMS ENGINE ---
        let drumLoopInterval = null;
        let drumStep = 0;
        let isDrumPlaying = false;

        function triggerKick() {
            if (!audioCtx) return;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(mainGainNode);
            
            osc.frequency.setValueAtTime(150, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.15);
            
            gain.gain.setValueAtTime(0.65, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.15);
            
            osc.start();
            osc.stop(audioCtx.currentTime + 0.16);
        }

        function triggerHihat() {
            if (!audioCtx) return;
            const bufferSize = audioCtx.sampleRate * 0.05;
            const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
                data[i] = Math.random() * 2 - 1;
            }
            
            const noise = audioCtx.createBufferSource();
            noise.buffer = buffer;
            
            const filter = audioCtx.createBiquadFilter();
            filter.type = 'highpass';
            filter.frequency.setValueAtTime(7500, audioCtx.currentTime);
            
            const gain = audioCtx.createGain();
            gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.04);
            
            noise.connect(filter);
            filter.connect(gain);
            gain.connect(mainGainNode);
            
            noise.start();
        }

        function triggerSnare() {
            if (!audioCtx) return;
            // Noise component
            const noiseBufferSize = audioCtx.sampleRate * 0.2;
            const noiseBuffer = audioCtx.createBuffer(1, noiseBufferSize, audioCtx.sampleRate);
            const noiseData = noiseBuffer.getChannelData(0);
            for (let i = 0; i < noiseBufferSize; i++) {
                noiseData[i] = Math.random() * 2 - 1;
            }
            const noise = audioCtx.createBufferSource();
            noise.buffer = noiseBuffer;
            
            const noiseFilter = audioCtx.createBiquadFilter();
            noiseFilter.type = 'bandpass';
            noiseFilter.frequency.setValueAtTime(1200, audioCtx.currentTime);
            
            const noiseGain = audioCtx.createGain();
            noiseGain.gain.setValueAtTime(0.2, audioCtx.currentTime);
            noiseGain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.18);
            
            noise.connect(noiseFilter);
            noiseFilter.connect(noiseGain);
            noiseGain.connect(mainGainNode); // Corrected gain mapping to noiseGain
            
            // Tone component
            const osc = audioCtx.createOscillator();
            const oscGain = audioCtx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(180, audioCtx.currentTime);
            oscGain.gain.setValueAtTime(0.25, audioCtx.currentTime);
            oscGain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.08);
            
            osc.connect(oscGain);
            oscGain.connect(mainGainNode);
            
            noise.start();
            osc.start();
        }

        function startDrumLoop() {
            if (isDrumPlaying) return;
            isDrumPlaying = true;
            
            const bpm = 112;
            const stepTime = 60000 / bpm / 2; // eighth notes
            
            drumStep = 0;
            drumLoopInterval = setInterval(() => {
                if (!audioCtx) return;
                
                // Simple 4/4 Drum Pattern
                if (drumStep === 0 || drumStep === 4) {
                    triggerKick();
                }
                if (drumStep === 2 || drumStep === 6) {
                    triggerSnare();
                }
                if (drumStep === 1 || drumStep === 3 || drumStep === 5 || drumStep === 7) {
                    triggerHihat();
                }
                
                drumStep = (drumStep + 1) % 8;
            }, stepTime);
        }

        function stopDrumLoop() {
            isDrumPlaying = false;
            clearInterval(drumLoopInterval);
        }

