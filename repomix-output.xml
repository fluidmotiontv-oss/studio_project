        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            position: relative;
        }

        /* Fullscreen WebGL Canvas */
        #gameCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        /* Scanline HUD mesh overlay */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: 
                linear-gradient(rgba(255, 255, 255, 0.005) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.005) 1px, transparent 1px);
            background-size: 30px 30px;
            z-index: 2;
            pointer-events: none;
        }

        /* Head Up Display (HUD) */
        .hud-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10;
            pointer-events: none;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px 30px;
        }

        .hud-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .logo-area {
            display: flex;
            flex-direction: column;
        }

        .logo-area h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            font-weight: 900;
            letter-spacing: 2px;
            color: #fff;
            text-shadow: 0 0 10px rgba(189, 0, 255, 0.4);
        }

        .logo-area h1 span {
            color: var(--accent-cyan);
            text-shadow: 0 0 10px var(--accent-glow);
        }

        .logo-area span.sub {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.55rem;
            color: var(--accent-gold);
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-top: 2px;
        }

        .hud-stats {
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 10px 18px;
            display: flex;
            gap: 25px;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            box-shadow: 0 5px 25px rgba(0,0,0,0.6);
        }

        .stat-item {
            display: flex;
            flex-direction: column;
        }

        .stat-label {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.6rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-value {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            font-weight: 700;
            color: #fff;
        }

        .stat-value.cyan {
            color: var(--accent-cyan);
            text-shadow: 0 0 8px var(--accent-glow);
        }

        .stat-value.purple {
            color: var(--accent-purple);
            text-shadow: 0 0 8px rgba(189, 0, 255, 0.4);
        }

