            synthState.decay = parseFloat(sec);
        });

        // Delay Slider
        const sliderDelay = document.getElementById('slider-delay');
        sliderDelay.addEventListener('input', (e) => {
            const val = e.target.value;
            document.getElementById('val-delay').innerText = `${val}%`;
            synthState.delayFeedback = val / 100;
            if (delayFeedbackNode) {
                delayFeedbackNode.gain.setValueAtTime(synthState.delayFeedback, audioCtx.currentTime);
            }
        });

        // Vibe Selectors
        let activeVibe = 'harmonic';
        const btnVibeHarmonic = document.getElementById('btn-vibe-harmonic');
        const btnVibeVoid = document.getElementById('btn-vibe-void');

        function recolorPetals() {
            petalsArray.forEach(petal => {
                const ringIndex = petal.userData.ringIndex;
                const ringConfig = ringsConfig[ringIndex];
                const ringPetals = petalsArray.filter(p => p.userData.ringIndex === ringIndex);
                const idx = ringPetals.indexOf(petal);
                
                let hue;
                if (activeVibe === 'harmonic') {
                    hue = (idx / ringConfig.count) * 360 + ringConfig.startHue;
                } else {
                    hue = 240 + (idx / ringConfig.count) * 90; // Void violet/indigo
                }
                
                const colorHex = new THREE.Color(`hsl(${hue % 360}, 95%, 55%)`);
                petal.material.color.copy(colorHex);
                petal.material.emissive.copy(colorHex);
                
                if (showLabels && petal.userData.labelTexture) {
                    const colorStr = `hsl(${hue % 360}, 95%, 55%)`;
                    const labelTexture = createNoteTexture(petal.userData.noteName, colorStr);
                    petal.material.map = labelTexture;
                    petal.userData.labelTexture = labelTexture;
                }
                petal.material.needsUpdate = true;
            });
        }

        btnVibeHarmonic.addEventListener('click', () => {
            btnVibeHarmonic.classList.add('active');
            btnVibeVoid.classList.remove('active');
            activeVibe = 'harmonic';
            recolorPetals();
            pointLight.color.setHex(0x00e5ff);
            document.getElementById('metric-vibe').innerText = "HARMONIC";
            document.getElementById('metric-vibe').style.color = "var(--gold-accent)";
        });

        btnVibeVoid.addEventListener('click', () => {
            btnVibeVoid.classList.add('active');
            btnVibeHarmonic.classList.remove('active');
            activeVibe = 'void';
            recolorPetals();
            pointLight.color.setHex(0x8a2be2);
            document.getElementById('metric-vibe').innerText = "VOID RESONANCE";
            document.getElementById('metric-vibe').style.color = "#8a2be2";
        });

        // Petal Sampler Audio file loader
        const inputAudio = document.getElementById('input-audio');
        inputAudio.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file || !selectedPetal) return;
            
            const reader = new FileReader();
            reader.onload = function(evt) {
                const arrayBuffer = evt.target.result;
                audioCtx.decodeAudioData(arrayBuffer, (decodedBuffer) => {
                    selectedPetal.userData.customAudioBuffer = decodedBuffer;
                    console.log(`[SAMPLER] Sound loaded for note ${selectedPetal.userData.noteName}`);
                    
                    // Award Art points
                    gameState.contributionPoints += 250;
                    document.getElementById('metric-contrib').innerText = `${gameState.contributionPoints} Pts`;
                    showNotification("+250 Art Sync Nodes Integrated!", "var(--gold-accent)");
                }, (err) => {
                    console.error("Audio decode error:", err);
                    alert("Error decoding audio file.");
                });
            };
            reader.readAsArrayBuffer(file);
        });

        // Petal Custom Image loader
        const inputImage = document.getElementById('input-image');
        inputImage.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file || !selectedPetal) return;
            
            const url = URL.createObjectURL(file);
            const textureLoader = new THREE.TextureLoader();
            textureLoader.load(url, (texture) => {
                selectedPetal.material.map = texture;
                selectedPetal.material.needsUpdate = true;
                selectedPetal.userData.labelTexture = texture;
                console.log(`[SAMPLER] Texture loaded for note ${selectedPetal.userData.noteName}`);
                
                // Award Art points
                gameState.contributionPoints += 250;
                document.getElementById('metric-contrib').innerText = `${gameState.contributionPoints} Pts`;
                showNotification("+250 Visual Sync Nodes Integrated!", "var(--gold-accent)");
            });
        });

        // Start Triad Challenge Button
        const btnStartGame = document.getElementById('btn-start-game');
        btnStartGame.addEventListener('click', () => {
            initAudio();
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            startTriadChallenge();
        });

        // Bind 4 Tracks UI elements
        for (let i = 0; i < 4; i++) {
            document.getElementById(`btn-track-${i}`).addEventListener('click', () => {
                loopState.activeTrackIndex = i;
                updateTrackUI();
                showNotification(`ACTIVE: TRACK ${i+1}`, "var(--cyan-glow)");
            });
            
            document.getElementById(`btn-mute-${i}`).addEventListener('click', () => {
                loopState.trackMuted[i] = !loopState.trackMuted[i];
                updateTrackUI();
                if (loopState.trackMuted[i]) {
                    showNotification(`MUTED TRACK ${i+1}`, "#ef4444");
                } else {
                    showNotification(`UNMUTED TRACK ${i+1}`, "var(--cyan-glow)");
                }
                
                if (loopState.isLoopPlaying) {
                    startLoopPlayback();
                }
            });
            
            document.getElementById(`btn-clear-${i}`).addEventListener('click', () => {
                loopState.tracks[i] = [];
                updateTrackUI();
                showNotification(`CLEARED TRACK ${i+1}`, "#ef4444");
                
                if (loopState.isLoopPlaying) {
                    startLoopPlayback();
                }
            });
        }

        // Master Output recorder
        document.getElementById('btn-export-audio').addEventListener('click', toggleDeviceRecording);

        // --- 11.7 HARMONY EXCHANGE FEED & LOCAL STORAGE ---
        const communitySeeds = {
            'seed-nebula': [
                // Track 1
                [
                    { time: 0, frequency: 130.81, velocity: 1.0, petalId: 'petal_2_0' },
                    { time: 4000, frequency: 196.00, velocity: 1.0, petalId: 'petal_2_3' }
                ],
                // Track 2
                [
                    { time: 1000, frequency: 329.63, velocity: 0.8, petalId: 'petal_1_2' },
                    { time: 1000, frequency: 523.25, velocity: 0.8, petalId: 'petal_1_5' },
                    { time: 5000, frequency: 392.00, velocity: 0.8, petalId: 'petal_1_3' }
                ],
                // Track 3
                [
                    { time: 2000, frequency: 783.99, velocity: 0.7, petalId: 'petal_0_3' },
                    { time: 6000, frequency: 1046.50, velocity: 0.7, petalId: 'petal_0_5' }
                ],
                // Track 4
                []
            ],
            'seed-sunrise': [
                // Track 1
                [
                    { time: 0, frequency: 261.63, velocity: 0.9, petalId: 'petal_1_0' },
                    { time: 500, frequency: 329.63, velocity: 0.9, petalId: 'petal_1_2' },
                    { time: 1000, frequency: 392.00, velocity: 0.9, petalId: 'petal_1_3' },
                    { time: 1500, frequency: 440.00, velocity: 0.9, petalId: 'petal_1_4' },
                    { time: 2000, frequency: 523.25, velocity: 0.9, petalId: 'petal_1_5' },
                    { time: 2500, frequency: 587.33, velocity: 0.9, petalId: 'petal_1_6' },
                    { time: 3000, frequency: 659.25, velocity: 0.9, petalId: 'petal_1_7' },
                    { time: 3500, frequency: 783.99, velocity: 0.9, petalId: 'petal_1_8' }
                ],
                // Track 2
                [
                    { time: 0, frequency: 130.81, velocity: 1.0, petalId: 'petal_2_0' },
                    { time: 4000, frequency: 164.81, velocity: 1.0, petalId: 'petal_2_2' }
                ],
                // Track 3
                [],
                // Track 4
                []
            ],
            'seed-gateway': [
                // Track 1
                [
                    { time: 0, frequency: 130.81, velocity: 1.0, petalId: 'petal_2_0' },
                    { time: 1000, frequency: 130.81, velocity: 1.0, petalId: 'petal_2_0' },
                    { time: 2000, frequency: 146.83, velocity: 1.0, petalId: 'petal_2_1' },
                    { time: 3000, frequency: 164.81, velocity: 1.0, petalId: 'petal_2_2' },
                    { time: 4000, frequency: 196.00, velocity: 1.0, petalId: 'petal_2_3' },
                    { time: 5000, frequency: 196.00, velocity: 1.0, petalId: 'petal_2_3' },
                    { time: 6000, frequency: 220.00, velocity: 1.0, petalId: 'petal_2_4' },
                    { time: 7000, frequency: 261.63, velocity: 1.0, petalId: 'petal_2_5' }
                ],
                // Track 2
                [
                    { time: 500, frequency: 440.00, velocity: 0.8, petalId: 'petal_1_4' },
                    { time: 1500, frequency: 783.99, velocity: 0.8, petalId: 'petal_1_8' },
                    { time: 2500, frequency: 659.25, velocity: 0.8, petalId: 'petal_1_7' },
                    { time: 4500, frequency: 440.00, velocity: 0.8, petalId: 'petal_1_4' },
                    { time: 5500, frequency: 783.99, velocity: 0.8, petalId: 'petal_1_8' },
                    { time: 6500, frequency: 659.25, velocity: 0.8, petalId: 'petal_1_7' }
                ],
                // Track 3
                [],
                // Track 4
                []
            ]
        };

        function getResonanceCode() {
            const data = loopState.tracks.map(track => 
                track.map(evt => ({
                    t: evt.time,
                    f: evt.frequency,
                    v: parseFloat(evt.velocity.toFixed(2)),
                    p: evt.petalId
                }))
            );
            const str = JSON.stringify(data);
            return btoa(unescape(encodeURIComponent(str)));
        }

        function loadResonanceCode(codeStr) {
            try {
                const str = decodeURIComponent(escape(atob(codeStr)));
                const data = JSON.parse(str);
                
                if (Array.isArray(data) && data.length === 4) {
                    loopState.tracks = data.map(track => 
                        track.map(evt => ({
                            time: evt.t,
                            frequency: evt.f,
                            velocity: evt.v,
                            petalId: evt.p
                        }))
                    );
                    updateTrackUI();
                    showNotification("RESONANCE CODE IMPORTED!", "var(--cyan-glow)");
                    startLoopPlayback();
                    return true;
                }
            } catch(e) {
                console.error(e);
            }
            alert("Invalid Resonance Code structure.");
            return false;
        }

        function saveCompositionLocal(name) {
            if (!name) return;
            const code = getResonanceCode();
            const savedJams = JSON.parse(localStorage.getItem('lotus_saved_jams') || '{}');
            savedJams[name] = code;
            localStorage.setItem('lotus_saved_jams', JSON.stringify(savedJams));
            
            showNotification(`SAVED: ${name}`, "var(--gold-accent)");
            rebuildFeedDropdown();
        }

        function rebuildFeedDropdown() {
            const dropdown = document.getElementById('dropdown-feed');
            dropdown.innerHTML = `
                <option value="none">-- Collective Song Feed --</option>
                <option value="seed-nebula">🌌 Nebula Echoes (Ambient)</option>
                <option value="seed-sunrise">🌅 Golden Sunrise (Arps)</option>
                <option value="seed-gateway">🌀 Gateway Pulse (Bass/Beat)</option>
            `;
            
            const savedJams = JSON.parse(localStorage.getItem('lotus_saved_jams') || '{}');
            Object.keys(savedJams).forEach(name => {
                const opt = document.createElement('option');
                opt.value = 'local-' + name;
                opt.innerText = '💾 ' + name + ' (Local)';
                dropdown.appendChild(opt);
            });
        }

        // Bind Feed Dropdown change
        document.getElementById('dropdown-feed').addEventListener('change', (e) => {
            initAudio();
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }

            const val = e.target.value;
            if (val === 'none') return;
            
            if (val.startsWith('local-')) {
                const jamName = val.replace('local-', '');
                const savedJams = JSON.parse(localStorage.getItem('lotus_saved_jams') || '{}');
                const code = savedJams[jamName];
                if (code) {
                    loadResonanceCode(code);
                }
            } else if (communitySeeds[val]) {
                // Load community seeds
                loopState.tracks = JSON.parse(JSON.stringify(communitySeeds[val]));
                updateTrackUI();
                showNotification(`LOADED SEED TRACK!`, "var(--cyan-glow)");
                startLoopPlayback();
            }
        });

        // Bind Save Local Button
        document.getElementById('btn-save-local').addEventListener('click', () => {
            const input = document.getElementById('input-save-name');
            const name = input.value.trim();
            if (!name) {
                alert("Please enter a name for your jam.");
                return;
            }
            saveCompositionLocal(name);
            input.value = "";
        });

        // Bind Export Code Button
        document.getElementById('btn-share-code').addEventListener('click', () => {
            const code = getResonanceCode();
            navigator.clipboard.writeText(code).then(() => {
                showNotification("RESONANCE CODE COPIED!", "var(--gold-accent)");
            }).catch(err => {
                prompt("Copy your Resonance Code below:", code);
            });
        });

        // Bind Import Code Button
        document.getElementById('btn-import-code').addEventListener('click', () => {
            const code = prompt("Paste your Resonance Code here:");
            if (code) {
                loadResonanceCode(code.trim());
            }
        });

        rebuildFeedDropdown();
        updateTrackUI();

        // Pointer Striker Tool selection
        const toolButtons = {
            finger: document.getElementById('btn-tool-finger'),
            wand: document.getElementById('btn-tool-wand'),
            drumstick: document.getElementById('btn-tool-drumstick')
        };

        Object.keys(toolButtons).forEach(key => {
            toolButtons[key].addEventListener('click', () => {
                Object.values(toolButtons).forEach(b => b.classList.remove('active'));
                toolButtons[key].classList.add('active');
                currentToolType = key;
                rebuildStriker();
            });
        });

        // Preset Selector Buttons
        const presetButtons = {
            piano: document.getElementById('btn-preset-piano'),
            pad: document.getElementById('btn-preset-pad'),
            pluck: document.getElementById('btn-preset-pluck')
        };

        Object.keys(presetButtons).forEach(key => {
            presetButtons[key].addEventListener('click', () => {
                Object.values(presetButtons).forEach(b => b.classList.remove('active'));
                presetButtons[key].classList.add('active');
                synthState.currentPreset = key;
            });
        });

        // Auto Spin Orbit
        const btnAutoSpin = document.getElementById('btn-auto-spin');
        btnAutoSpin.addEventListener('click', () => {
            autoSpin = !autoSpin;
            if (autoSpin) {
                btnAutoSpin.classList.add('active');
            } else {
                btnAutoSpin.classList.remove('active');
                rotationVelocity = 0;
            }
        });

        // Backing Beat Drum Loop Toggle
        const btnDrumLoop = document.getElementById('btn-drum-loop');
        btnDrumLoop.addEventListener('click', () => {
            initAudio();
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            
            if (!isDrumPlaying) {
                startDrumLoop();
                btnDrumLoop.classList.add('active');
            } else {
                stopDrumLoop();
                btnDrumLoop.classList.remove('active');
            }
        });

        // Toggle Note Labels
        let showLabels = true;
        const btnToggleLabels = document.getElementById('btn-toggle-labels');
        btnToggleLabels.addEventListener('click', () => {
            showLabels = !showLabels;
            if (showLabels) {
                btnToggleLabels.classList.add('active');
            } else {
                btnToggleLabels.classList.remove('active');
            }
            petalsArray.forEach(petal => {
                petal.material.map = showLabels ? petal.userData.labelTexture : null;
                petal.material.needsUpdate = true;
            });
        });

        // Shape Selection
        const dropdownShapes = document.getElementById('dropdown-shapes');
        dropdownShapes.addEventListener('change', (e) => {
            const selectedShape = e.target.value;
            const targetGeom = petalGeometries[selectedShape];
            petalsArray.forEach(petal => {
                petal.geometry = targetGeom;
            });
        });

        // Spacing Slider
        const sliderSpacing = document.getElementById('slider-spacing');
        sliderSpacing.addEventListener('input', (e) => {
            const val = e.target.value;
            document.getElementById('val-spacing').innerText = `${val}%`;
            const multiplier = val / 100;
            
            petalsArray.forEach(petal => {
                const ringIndex = petal.userData.ringIndex;
                const ringConfig = ringsConfig[ringIndex];
                
                // Find all petals in this ring to locate index
                const ringPetals = petalsArray.filter(p => p.userData.ringIndex === ringIndex);
                const petalIdx = ringPetals.indexOf(petal);
                const theta = (petalIdx / ringConfig.count) * Math.PI * 2;
                
                const r = ringConfig.radius * multiplier;
                petal.position.x = Math.cos(theta) * r;
                petal.position.z = Math.sin(theta) * r;
            });
        });

        // Handle Resize
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        // --- PLAY MODE BUTTON TOGGLE ---
        const btnPlayMode = document.getElementById('btn-play-mode');
        btnPlayMode.addEventListener('click', () => {
            document.body.classList.toggle('play-mode-active');
            const isActive = document.body.classList.contains('play-mode-active');
            btnPlayMode.classList.toggle('active', isActive);
            if (isActive) {
                btnPlayMode.innerHTML = `<span class="icon">✕</span> Exit Solo Play`;
            } else {
                btnPlayMode.innerHTML = `<span class="icon">✨</span> Play Mode`;
            }
        });

    </script>
</body>
</html>
