    <!-- WebGL & Interactive Scripts -->
    <script type="module">
        import * as THREE from './three.module.min.js';

        // --- 1. WEB AUDIO SYNTH ENGINE ---
        let audioCtx = null;
        let mainGainNode = null;
        let delayNode = null;
        let delayFeedbackNode = null;

        // Synth Settings (State)
        const synthState = {
            volume: 0.75,
            cutoff: 0.6,
            resonance: 0.4,
            attack: 0.1,
            decay: 1.5,
            delayFeedback: 0.3,
            currentPreset: 'piano' // piano, pad, pluck
        };

        // Looper Engine Settings (4-Track Mixer)
        const loopState = {
            isRecording: false,
            isLoopPlaying: false,
            recordStartTime: 0,
            activeTrackIndex: 0,
            tracks: [ [], [], [], [] ], // 4 tracks of loop events
            trackMuted: [ false, false, false, false ],
            loopDuration: 8000, // 8 seconds loop
            loopTimer: null,
            loopPlayTimeouts: [],
            progressIntervalId: null
        };

        let analyser = null;
        let freqDataArray = null;
        let limiter = null;

        function initAudio() {
            if (audioCtx) return;
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            
            mainGainNode = audioCtx.createGain();
            mainGainNode.gain.setValueAtTime(synthState.volume, audioCtx.currentTime);
            
            // Create Feedback Delay (Reverb effect)
            delayNode = audioCtx.createDelay(2.0);
            delayNode.delayTime.setValueAtTime(0.35, audioCtx.currentTime); // 350ms delay
            
            delayFeedbackNode = audioCtx.createGain();
            delayFeedbackNode.gain.setValueAtTime(synthState.delayFeedback, audioCtx.currentTime);
            
            // Connect delay feedback loop
            delayNode.connect(delayFeedbackNode);
            delayFeedbackNode.connect(delayNode);
            
            // Analyser node for audio visualizer
            analyser = audioCtx.createAnalyser();
            analyser.fftSize = 64;
            freqDataArray = new Uint8Array(analyser.frequencyBinCount);

            // Create brick-wall Limiter to stop popping/clipping
            limiter = audioCtx.createDynamicsCompressor();
            limiter.threshold.setValueAtTime(-1.5, audioCtx.currentTime); // start limiting at -1.5dB
            limiter.knee.setValueAtTime(0.0, audioCtx.currentTime);        // hard knee for strict limit
            limiter.ratio.setValueAtTime(20.0, audioCtx.currentTime);     // high ratio to act as brick wall
            limiter.attack.setValueAtTime(0.003, audioCtx.currentTime);   // 3ms attack to catch transients
            limiter.release.setValueAtTime(0.08, audioCtx.currentTime);   // 80ms release for smooth decay

            // Connect main pathway: Gain -> Analyser -> Limiter
            mainGainNode.connect(analyser);
            analyser.connect(limiter);
            
            // Connect wet delay pathway: Gain -> Delay -> Limiter
            mainGainNode.connect(delayNode);
            delayNode.connect(limiter);

            // Connect Limiter to speakers
            limiter.connect(audioCtx.destination);
        }

        const pentatonicScale = [
            130.81, // C3
            146.83, // D3
            164.81, // E3
            196.00, // G3
            220.00, // A3
            261.63, // C4
            293.66, // D4
            329.63, // E4
            392.00, // G4
            440.00, // A4
            523.25, // C5
            587.33, // D5
            659.25, // E5
            783.99, // G5
            880.00, // A5
            1046.50 // C6
        ];

        const pentatonicNames = [
            "C3", "D3", "E3", "G3", "A3",
            "C4", "D4", "E4", "G4", "A4",
            "C5", "D5", "E5", "G5", "A5", "C6"
        ];

        function triggerSynthNote(freq, scaleFactor = 1.0, targetPetal = null) {
            if (!audioCtx) return;

            // Play custom loaded audio sample if present
            if (targetPetal && targetPetal.userData.customAudioBuffer) {
                const playSource = audioCtx.createBufferSource();
                playSource.buffer = targetPetal.userData.customAudioBuffer;
                
                const gainNode = audioCtx.createGain();
                gainNode.gain.setValueAtTime(0.5 * scaleFactor, audioCtx.currentTime);
                
                playSource.connect(gainNode);
                gainNode.connect(mainGainNode);
                
                playSource.start();

                // looper event capture
                if (loopState.isRecording) {
                    const elapsed = Date.now() - loopState.recordStartTime;
                    if (elapsed < loopState.loopDuration) {
                        loopState.tracks[loopState.activeTrackIndex].push({
                            time: elapsed,
                            frequency: freq,
                            velocity: scaleFactor,
                            petalId: targetPetal.userData.id
                        });
                    }
                }
                return;
            }
            
            const osc = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();
            const filterNode = audioCtx.createBiquadFilter();
            
            // Setup Oscillator type based on Preset
            if (synthState.currentPreset === 'piano') {
                osc.type = 'triangle';
            } else if (synthState.currentPreset === 'pad') {
                osc.type = 'sine';
                osc.detune.setValueAtTime(Math.random() * 10 - 5, audioCtx.currentTime);
            } else {
                osc.type = 'sawtooth';
            }
            
            osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
            
            // Setup Filter (Low-pass)
            filterNode.type = 'lowpass';
            
            const baseCutoff = 100 + (synthState.cutoff * 7900);
            filterNode.frequency.setValueAtTime(baseCutoff, audioCtx.currentTime);
            filterNode.frequency.exponentialRampToValueAtTime(baseCutoff * 0.1, audioCtx.currentTime + synthState.decay);
            filterNode.Q.setValueAtTime(synthState.resonance * 20, audioCtx.currentTime);
            
            // Amp Envelope
            gainNode.gain.setValueAtTime(0, audioCtx.currentTime);
            gainNode.gain.linearRampToValueAtTime(0.25 * scaleFactor, audioCtx.currentTime + synthState.attack);
            gainNode.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + synthState.attack + synthState.decay);
            
            // Connections
            osc.connect(filterNode);
            filterNode.connect(gainNode);
            gainNode.connect(mainGainNode);
            
            osc.start();
            osc.stop(audioCtx.currentTime + synthState.attack + synthState.decay + 0.1);

            // looper event capture
            if (loopState.isRecording) {
                const elapsed = Date.now() - loopState.recordStartTime;
                if (elapsed < loopState.loopDuration) {
                    loopState.tracks[loopState.activeTrackIndex].push({
                        time: elapsed,
                        frequency: freq,
                        velocity: scaleFactor,
                        petalId: targetPetal ? targetPetal.userData.id : null
                    });
                }
            }
        }

        // --- 2. THREE.JS 3D SCENE SETUP ---
        const container = document.getElementById('canvas-container');
        const scene = new THREE.Scene();
        
        scene.fog = new THREE.FogExp2(0x020617, 0.05);

        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 100);
        camera.position.set(0, 5, 8);
        camera.lookAt(0, 0, 0);

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        container.appendChild(renderer.domElement);

        // Lights
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.35); // Increased for better petal contrast
        scene.add(ambientLight);

        const dirLight = new THREE.DirectionalLight(0xffffff, 1.2); // Brightened main directional light
        dirLight.position.set(5, 10, 7);
        scene.add(dirLight);

        const dirLight2 = new THREE.DirectionalLight(0x00e5ff, 0.45); // Added subtle cyan rim lighting
        dirLight2.position.set(-5, -5, -3);
        scene.add(dirLight2);

        const pointLight = new THREE.PointLight(0x00e5ff, 2, 10);
        pointLight.position.set(0, 1.5, 0);
        scene.add(pointLight);

        // --- 3. DYNAMIC CANVAS TEXTURE FOR NOTE LABELS ---
        function createNoteTexture(noteName, colorStr) {
            const canvas = document.createElement('canvas');
            canvas.width = 128;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');
            
            ctx.fillStyle = 'rgba(0, 0, 0, 0)';
            ctx.fillRect(0, 0, 128, 256);
            
            // Render text with maximum contrast: white core + glowing aquamarine outline and shadow
            ctx.font = 'bold 38px Orbitron';
            ctx.fillStyle = '#ffffff'; 
            ctx.textAlign = 'center';
            ctx.shadowColor = '#00ffd8'; // Phosphorescent aquamarine glow
            ctx.shadowBlur = 18;
            ctx.fillText(noteName, 64, 180); // position text towards tip of petal
            
            // Clean outer stroke to ensure crispness
            ctx.strokeStyle = 'rgba(0, 255, 216, 0.9)';
            ctx.lineWidth = 2.0;
            ctx.strokeText(noteName, 64, 180);
            
            const texture = new THREE.CanvasTexture(canvas);
            texture.needsUpdate = true;
            return texture;
        }

        // --- 4. PROCEDURAL 3D LOTUS BUILDER ---
        const lotusGroup = new THREE.Group();
        scene.add(lotusGroup);

        function createPetalGeometry(type) {
            const shape = new THREE.Shape();
            if (type === 'lotus') {
                shape.moveTo(0, 0);
                shape.quadraticCurveTo(0.6, 0.8, 0.2, 2.0); 
                shape.quadraticCurveTo(0.0, 2.5, -0.2, 2.0); 
                shape.quadraticCurveTo(-0.6, 0.8, 0, 0);
            } else if (type === 'round') {
                shape.moveTo(0, 0);
                shape.quadraticCurveTo(0.8, 0.5, 0.5, 1.8);
                shape.quadraticCurveTo(0.0, 2.2, -0.5, 1.8);
                shape.quadraticCurveTo(-0.8, 0.5, 0, 0);
            } else { // star / crystal
                shape.moveTo(0, 0);
                shape.lineTo(0.5, 0.9);
                shape.lineTo(0, 2.3);
                shape.lineTo(-0.5, 0.9);
                shape.closePath();
            }
            
            const geometry = new THREE.ShapeGeometry(shape, 24);
            const pos = geometry.attributes.position;
            for (let i = 0; i < pos.count; i++) {
                const x = pos.getX(i);
                const y = pos.getY(i);
                const z = -0.25 * (x * x) + 0.12 * y;
                pos.setZ(i, z);
            }
            geometry.computeVertexNormals();
            return geometry;
        }

        const petalGeometries = {
            lotus: createPetalGeometry('lotus'),
            round: createPetalGeometry('round'),
            star: createPetalGeometry('star')
        };

        const petalGeometry = petalGeometries.lotus;

        // Rings configurations (Widened to give the flower layout room and prevent tightness)
        const ringsConfig = [
            { count: 6, radius: 0.6, scale: 0.6, rx: 0.4, noteOffset: 10, startHue: 0 },
            { count: 12, radius: 1.4, scale: 0.85, rx: 0.7, noteOffset: 5, startHue: 120 },
            { count: 18, radius: 2.2, scale: 1.1, rx: 1.0, noteOffset: 0, startHue: 240 }
        ];

        const petalsArray = [];

        ringsConfig.forEach((ring, ringIdx) => {
            for (let i = 0; i < ring.count; i++) {
                const theta = (i / ring.count) * Math.PI * 2;
                
                // Dynamic HSL spectrum calculation
                const hue = (i / ring.count) * 360 + ring.startHue;
                const colorHex = new THREE.Color(`hsl(${hue % 360}, 90%, 55%)`);
                const colorStr = `hsl(${hue % 360}, 90%, 55%)`;

                const noteIndex = ring.noteOffset + (i % 6);
                const noteName = pentatonicNames[noteIndex];
                
                const labelTexture = createNoteTexture(noteName, colorStr);
                
                const petalMaterial = new THREE.MeshStandardMaterial({
                    color: colorHex,
                    map: labelTexture,
                    transparent: true,
                    metalness: 0.75,
                    roughness: 0.25,
                    emissive: colorHex,
                    emissiveIntensity: 0.22,
                    side: THREE.DoubleSide
                });

                const petalMesh = new THREE.Mesh(petalGeometry, petalMaterial);
                
                petalMesh.position.x = Math.cos(theta) * ring.radius;
                petalMesh.position.z = Math.sin(theta) * ring.radius;
                petalMesh.position.y = (3 - ringIdx) * 0.18 - 0.2; 
                
                petalMesh.rotation.y = -theta - Math.PI / 2; 
                petalMesh.rotation.x = ring.rx; 
                
                petalMesh.scale.setScalar(ring.scale);
                
                petalMesh.userData = {
                    noteIndex: noteIndex,
                    frequency: pentatonicScale[noteIndex],
                    noteName: noteName,
                    originalScale: ring.scale,
                    originalEmissive: 0.15,
                    ringIndex: ringIdx,
                    labelTexture: labelTexture,
                    id: `petal_${ringIdx}_${i}`
                };
                
                lotusGroup.add(petalMesh);
                petalsArray.push(petalMesh);
            }
        });

        // Center Seed Pod
        const podGeom = new THREE.CylinderGeometry(0.3, 0.2, 0.3, 16);
        const podMat = new THREE.MeshStandardMaterial({
            color: 0xd4af37,
            metalness: 0.8,
            roughness: 0.2,
            emissive: 0xd4af37,
            emissiveIntensity: 0.2
        });
        const seedPod = new THREE.Mesh(podGeom, podMat);
        seedPod.position.y = 0.1;
        lotusGroup.add(seedPod);

        // Center Orb
        const orbGeom = new THREE.SphereGeometry(0.12, 16, 16);
        const orbMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
        const coreOrb = new THREE.Mesh(orbGeom, orbMat);
        coreOrb.position.y = 0.28;
        lotusGroup.add(coreOrb);

        // --- 5. 3D STRIKER MODELS & INTERACTIVE POINTERS ---
        const strikerGroup = new THREE.Group();
        scene.add(strikerGroup);

        let currentToolType = 'finger'; // finger, wand, drumstick
        let activeStrikerMesh = null;

        function rebuildStriker() {
            if (activeStrikerMesh) strikerGroup.remove(activeStrikerMesh);
            
            if (currentToolType === 'finger') {
                // Floating glowing neon glass orb
                const geom = new THREE.SphereGeometry(0.12, 16, 16);
                const mat = new THREE.MeshStandardMaterial({ 
                    color: 0x00e5ff, 
                    transparent: true,
                    opacity: 0.8,
                    roughness: 0.1,
                    metalness: 0.1,
                    emissive: 0x00e5ff,
                    emissiveIntensity: 1.2
                });
                activeStrikerMesh = new THREE.Mesh(geom, mat);
                
                const pointerLight = new THREE.PointLight(0x00e5ff, 1.5, 3);
                activeStrikerMesh.add(pointerLight);
            } 
            else if (currentToolType === 'wand') {
                // Translucent crystalline glass rod with gold core
                const group = new THREE.Group();
                
                const handleGeom = new THREE.CylinderGeometry(0.018, 0.018, 1.5, 12);
                const handleMat = new THREE.MeshStandardMaterial({ 
                    color: 0x00e5ff, 
                    transparent: true, 
                    opacity: 0.6, 
                    roughness: 0.2,
                    emissive: 0x00e5ff,
                    emissiveIntensity: 0.3
                });
                const handle = new THREE.Mesh(handleGeom, handleMat);
                handle.rotation.x = Math.PI / 2;
                group.add(handle);
                
                // Glowing golden core sphere tip
                const tipGeom = new THREE.SphereGeometry(0.08, 16, 16);
                const tipMat = new THREE.MeshStandardMaterial({ 
                    color: 0xd4af37, 
                    metalness: 0.9, 
                    roughness: 0.1,
                    emissive: 0xd4af37,
                    emissiveIntensity: 2.0
                });
                const tip = new THREE.Mesh(tipGeom, tipMat);
                tip.position.z = -0.75; 
                group.add(tip);
                
                const wandLight = new THREE.PointLight(0xd4af37, 2.0, 4);
                tip.add(wandLight);
                
                activeStrikerMesh = group;
            } 
            else if (currentToolType === 'drumstick') {
                // Glowing magenta energy rod
                const group = new THREE.Group();
                
                const stickGeom = new THREE.CylinderGeometry(0.015, 0.025, 1.2, 12);
                const stickMat = new THREE.MeshStandardMaterial({ 
                    color: 0x3b82f6, 
                    transparent: true, 
                    opacity: 0.6,
                    roughness: 0.2,
                    emissive: 0x3b82f6,
                    emissiveIntensity: 0.4
                });
                const stick = new THREE.Mesh(stickGeom, stickMat);
                stick.rotation.x = Math.PI / 2;
                group.add(stick);
                
                // Hot pink tip
                const headGeom = new THREE.SphereGeometry(0.10, 16, 16);
                const headMat = new THREE.MeshStandardMaterial({ 
                    color: 0xff007f, 
                    roughness: 0.1, 
                    metalness: 0.3,
                    emissive: 0xff007f,
                    emissiveIntensity: 2.0
                });
                const head = new THREE.Mesh(headGeom, headMat);
                head.position.z = -0.6;
                group.add(head);
                
                const headLight = new THREE.PointLight(0xff007f, 1.8, 3.5);
                head.add(headLight);
                
                activeStrikerMesh = group;
            }
            
            strikerGroup.add(activeStrikerMesh);
        }

        rebuildStriker();

        // Project cursor coordinates onto Plane (y = 0.2)
        const trackerPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -0.2); 
        const mouseRaycaster = new THREE.Raycaster();
        const mouse2D = new THREE.Vector2();
        const target3D = new THREE.Vector3();

        window.addEventListener('mousemove', (e) => {
            mouse2D.x = (e.clientX / window.innerWidth) * 2 - 1;
            mouse2D.y = -(e.clientY / window.innerHeight) * 2 + 1;
            
            mouseRaycaster.setFromCamera(mouse2D, camera);
            mouseRaycaster.ray.intersectPlane(trackerPlane, target3D);
            target3D.clampLength(0, 4.0);

            if (isDragging) {
                const currentAngle = Math.atan2(e.clientY - window.innerHeight / 2, e.clientX - window.innerWidth / 2);
                let angleDiff = currentAngle - previousAngle;
                
                // Handle wraparound
                if (angleDiff > Math.PI) angleDiff -= Math.PI * 2;
                if (angleDiff < -Math.PI) angleDiff += Math.PI * 2;
                
                // Max 8 RPM velocity clamping (capping at 0.014 rad/frame)
                const maxVel = 0.014;
                rotationVelocity = Math.max(-maxVel, Math.min(maxVel, angleDiff));
                
                lotusGroup.rotation.y += rotationVelocity;
                previousAngle = currentAngle;
            }
        });

        // Touch support coordinate mapping
        window.addEventListener('touchmove', (e) => {
            const touch = e.touches[0];
            mouse2D.x = (touch.clientX / window.innerWidth) * 2 - 1;
            mouse2D.y = -(touch.clientY / window.innerHeight) * 2 + 1;
            mouseRaycaster.setFromCamera(mouse2D, camera);
            mouseRaycaster.ray.intersectPlane(trackerPlane, target3D);
            target3D.clampLength(0, 4.0);

            if (isDragging) {
                const currentAngle = Math.atan2(touch.clientY - window.innerHeight / 2, touch.clientX - window.innerWidth / 2);
                let angleDiff = currentAngle - previousAngle;
                
                if (angleDiff > Math.PI) angleDiff -= Math.PI * 2;
                if (angleDiff < -Math.PI) angleDiff += Math.PI * 2;
                
                const maxVel = 0.014;
                rotationVelocity = Math.max(-maxVel, Math.min(maxVel, angleDiff));
                
                lotusGroup.rotation.y += rotationVelocity;
                previousAngle = currentAngle;
            }
        });

        // --- 6. SPARK PARTICLE EXPLOSION POOL ---
        const particleCount = 30;
        const particlePool = [];
        const particleGroup = new THREE.Group();
        scene.add(particleGroup);

        const sparkGeom = new THREE.SphereGeometry(0.04, 4, 4);
        const sparkMat = new THREE.MeshBasicMaterial({ color: 0x00e5ff });

        for (let i = 0; i < particleCount; i++) {
            const spark = new THREE.Mesh(sparkGeom, sparkMat.clone());
            spark.visible = false;
            spark.userData = { vx: 0, vy: 0, vz: 0, life: 0 };
            particleGroup.add(spark);
            particlePool.push(spark);
        }

        function triggerSparkExplosion(pos, freq) {
            let triggeredCount = 0;
            const ringColors = ['#00e5ff', '#d4af37', '#3b82f6'];
            
            particlePool.forEach(spark => {
                if (!spark.visible && triggeredCount < 10) {
                    spark.visible = true;
                    spark.position.copy(pos);
                    
                    // Velocity vectors flying out and up
                    spark.userData.vx = (Math.random() - 0.5) * 5;
                    spark.userData.vy = Math.random() * 4 + 2; 
                    spark.userData.vz = (Math.random() - 0.5) * 5;
                    spark.userData.life = 1.0; 
                    
                    // Set color based on note
                    spark.material.color.setHSL((freq % 200) / 200, 1.0, 0.5);
                    triggeredCount++;
                }
            });
        }

        // --- 6.5 TRIAD NETWORK CHALLENGE ENGINE ---
        const networkTriads = [
            { name: "C Major Triad", notes: [0, 2, 3], color: '#00e5ff', polyId: 'triad-poly-0', nodes: ['node-0-0', 'node-0-1', 'node-0-2'] },
            { name: "A Minor Triad", notes: [4, 5, 7], color: '#d4af37', polyId: 'triad-poly-1', nodes: ['node-1-0', 'node-1-1', 'node-1-2'] },
            { name: "G Sus4 Triad",  notes: [3, 5, 6], color: '#d4af37', polyId: 'triad-poly-2', nodes: ['node-2-0', 'node-2-1', 'node-2-2'] },
            { name: "C high Chord",  notes: [7, 8, 10], color: '#00e5ff', polyId: 'triad-poly-3', nodes: ['node-3-0', 'node-3-1', 'node-3-2'] }
        ];

        const gameState = {
            active: false,
            currentTriadIndex: 0,
            activeStruckNotes: [],
            contributionPoints: 0,
            activeNodes: 0
        };

        function showNotification(text, colorStr = 'var(--gold-accent)') {
            const notif = document.createElement('div');
            notif.innerText = text;
            notif.style.position = 'absolute';
            notif.style.left = '50%';
            notif.style.top = '40%';
            notif.style.transform = 'translate(-50%, -50%)';
            notif.style.fontFamily = 'Orbitron, sans-serif';
            notif.style.fontSize = '1.3rem';
            notif.style.fontWeight = 'bold';
            notif.style.color = colorStr;
            notif.style.textShadow = `0 0 15px ${colorStr}`;
            notif.style.zIndex = '100';
            notif.style.pointerEvents = 'none';
            notif.style.transition = 'all 1.0s cubic-bezier(0.1, 0.8, 0.3, 1)';
            
            document.body.appendChild(notif);
            
            setTimeout(() => {
                notif.style.top = '25%';
                notif.style.opacity = '0';
            }, 50);
            
            setTimeout(() => {
                notif.remove();
            }, 1100);
        }

        function playTriadChord(triad) {
            triad.notes.forEach(noteIdx => {
                const freq = pentatonicScale[noteIdx];
                const petal = petalsArray.find(p => p.userData.noteIndex === noteIdx);
                triggerSynthNote(freq, 1.0, petal);
                
                if (petal) {
                    petal.material.emissiveIntensity = 2.2;
                    petal.scale.setScalar(petal.userData.originalScale * 1.35);
                    setTimeout(() => {
                        petal.material.emissiveIntensity = petal.userData.originalEmissive;
                        petal.scale.setScalar(petal.userData.originalScale);
                    }, 1400);
                }
            });
        }

        function startTriadChallenge() {
            gameState.active = true;
            gameState.currentTriadIndex = 0;
            gameState.activeNodes = 0;
            gameState.activeStruckNotes = [];
            
            stopLoopPlayback();
            stopDrumLoop();
            
            document.getElementById('btn-drum-loop').classList.remove('active');
            document.getElementById('btn-record').innerText = "RECORD LOOP";
            document.getElementById('btn-record').className = "btn-loop";
            
            // Reset background SVG nodes
            networkTriads.forEach(t => {
                const poly = document.getElementById(t.polyId);
                if (poly) {
                    poly.setAttribute('fill', 'rgba(255,255,255,0.01)');
                    poly.setAttribute('stroke', 'rgba(255,255,255,0.15)');
                    poly.removeAttribute('filter');
                }
                t.nodes.forEach(n => {
                    const circle = document.getElementById(n);
                    if (circle) {
                        circle.setAttribute('fill', '#090d16');
                        circle.style.filter = '';
                    }
                });
            });

            document.getElementById('metric-sync').innerText = "0%";
            loadCurrentTriad();
        }

        function loadCurrentTriad() {
            if (gameState.currentTriadIndex >= networkTriads.length) {
                // Victory!
                showNotification("FUTURE ANCHORED - 100% SYNCED!", "var(--gold-accent)");
                document.getElementById('metric-sync').innerText = "100%";
                gameState.active = false;
                
                document.getElementById('instruction-label').innerHTML = `
                    <span style="color:var(--gold-accent); font-weight:bold; font-size:1.1rem;">CORRIDOR SECURED</span><br>
                    Future node sequence fully synchronized. Triad complete!
                `;

                petalsArray.forEach(p => {
                    p.material.emissiveIntensity = 2.5;
                    setTimeout(() => {
                        p.material.emissiveIntensity = p.userData.originalEmissive;
                    }, 2000);
                });
                return;
            }
            
            const triad = networkTriads[gameState.currentTriadIndex];
            gameState.activeStruckNotes = [];
            
            document.getElementById('instruction-label').innerHTML = `
                <span style="color:var(--gold-accent); font-weight:bold;">TRIAD GATEWAY</span><br>
                Re-create the Chord: <span style="color:var(--cyan-glow); font-weight: 600;">${triad.name}</span>
            `;
            
            showNotification(`SYNCING: ${triad.name}`, triad.color);
            
            setTimeout(() => {
                playTriadChord(triad);
            }, 600);
        }

        function checkStruckGameNote(petal) {
            if (!gameState.active) return;
            
            const noteIdx = petal.userData.noteIndex;
            const triad = networkTriads[gameState.currentTriadIndex];
            
            if (triad.notes.includes(noteIdx)) {
                if (!gameState.activeStruckNotes.includes(noteIdx)) {
                    gameState.activeStruckNotes.push(noteIdx);
                    
                    petal.material.emissiveIntensity = 2.0;
                    
                    const subNodeIdx = triad.notes.indexOf(noteIdx);
                    const subNodeId = triad.nodes[subNodeIdx];
                    const circle = document.getElementById(subNodeId);
                    if (circle) {
                        circle.setAttribute('fill', triad.color);
                        circle.style.filter = "url(#glow-cyan)";
                    }
                    
                    if (gameState.activeStruckNotes.length === 3) {
                        gameState.activeNodes += 3;
                        const syncPct = Math.round((gameState.currentTriadIndex + 1) * 25);
                        document.getElementById('metric-sync').innerText = `${syncPct}%`;
                        
                        const poly = document.getElementById(triad.polyId);
                        if (poly) {
                            poly.setAttribute('fill', triad.color + '33');
                            poly.setAttribute('stroke', triad.color);
                            poly.setAttribute('filter', 'url(#glow-cyan)');
                        }
                        
                        showNotification("TRIAD HARMONIZED!", triad.color);
                        
                        // Sparkles
                        const tipPos = new THREE.Vector3();
                        petal.getWorldPosition(tipPos);
                        triggerSparkExplosion(tipPos, petal.userData.frequency);
                        
                        gameState.currentTriadIndex++;
                        
                        setTimeout(() => {
                            loadCurrentTriad();
                        }, 1800);
                    }
                }
            } else {
                // Wrong note reset
                showNotification("DESYNCED!", "#ef4444");
                
                triad.notes.forEach(nIdx => {
                    const p = petalsArray.find(pet => pet.userData.noteIndex === nIdx);
                    if (p) p.material.emissiveIntensity = p.userData.originalEmissive;
                });
                
                triad.nodes.forEach(n => {
                    const circle = document.getElementById(n);
                    if (circle) {
                        circle.setAttribute('fill', '#090d16');
                        circle.style.filter = '';
                    }
                });
                
                gameState.activeStruckNotes = [];
                
                setTimeout(() => {
                    playTriadChord(triad);
                }, 800);
            }
        }

        // --- 7. FIDGET SPINNER PHYSICS ---
        let isDragging = false;
        let autoSpin = false;
        let previousAngle = 0;
        let rotationVelocity = 0;
        
