                    <a href="plasmaxracer/index.html" download="plasma_xracer.html" class="btn btn-secondary">📥 Standalone HTML</a>
                </div>
            </div>

        </main>

        <!-- Referral Link -->
        <section class="invite-box">
            <h2 class="invite-title">🤝 Dragon 9 Co-op App Referral</h2>
            <p class="invite-desc">Generate a customized invitation code to invite a creative friend to download the off-grid creative toolkits.</p>
            <div class="invite-form">
                <input type="text" id="invite-friend-name" class="invite-input" placeholder="Enter friend's name (e.g. Conan)">
                <button onclick="generateAppReferral()" class="btn btn-primary invite-btn">Generate Invitation</button>
            </div>
        </section>
    </div>

    <script>
        const PAYPAL_USERNAME = "fluidmotion.tv@gmail.com"; 
        
        if (PAYPAL_USERNAME) {
            const donateBtn = document.getElementById('paypal-donate-btn');
            if (donateBtn) {
                const hintEl = document.querySelector('.donation-setup-hint');
                if (hintEl) {
                    hintEl.textContent = `Koha/Donation linked to: ${PAYPAL_USERNAME}`;
                }
                donateBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const amountStr = prompt("Thank you for supporting Dragon 9!\n\nEnter Koha/donation amount (USD):", "10.00");
                    if (amountStr === null) return;
                    const amount = parseFloat(amountStr);
                    if (isNaN(amount) || amount <= 0) {
                        alert("Please enter a valid amount.");
                        return;
                    }
                    const url = `https://www.paypal.com/cgi-bin/webscr?cmd=_xclick&business=${encodeURIComponent(PAYPAL_USERNAME)}&item_name=Koha%20for%20Dragon%209%20Development&currency_code=USD&amount=${amount.toFixed(2)}`;
                    window.open(url, '_blank');
                });
            }
        }

        function generateAppReferral() {
            const nameEl = document.getElementById('invite-friend-name');
            const name = nameEl.value.trim();
            if (!name) {
                alert("Please enter your friend's name to generate an invitation link!");
                return;
            }

            const refLink = `${window.location.origin}${window.location.pathname}?invite=${encodeURIComponent(name)}`;
            navigator.clipboard.writeText(refLink).then(() => {
                const sendEmail = confirm(`🤝 Invite link copied to clipboard for ${name}!\n\nWould you like to open your email client to send them the invite link?`);
                if (sendEmail) {
                    window.location.href = `mailto:?subject=${encodeURIComponent('Invitation to join Dragon 9 Co-op')}&body=${encodeURIComponent(`Hi ${name},\n\nI'd like to invite you to join the Dragon 9 Co-op and check out the off-grid sovereign developer tools:\n\n${refLink}\n\nCheers!`)}`;
                }
                nameEl.value = '';
            }).catch(err => {
                alert(`Referral link generated: ${refLink}`);
            });
        }
    </script>
    <script type="module" src="scripts/night_fish_assistant.js"></script>
</body>
