                (${plant.botanical})
            </span>
        </h4>
        <div class="remedy-section-title" style="font-family:'Share Tech Mono',monospace;font-size:0.65rem;color:var(--highlight);margin-top:10px;text-transform:uppercase;">Active Properties</div>
