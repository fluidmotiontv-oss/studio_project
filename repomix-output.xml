                const localLedger = JSON.parse(localStorage.getItem('d9_artist_local_ledger') || '{}');
                earnings = localLedger[artistName] || 0;
                const localWithdrawals = JSON.parse(localStorage.getItem('d9_artist_local_withdrawals') || '{}');
                withdrawals = localWithdrawals[artistName] || 0;
            }

            const balance = earnings - withdrawals;
