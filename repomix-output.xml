    <!-- Web Synth & THREE.js 3D Visualizer Menu Script -->
    <script type="module">
        import * as THREE from '../three.module.min.js';

        // --- ARTWORKS TEMPLATE SEEDS ---
        const artworkSeeds = [
            {
                title: "Lungz - ITZ so EASY",
                tag: "LUNGZ / COREY BOLLAND",
                desc: "Original synthesized sound wave architectures and custom analog visual sequences created by Corey Bolland (Lungz).",
                img: "../assets/projector/projector_cyan.png",
                format: "8K Digital MP4 Stream",
                core: "Lungz Core D9-25",
                parallax: "+0.6690 Parallax Offset",
                hash: "bf82d1c68f18d0999c0ac08a95f9c4ea821"
            },
            {
                title: "Freddy Worrell - Surreal Canvas",
                tag: "FREDDY WORRELL ART",
                desc: "A combination of physical oil canvas sketches and high-contrast digital overlays displaying surreal geometric space scopes.",
                img: "../assets/projector/projector_magenta.png",
                format: "Fine Art Digital Scan",
                core: "Worrell Canvas Node D9",
                parallax: "+1.4550 Parallax Offset",
                hash: "ea82d091f090b83cc61a0baf5074ad2b"
            },
            {
                title: "Conan Clarke - Tasman Echoes",
                tag: "CONAN CLARKE MUSIC",
                desc: "Collaborative acoustic waveforms and delayed minor pentatonic arpeggiator patterns mapped over trans-Tasman optical links.",
                img: "../assets/projector/projector_amber.png",
                format: "Acoustic WAV Channel",
                core: "Tasman Echo Grid D9-03",
                parallax: "-2.4042 Parallax Offset",
                hash: "fb39c1482de9f018a38a7c2e36b85ef37a"
            },
            {
                title: "Sovereign Whale Concept",
                tag: "3D Volumetric Lightfield",
                desc: "Reconstruction of cetacean migratory resonance channels in deep Pacific grids. Created to capture biological signals inside spatial emulators.",
                img: "../assets/projector/projector_whale.png",
                format: "8K UHD Stereoscopic",
                core: "Pacific Hydro Grid V2",
                parallax: "+3.2204 Parallax Offset",
                hash: "ab536e2f18f1a28a38a7c2e36b85ef3"
            },
            {
                title: "Octagon Chronometer",
                tag: "Futuristic Time Vector",
                desc: "Visual representation of the 360 harmonic node configuration. Calibrates local Wellington and Auckland phase alignment loops into dynamic clock faces.",
                img: "../assets/projector/projector_clock.png",
                format: "Vector Map (SVG)",
                core: "360-Station Clock Grid",
                parallax: "0.0000 Zero Drift Phase",
                hash: "c982ef0411ab1889b4f9810acb7762a4d"
            },
            {
                title: "Kite Rider Interface",
                tag: "Tactical Console HUD",
                desc: "A dashboard screen built for monitoring secure channel bandwidth and logging transceiver packets on high-altitude relays.",
                img: "../assets/projector/projector_shield.png",
                format: "Tactical Display Canvas",
                core: "Shield Radar Array D9",
                parallax: "+0.1554 Parallax Offset",
                hash: "827da4b892a01ce9047bf8efd999ca30"
            }
        ];

        // BUILD 54 PIECE CAROUSEL DATABASE
        const carouselItems = [];
        for (let i = 0; i < 54; i++) {
            const seed = artworkSeeds[i % artworkSeeds.length];
            carouselItems.push({
                title: `FMTV Piece #${String(i + 1).padStart(2, '0')}: ${seed.title}`,
                tag: seed.tag,
                desc: `Chronological music video anchor #${i + 1}. ` + seed.desc,
                img: seed.img,
                format: seed.format,
                core: `Node D9-${100 + i + 1}`,
                parallax: `${((i * 0.174 + 1.23) % 4).toFixed(4)} Parallax Offset`,
                hash: Array.from({length: 32}, () => Math.floor(Math.random() * 16).toString(16)).join('')
            });
        }

        // Expose lightbox trigger functions to window
        window.openLightbox = function(index) {
            const art = carouselItems[index];
            if (!art) return;
            
            document.getElementById('modalImage').src = art.img;
            document.getElementById('modalTitle').innerText = art.title;
            document.getElementById('modalTag').innerText = art.tag.toUpperCase();
            document.getElementById('modalDesc').innerText = art.desc;
            
            document.getElementById('telemetryFormat').innerText = art.format;
            document.getElementById('telemetryCore').innerText = art.core;
            document.getElementById('telemetryParallax').innerText = art.parallax;
            document.getElementById('telemetryHash').innerText = "SHA-D9:" + art.hash.substring(0, 16) + "...";
            
            document.getElementById('artModal').classList.add('open');
