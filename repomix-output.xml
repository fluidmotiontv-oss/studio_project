            box-shadow: 0 0 20px var(--cyan);
        }

        /* Mobile buttons overlay */
        .mobile-controls {
            display: none;
            position: absolute;
            bottom: 30px;
            left: 0;
            width: 100%;
            height: 80px;
            z-index: 1000;
            pointer-events: none;
