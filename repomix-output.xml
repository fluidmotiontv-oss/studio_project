            alert("🔗 Referral Link Copied!\n\nPromotion bonus of +1.5 Listening Hours and +0.2x Boost Multiplier credited to your ledger.");
        }

        function openInviteCollaborator() {
            const name = prompt("🤝 Invite a Collaborator:\n\nEnter your friend's name (e.g. Dawn Rainstar Milazzo):", "Dawn Rainstar Milazzo");
            if (!name || !name.trim()) return;

            const refLink = `${window.location.origin}${window.location.pathname}?collab=${encodeURIComponent(name.trim())}`;
            const message = `Hi ${name.trim()}! I'm compiling our music release into a portable offline HTML vault using the Dragon 9 Sovereign Album Builder. Would you like to collaborate on this with me? Check it out here: ${refLink}`;

            navigator.clipboard.writeText(message);

