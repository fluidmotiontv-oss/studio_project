        function update3DActiveNode() {
            clickableNodes.forEach((node, idx) => {
                if (idx === currentTrackIdx) {
                    node.scale.set(1.5, 1.5, 1.5);
                    node.material.emissiveIntensity = 0.8;
                    if (node.userData.aura) {
                        node.userData.aura.scale.set(1.3, 1.3, 1.3);
                        node.userData.aura.material.opacity = 0.9;
                    }
                } else {
                    node.scale.set(1.0, 1.0, 1.0);
                    node.material.emissiveIntensity = 0.2;
                    if (node.userData.aura) {
                        node.userData.aura.scale.set(1.0, 1.0, 1.0);
                        node.userData.aura.material.opacity = 0.3;
                    }
                }
            });
        }

        function animate() {
            requestAnimationFrame(animate);

            if (!isDragging) {
                sceneGroup.rotation.y += 0.003;
                sceneGroup.rotation.x += 0.001;
            }

            let scaleVal = 1.0;
            
            if (analyser && isPlaying) {
                const bufferLength = analyser.frequencyBinCount;
                const dataArray = new Uint8Array(bufferLength);
                analyser.getByteFrequencyData(dataArray);

                let sum = 0;
                for (let i = 0; i < bufferLength; i++) {
                    sum += dataArray[i];
                }
                const avg = sum / bufferLength;
                scaleVal = 1.0 + (avg / 256.0) * 0.45;
                
                const track = playlist[currentTrackIdx];
                coreWire.material.color.setHex(track.color);
                coreWire.material.opacity = 0.1 + (avg / 256.0) * 0.4;
            } else {
                coreWire.material.color.setHex(0x555566);
                coreWire.material.opacity = 0.1;
            }

            if (coreMesh) {
                coreMesh.scale.set(scaleVal, scaleVal, scaleVal);
            }
            if (coreWire) {
                coreWire.scale.set(scaleVal * 1.01, scaleVal * 1.01, scaleVal * 1.01);
            }

            const time = performance.now() * 0.003;
            clickableNodes.forEach((node, idx) => {
                if (node.userData.aura) {
                    const waveVal = Math.sin(time + idx * 2) * 0.1 + 1.0;
                    const baseScale = (idx === currentTrackIdx) ? 1.3 : 1.0;
                    node.userData.aura.scale.set(baseScale * waveVal, baseScale * waveVal, baseScale * waveVal);
                    node.userData.aura.lookAt(camera.position);
                }
            });

            renderer.render(scene, camera);
        }


        // --- THREE.JS WebGL 3D INFINITY FLOW CAROUSEL (54 PIECES) ---
        let cScene, cCamera, cRenderer, cGroup;
