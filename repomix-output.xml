                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 18
                    }).addTo(map);

                    marker = L.marker([currentLat, currentLon]).addTo(map);
                } else {
                    renderMapFallback();
                }
            } catch(e) {
                renderMapFallback();
            }
        }

        function updateMapPosition() {
            if (map) {
                map.setView([currentLat, currentLon], 11);
                if (marker) {
                    marker.setLatLng([currentLat, currentLon]);
                }
            } else {
                renderMapFallback();
            }
        }

        function renderMapFallback() {
            document.getElementById('map').innerHTML = `
                <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; font-family:'Share Tech Mono',monospace; color:var(--text-muted); font-size:0.75rem; text-align:center; padding:20px; background:rgba(0,0,0,0.5); gap:8px;">
                    <span style="font-size:1.5rem;">🛰️</span>
                    <span>LEAFLET MAP OFFLINE<br>COORDINATES LOCKED: ${currentLat.toFixed(4)}°S, ${currentLon.toFixed(4)}°E</span>
                </div>
            `;
        }

        // Dropdown selection preset
        function applyPreset(val) {
            const row = document.getElementById('customCoordsRow');
            if (val === 'custom') {
                row.style.display = 'inline-flex';
            } else {
                row.style.display = 'none';
                const preset = PRESETS[val];
                currentLat = preset.lat;
                currentLon = preset.lon;
                activeNodeName = `${preset.name.toUpperCase()} NODE`;
                document.getElementById('location-label').textContent = activeNodeName;
                fetchMarineData();
                updateMapPosition();
            }
        }

        function applyCustomCoords() {
            currentLat = parseFloat(document.getElementById('customLat').value);
            currentLon = parseFloat(document.getElementById('customLon').value);
            activeNodeName = "CUSTOM COORD";
            document.getElementById('location-label').textContent = activeNodeName;
            fetchMarineData();
            updateMapPosition();
        }

        // HTML5 Geolocation API
        function requestGeolocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(position => {
                    currentLat = position.coords.latitude;
                    currentLon = position.coords.longitude;
                    activeNodeName = "LOCAL DETECTED NODE";
                    document.getElementById('location-label').textContent = activeNodeName;
                    
                    document.getElementById('presetSelect').value = 'custom';
                    document.getElementById('customCoordsRow').style.display = 'inline-flex';
                    document.getElementById('customLat').value = currentLat.toFixed(4);
                    document.getElementById('customLon').value = currentLon.toFixed(4);

                    fetchMarineData();
                    updateMapPosition();
                }, err => {
                    alert("📍 Geolocation permission denied or unavailable.");
                });
            } else {
                alert("📍 Geolocation not supported by this browser.");
            }
        }

        // Tide static Wave Canvas Drawer
        function drawTideWave(waterHeightPercent = 0.5) {
            const canvas = document.getElementById('tideCanvas');
            const ctx = canvas.getContext('2d');
            const w = canvas.width = canvas.offsetWidth;
            const h = canvas.height = canvas.offsetHeight;

            ctx.clearRect(0, 0, w, h);

            // Grid guidelines
            ctx.strokeStyle = 'rgba(255,255,255,0.03)';
            ctx.lineWidth = 1;
            for(let x=0; x<w; x+=30) {
                ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
            }

            // Draw wave curve
            ctx.beginPath();
            ctx.strokeStyle = 'rgba(0, 229, 255, 0.4)';
            ctx.lineWidth = 3;
            for(let x=0; x<=w; x++) {
                const y = h/2 + Math.sin(x/w * Math.PI * 2) * (h/3);
                if (x === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.stroke();

            // Water level marker
            const currentY = h - (waterHeightPercent * h);
            ctx.beginPath();
            ctx.strokeStyle = 'var(--accent)';
            ctx.lineWidth = 1.5;
            ctx.setLineDash([5, 5]);
            ctx.moveTo(0, currentY);
            ctx.lineTo(w, currentY);
            ctx.stroke();
            ctx.setLineDash([]);

            // Dot marker
            const dotX = w / 2;
            const dotY = h/2 + Math.sin(dotX/w * Math.PI * 2) * (h/3);
            ctx.beginPath();
            ctx.arc(dotX, dotY, 6, 0, Math.PI*2);
            ctx.fillStyle = 'var(--accent)';
            ctx.fill();
        }

        // --- Swell Wave Simulator Canvas Animation Loop ---
        let simHeight = 1.5; // swell height in meters
        let simPeriod = 10;   // swell period in seconds
        let simOffset = 0;
        let isSimLiveSynced = true;

        function toggleSimMode() {
            isSimLiveSynced = !isSimLiveSynced;
            const btn = document.getElementById('simModeBtn');
            if (isSimLiveSynced) {
                btn.textContent = "Live Sync";
                btn.style.borderColor = "var(--accent)";
                btn.style.color = "var(--accent)";
                syncSimSlidersToTelemetry();
            } else {
                btn.textContent = "Manual Sandbox";
                btn.style.borderColor = "var(--highlight)";
                btn.style.color = "var(--highlight)";
            }
        }

        function adjustSimHeight(val) {
            if (isSimLiveSynced) toggleSimMode();
            simHeight = parseFloat(val);
            document.getElementById('val-sim-height').textContent = `${simHeight.toFixed(1)}m`;
        }

        function adjustSimPeriod(val) {
            if (isSimLiveSynced) toggleSimMode();
            simPeriod = parseInt(val);
            document.getElementById('val-sim-period').textContent = `${simPeriod}s`;
        }

        function syncSimSlidersToTelemetry() {
            if (isSimLiveSynced) {
                document.getElementById('slider-sim-height').value = simHeight;
                document.getElementById('slider-sim-period').value = simPeriod;
                document.getElementById('val-sim-height').textContent = `${simHeight.toFixed(1)}m`;
                document.getElementById('val-sim-period').textContent = `${simPeriod}s`;
            }
        }

        function animateWaveSimulator() {
            const canvas = document.getElementById('simCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const w = canvas.width = canvas.offsetWidth;
            const h = canvas.height = canvas.offsetHeight;

            ctx.clearRect(0,0,w,h);

            // Draw wave simulator lines (layered waves representing ocean harmonics)
            ctx.lineWidth = 2.5;

            // Swell speed based on Swell Period (higher period = slower, more powerful waves)
            const speed = 0.15 / simPeriod;
            simOffset += speed;

            // Wave height amplitude scaling
            const amplitude = Math.min(h/3, (simHeight / 6.0) * (h/2));

            // Layer 1: Back Wave (slightly offset, darker blue)
            ctx.beginPath();
            ctx.strokeStyle = 'rgba(0, 110, 255, 0.25)';
            for (let x = 0; x <= w; x++) {
                const angle = (x / w * Math.PI * 3) - simOffset * 0.8;
                const y = h/2 + Math.sin(angle) * amplitude * 0.7 + 10;
                if (x === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.stroke();

            // Layer 2: Main Wave (glowing cyan)
            ctx.beginPath();
            ctx.strokeStyle = 'var(--highlight)';
            for (let x = 0; x <= w; x++) {
                const angle = (x / w * Math.PI * 2.5) - simOffset;
                const y = h/2 + Math.sin(angle) * amplitude;
                if (x === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.stroke();

            // Draw status overlay on sim canvas
            ctx.font = "9px Share Tech Mono, monospace";
            ctx.fillStyle = "rgba(255,255,255,0.4)";
            ctx.fillText(`INTERVAL SPEED: ${speed.toFixed(5)} RAD/SEC`, 15, h - 15);
            ctx.fillText(`WAVELENGTH INDEX: ${simPeriod} SEC`, 15, h - 28);

            requestAnimationFrame(animateWaveSimulator);
        }

        // Sync local marine API telemetry data
        function fetchMarineData() {
            const weatherUrl = `https://api.open-meteo.com/v1/forecast?latitude=${currentLat}&longitude=${currentLon}&daily=temperature_2m_max,temperature_2m_min,weathercode&timezone=auto`;
            const marineUrl = `https://marine-api.open-meteo.com/v1/marine?latitude=${currentLat}&longitude=${currentLon}&current=wave_height,wave_period,wave_direction,wind_wave_height&daily=wave_height_max&timezone=auto`;
            
            document.getElementById('stat-water-level').textContent = "Syncing...";

            fetch(weatherUrl)
                .then(res => res.json())
                .then(data => {
                    renderForecast(data.daily);
                })
                .catch(() => {
                    renderOfflineForecast();
                });

            fetch(marineUrl)
                .then(res => res.json())
                .then(data => {
                    if (data.current) {
                        const swellH = data.current.wave_height || 1.4;
                        const swellP = data.current.wave_period || 9.0;
                        const swellDir = data.current.wave_direction || 240;

                        document.getElementById('stat-swell-height').textContent = `${swellH.toFixed(1)} m`;
                        document.getElementById('stat-swell-period').textContent = `Period: ${swellP.toFixed(1)}s`;
                        document.getElementById('swellArrow').style.transform = `rotate(${swellDir}deg)`;

                        const wSpeed = Math.abs(Math.sin(Date.now() / 120000)) * 25 + 6;
                        const wDir = (swellDir + 180) % 360;
                        
                        document.getElementById('stat-wind-speed').textContent = `${wSpeed.toFixed(1)} km/h`;
                        document.getElementById('stat-wind-gusts').textContent = `Gusts: ${(wSpeed * 1.3).toFixed(1)}`;
                        document.getElementById('windArrow').style.transform = `rotate(${wDir}deg)`;

                        // Calculate tide height from sine wave
                        const tideVal = Math.sin(Date.now() / 3600000) * 1.5 + 2.0;
                        document.getElementById('stat-water-level').textContent = `${tideVal.toFixed(2)} m`;
                        document.getElementById('stat-high-tide').textContent = "3.50 m (12:45)";
                        document.getElementById('stat-low-tide').textContent = "0.50 m (06:30)";
                        
                        drawTideWave((tideVal - 0.5) / 3.0);

                        // If Live Synced, update Swell Wave Simulator values automatically
                        if (isSimLiveSynced) {
                            simHeight = swellH;
                            simPeriod = Math.round(swellP);
                            syncSimSlidersToTelemetry();
                        }
                    }
                })
                .catch(() => {
                    renderOfflineMarine();
                });
        }

        // Offline marine calculations fallback
        function renderOfflineMarine() {
            const h = Math.abs(Math.sin(Date.now() / 600000)) * 2.0 + 0.6;
            const p = Math.abs(Math.cos(Date.now() / 600000)) * 6.0 + 7.0;
            const wSpeed = Math.abs(Math.sin(Date.now() / 400000)) * 22 + 4;
            const dir = Math.floor(Math.abs(Math.sin(Date.now() / 1200000)) * 360);

            document.getElementById('stat-swell-height').textContent = `${h.toFixed(1)} m`;
            document.getElementById('stat-swell-period').textContent = `Period: ${p.toFixed(1)}s`;
            document.getElementById('stat-wind-speed').textContent = `${wSpeed.toFixed(1)} km/h`;
            document.getElementById('stat-wind-gusts').textContent = `Gusts: ${(wSpeed * 1.3).toFixed(1)}`;

            document.getElementById('swellArrow').style.transform = `rotate(${dir}deg)`;
            document.getElementById('windArrow').style.transform = `rotate(${(dir + 180)%360}deg)`;

            const waterHeight = Math.sin(Date.now() / 3600000) * 1.2 + 1.8;
            document.getElementById('stat-water-level').textContent = `${waterHeight.toFixed(2)} m (Offline)`;
            document.getElementById('stat-high-tide').textContent = "3.00 m (Simulated)";
            document.getElementById('stat-low-tide').textContent = "0.60 m (Simulated)";

            drawTideWave((waterHeight - 0.6) / 2.4);

            if (isSimLiveSynced) {
                simHeight = h;
                simPeriod = Math.round(p);
                syncSimSlidersToTelemetry();
            }
        }

        function renderForecast(daily) {
            const box = document.getElementById('weather-forecast-box');
            box.innerHTML = '';
            for(let i=0; i<3; i++) {
                const max = daily.temperature_2m_max[i];
                const min = daily.temperature_2m_min[i];
                const date = new Date(daily.time[i]).toLocaleDateString('en-NZ', { weekday: 'short' });

                const card = document.createElement('div');
                card.className = 'weather-day-card';
                card.innerHTML = `
                    <div class="weather-day-title">${date}</div>
                    <div style="font-size:1.3rem; margin:5px 0;">🌤️</div>
                    <div class="weather-temp">${max.toFixed(0)}° / ${min.toFixed(0)}°</div>
                `;
                box.appendChild(card);
            }
        }

        function renderOfflineForecast() {
            const box = document.getElementById('weather-forecast-box');
            box.innerHTML = '';
            const weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
            const todayIdx = new Date().getDay();

            for(let i=0; i<3; i++) {
                const date = weekdays[(todayIdx + i) % 7];
                const card = document.createElement('div');
                card.className = 'weather-day-card';
                card.innerHTML = `
                    <div class="weather-day-title">${date} (OFFLINE)</div>
                    <div style="font-size:1.3rem; margin:5px 0;">🌤️</div>
                    <div class="weather-temp">19° / 12°</div>
                `;
                box.appendChild(card);
            }
        }

        // On window load
        initMap();
        fetchMarineData();
        animateWaveSimulator();
    </script>
</body>
</html>
</file>

<file path="apps/dragon9/tuner/index.html">
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dragon 9 | Synesthetic Tuner</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #030712;
            --panel-bg: rgba(17, 24, 39, 0.45);
            --border-color: rgba(255, 255, 255, 0.08);
            --accent-cyan: #00e5ff;
            --accent-gold: #d4af37;
            --accent-glow-cyan: rgba(0, 229, 255, 0.25);
            --accent-glow-gold: rgba(212, 175, 55, 0.2);
            --accent-green: #00ff66;
            --text-main: #f4e4bc;
            --text-muted: #6b7280;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow-x: hidden;
            position: relative;
        }

        /* Animated organic background blobs */
        .ambient-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -2;
            overflow: hidden;
            filter: blur(120px);
            pointer-events: none;
        }

        .blob {
            position: absolute;
            border-radius: 50%;
            opacity: 0.25;
            animation: drift 25s infinite ease-in-out alternate;
        }

        .blob-cyan {
            width: 50vw;
            height: 50vw;
            background: linear-gradient(135deg, var(--accent-cyan), #002266);
            top: -10%;
            left: -10%;
        }

        .blob-gold {
            width: 45vw;
            height: 45vw;
            background: linear-gradient(135deg, var(--accent-gold), #4a1d96);
            bottom: -10%;
            right: -10%;
            animation-delay: -5s;
        }

        @keyframes drift {
            0% { transform: translate(0, 0) scale(1) rotate(0deg); }
            100% { transform: translate(80px, -50px) scale(1.15) rotate(60deg); }
        }

        /* Subtle cybernetic scanline grid */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: 
                linear-gradient(rgba(255, 255, 255, 0.01) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.01) 1px, transparent 1px);
            background-size: 25px 25px;
            z-index: -1;
            pointer-events: none;
        }

        /* Navigation Header */
        header {
            width: 100%;
            max-width: 1200px;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 10;
        }

        .nav-nexus {
            color: var(--accent-cyan);
            text-decoration: none;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            letter-spacing: 2px;
            padding: 10px 20px;
            border: 1px solid rgba(0, 229, 255, 0.2);
            border-radius: 8px;
            background: rgba(17, 24, 39, 0.4);
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .nav-nexus:hover {
            background: rgba(0, 229, 255, 0.12);
            box-shadow: 0 0 15px var(--accent-glow-cyan);
            border-color: var(--accent-cyan);
        }

        .logo-area {
            text-align: right;
        }

        .logo-area h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.4rem;
            font-weight: 900;
            letter-spacing: 3px;
            color: var(--accent-gold);
            text-shadow: 0 0 10px var(--accent-glow-gold);
        }

        .logo-area span {
            font-size: 0.65rem;
            color: var(--text-muted);
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        /* Main Workspace Container */
        .workspace {
            width: 100%;
            max-width: 1100px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            padding: 20px;
            z-index: 10;
        }

        @media (max-width: 768px) {
            .workspace {
                grid-template-columns: 1fr;
            }
        }

        /* Glassmorphic Panel Base */
        .glass-panel {
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 30px;
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), inset 0 0 20px rgba(255, 255, 255, 0.01);
            display: flex;
            flex-direction: column;
            gap: 24px;
            transition: border-color 0.4s ease, box-shadow 0.4s ease;
        }

        .glass-panel:hover {
            border-color: rgba(255, 255, 255, 0.15);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5), inset 0 0 25px rgba(255, 255, 255, 0.02);
        }

        .panel-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--accent-gold);
            border-left: 3px solid var(--accent-gold);
            padding-left: 12px;
            margin-bottom: 5px;
        }

        /* --- TUNER READER STYLES --- */
        .tuner-display-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            margin: 10px 0;
        }

        .tuner-dial-canvas {
            width: 100%;
            max-width: 320px;
            aspect-ratio: 1.6;
        }

        .pitch-readout {
            text-align: center;
            margin-top: -15px;
            z-index: 2;
        }

        .current-note {
            font-family: 'Orbitron', sans-serif;
            font-size: 4rem;
            font-weight: 900;
            color: #fff;
            text-shadow: 0 0 20px rgba(255, 255, 255, 0.15);
            line-height: 1;
        }

        .current-note.in-tune {
            color: var(--accent-green);
            text-shadow: 0 0 25px rgba(0, 255, 102, 0.4);
        }

        .freq-hz {
            font-family: 'Share Tech Mono', monospace;
            font-size: 1.3rem;
            color: var(--accent-cyan);
            margin: 5px 0;
        }

        .cents-dev {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            font-weight: 700;
            color: var(--text-muted);
        }

        .cents-dev.sharp { color: #ff3366; }
        .cents-dev.flat { color: #ffaa00; }
        .cents-dev.in-tune { color: var(--accent-green); }

        .btn-action {
            width: 100%;
            background: linear-gradient(135deg, var(--accent-cyan), #0066cc);
            color: #000;
            border: none;
            border-radius: 12px;
            padding: 16px;
            font-family: 'Orbitron', sans-serif;
            font-weight: 700;
            font-size: 0.95rem;
            letter-spacing: 2px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 4px 15px rgba(0, 229, 255, 0.3);
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 229, 255, 0.5);
            filter: brightness(1.1);
        }

        .btn-action.active {
            background: linear-gradient(135deg, #ff3366, #aa0033);
            color: #fff;
            box-shadow: 0 4px 15px rgba(255, 51, 102, 0.3);
        }

        .btn-action.active:hover {
            box-shadow: 0 8px 25px rgba(255, 51, 102, 0.5);
        }

        /* --- FREQUENCY GENERATOR STYLES --- */
        .controls-grid {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .control-row {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .control-label {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.7rem;
            letter-spacing: 1.5px;
            color: var(--accent-gold);
            text-transform: uppercase;
            opacity: 0.85;
        }

        /* Preset String Buttons */
        .string-presets {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 8px;
        }

        .btn-preset {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 10px 5px;
            border-radius: 8px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .btn-preset:hover {
            background: rgba(212, 175, 55, 0.1);
            border-color: var(--accent-gold);
            color: var(--accent-gold);
        }

        .btn-preset.active {
            background: rgba(212, 175, 55, 0.2);
            border-color: var(--accent-gold);
            color: var(--accent-gold);
            box-shadow: 0 0 10px var(--accent-glow-gold);
        }

        /* Waveform Selectors */
        .waveform-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
        }

        .btn-wave {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 10px 5px;
            border-radius: 8px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.65rem;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.25s ease;
            text-transform: uppercase;
        }

        .btn-wave:hover {
            background: rgba(0, 229, 255, 0.1);
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
        }

        .btn-wave.active {
            background: rgba(0, 229, 255, 0.15);
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
            box-shadow: 0 0 10px var(--accent-glow-cyan);
        }

        /* Range Sliders */
        .slider-wrapper {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .custom-slider {
            flex-grow: 1;
            -webkit-appearance: none;
