        // --- WEB AUDIO VOICES ---
        function playSequencerTrack() {
            const notes = [130.81, 146.83, 164.81, 196.00, 220.00, 261.63, 293.66, 329.63];
            let step = 0;

            const interval = setInterval(() => {
                if (!isPlaying || !audioCtx) return;
                const now = audioCtx.currentTime;
                
                const oscBass = audioCtx.createOscillator();
                const gainBass = audioCtx.createGain();
                oscBass.frequency.setValueAtTime(65.41, now);
                oscBass.type = 'triangle';
                gainBass.gain.setValueAtTime(0.12, now);
                gainBass.gain.exponentialRampToValueAtTime(0.0001, now + 0.15);
                oscBass.connect(gainBass);
                gainBass.connect(analyser);
                oscBass.start(now);
                oscBass.stop(now + 0.18);

                if (step % 2 === 0) {
                    const oscBell = audioCtx.createOscillator();
                    const gainBell = audioCtx.createGain();
                    const freq = notes[(step * 3) % notes.length];
                    oscBell.frequency.setValueAtTime(freq * 2, now);
                    oscBell.type = 'sine';
                    gainBell.gain.setValueAtTime(0.04, now);
                    gainBell.gain.exponentialRampToValueAtTime(0.0001, now + 0.3);
                    oscBell.connect(gainBell);
                    gainBell.connect(analyser);
                    oscBell.start(now);
                    oscBell.stop(now + 0.35);
                }
                
                step = (step + 1) % 8;
            }, 220);

            synthIntervals.push(interval);
        }

        function playPadTrack() {
            const chords = [
                [130.81, 164.81, 196.00, 246.94],
                [146.83, 174.61, 220.00, 261.63]
            ];
            let chordIdx = 0;

            const triggerChord = () => {
                if (!isPlaying || !audioCtx) return;
                const now = audioCtx.currentTime;
                const activeChord = chords[chordIdx];

                activeChord.forEach(freq => {
                    const osc = audioCtx.createOscillator();
                    const filter = audioCtx.createBiquadFilter();
                    const gain = audioCtx.createGain();
                    
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(freq, now);
                    
                    filter.type = 'lowpass';
                    filter.Q.setValueAtTime(4, now);
                    filter.frequency.setValueAtTime(250, now);
                    filter.frequency.exponentialRampToValueAtTime(1100, now + 1.2);
                    filter.frequency.exponentialRampToValueAtTime(180, now + 2.8);
                    
                    gain.gain.setValueAtTime(0.0, now);
                    gain.gain.linearRampToValueAtTime(0.03, now + 0.8);
                    gain.gain.exponentialRampToValueAtTime(0.0001, now + 2.9);
                    
                    osc.connect(filter);
                    filter.connect(gain);
                    gain.connect(analyser);
                    
                    osc.start(now);
                    osc.stop(now + 3.0);
                });

                chordIdx = (chordIdx + 1) % chords.length;
            };

            triggerChord();
            const interval = setInterval(triggerChord, 3000);
            synthIntervals.push(interval);
        }

        function playArpeggioTrack() {
            const arpeggio = [220.00, 261.63, 293.66, 329.63, 392.00, 440.00];
            let step = 0;

            const interval = setInterval(() => {
                if (!isPlaying || !audioCtx) return;
                const now = audioCtx.currentTime;

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                const panner = audioCtx.createStereoPanner ? audioCtx.createStereoPanner() : null;

                const freq = arpeggio[step % arpeggio.length];
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(freq, now);

                gain.gain.setValueAtTime(0.05, now);
                gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.4);

                if (panner) {
                    const panVal = Math.sin(step * 0.8);
                    panner.pan.setValueAtTime(panVal, now);
                    osc.connect(panner);
                    panner.connect(analyser);
                } else {
                    osc.connect(gain);
                    gain.connect(analyser);
                }

                osc.start(now);
                osc.stop(now + 0.45);

                step++;
            }, 180);

            synthIntervals.push(interval);
        }

