    <div class="screen-overlay hidden" id="gameOverScreen">
        <div class="panel-box" style="border-color: var(--accent-purple); box-shadow: 0 15px 40px rgba(0,0,0,0.8), 0 0 25px rgba(189, 0, 255, 0.3);">
            <h2>POD <span>DISRUPTED</span></h2>
