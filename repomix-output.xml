            box-shadow: 0 15px 40px rgba(0,0,0,0.7);
        }

        /* Ambient rotating water wheel */
        .wheel-container {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            width: 220px; height: 220px;
            opacity: 0.05;
