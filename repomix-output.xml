            color: var(--text-muted);
            margin-bottom: 8px;
        }

        .footer-logo span {
            color: var(--accent-sage);
        }

        .footer-note {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.65rem;
            color: rgba(255, 255, 255, 0.3);
            letter-spacing: 1px;
        }
    </style>
</head>
