            border-radius: 50%;
            background: rgba(10, 10, 15, 0.8);
            border: 2px solid var(--border-color);
            color: #fff;
            font-family: 'Orbitron', sans-serif;
            font-size: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            user-select: none;
            transition: all 0.2s;
            box-shadow: 0 0 10px rgba(0,0,0,0.5);
        }

        .control-pad-btn:active {
            border-color: var(--accent-cyan);
            background: var(--accent-cyan);
            color: #000;
            box-shadow: 0 0 15px var(--accent-glow);
            transform: scale(0.92);
        }

        .control-pad-btn.boost-btn {
            border-color: rgba(189, 0, 255, 0.4);
        }

        .control-pad-btn.boost-btn:active {
            border-color: var(--accent-purple);
            background: var(--accent-purple);
            color: #fff;
            box-shadow: 0 0 15px rgba(189, 0, 255, 0.6);
        }

        /* Display on Mobile devices */
        @media (pointer: coarse) {
            .touch-controls {
                display: flex;
            }
        }

        /* Screen Overlays */
        .screen-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 100;
            background: rgba(2, 2, 5, 0.85);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 20px;
            padding: 30px;
            text-align: center;
            transition: opacity 0.5s;
        }

        .screen-overlay.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .panel-box {
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 18px;
            padding: 40px;
            max-width: 500px;
            width: 100%;
            box-shadow: 0 15px 40px rgba(0,0,0,0.8), 0 0 25px var(--accent-glow);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
        }

        .panel-box h2 {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.8rem;
            font-weight: 900;
            letter-spacing: 3px;
            color: #fff;
        }

        .panel-box h2 span {
            color: var(--accent-cyan);
            text-shadow: 0 0 12px var(--accent-glow);
        }

        .panel-box p {
            font-size: 0.85rem;
            color: var(--text-main);
            opacity: 0.8;
            line-height: 1.5;
        }

        .nav-btn-link {
            text-decoration: none;
            color: var(--accent-cyan);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 6px 12px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.65rem;
            transition: all 0.3s;
            pointer-events: auto;
        }

        .nav-btn-link:hover {
            border-color: var(--accent-cyan);
            background: rgba(0, 229, 255, 0.08);
            box-shadow: 0 0 8px var(--accent-glow);
        }

        .action-btn {
            background: rgba(0, 229, 255, 0.08);
            border: 1.5px solid var(--accent-cyan);
            color: #fff;
            padding: 12px 28px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            font-weight: 700;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .action-btn:hover {
            background: var(--accent-cyan);
            color: #000;
            box-shadow: 0 0 20px var(--accent-glow);
            transform: translateY(-2px);
        }

        .controls-hint {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.65rem;
            color: var(--text-muted);
            margin-top: 10px;
        }
    </style>

</head>
<body>

    <!-- WebGL Render Canvas -->
    <canvas id="gameCanvas"></canvas>

    <!-- Welcome / Start Overlay -->
    <div class="screen-overlay" id="startScreen">
        <div class="panel-box">
            <h2>PLASMA <span>XRACER</span></h2>
            <p>Pilot a high-voltage Energy Pod inside an electromagnetic plasma tube. Collect Solfeggio gold crystals to align stability, steer through glowing nodes, and avoid disruption net barriers!</p>
            <button class="action-btn" id="btn-start">⚡ Launch Pod</button>
