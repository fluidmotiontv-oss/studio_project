/* Harmonic Home Designer Stylesheet */

:root {
    --bg-dark: #0f1210;
    --bg-main: #131915;
    --card-bg: rgba(26, 34, 29, 0.7);
    --card-border: rgba(255, 255, 255, 0.05);
    
    --accent-sage: #8da392;
    --accent-sage-glow: rgba(141, 163, 146, 0.2);
    --accent-clay: #c88a75;
    --accent-clay-glow: rgba(200, 138, 117, 0.2);
    --accent-sand: #dfd5c6;
    
    --text-main: #f2ebe1;
    --text-muted: #9fa8a0;
    
    --element-water: #4c8fa6;
    --element-wood: #5d8f6d;
    --element-fire: #c55d49;
    --element-earth: #bca06c;
    --element-metal: #a8a8aa;
    
    --alert: #e26d5c;
    --success: #8da392;
    --font-heading: 'Comfortaa', sans-serif;
    --font-body: 'Outfit', sans-serif;
    --font-mono: 'Share Tech Mono', monospace;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: var(--bg-dark);
    color: var(--text-main);
    font-family: var(--font-body);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    position: relative;
}

/* Background grid overlay */
body::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: 
        linear-gradient(rgba(141, 163, 146, 0.012) 1px, transparent 1px),
        linear-gradient(90deg, rgba(141, 163, 146, 0.012) 1px, transparent 1px);
    background-size: 30px 30px;
    z-index: 0;
    pointer-events: none;
}

/* Top header bar */
header {
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    background: rgba(15, 18, 16, 0.8);
    backdrop-filter: blur(10px);
    z-index: 100;
    position: sticky;
    top: 0;
}

.logo {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--text-main);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
}

.logo span {
    color: var(--accent-sage);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 15px;
}

.nav-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 8px 16px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.3s ease;
    text-transform: uppercase;
}

.nav-btn:hover, .nav-btn.active {
    color: var(--accent-sand);
    border-color: var(--accent-sage);
    box-shadow: 0 0 12px var(--accent-sage-glow);
}

/* Core Dashboard Layout */
.dashboard-layout {
    flex: 1;
    display: grid;
    grid-template-columns: 320px 1fr 340px;
    height: calc(100vh - 71px);
    position: relative;
    z-index: 2;
}

@media (max-width: 1200px) {
    .dashboard-layout {
        grid-template-columns: 280px 1fr;
    }
    .right-sidebar {
        display: none; /* Accessible via toggle modal on smaller screens */
    }
}

/* Sidebar Styling */
.sidebar {
    background: rgba(16, 21, 18, 0.85);
    border-right: 1px solid var(--card-border);
    backdrop-filter: blur(12px);
    padding: 24px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
    z-index: 10;
}

.right-sidebar {
    border-right: none;
    border-left: 1px solid var(--card-border);
}

.section-title {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--accent-sand);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    border-left: 2px solid var(--accent-sage);
    padding-left: 8px;
    margin-bottom: 12px;
}

/* Tool Buttons / Palette */
.tool-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

.tool-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 12px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
}

.tool-card:hover {
    background: rgba(141, 163, 146, 0.05);
    border-color: var(--accent-sage);
    transform: translateY(-2px);
}

.tool-card.active {
    background: rgba(141, 163, 146, 0.15);
    border-color: var(--accent-sage);
    box-shadow: 0 0 10px var(--accent-sage-glow);
}

.tool-icon {
    font-size: 1.4rem;
}

.tool-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-main);
}

/* Material list */
.material-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.material-card {
    background: rgba(255, 255, 255, 0.01);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.material-card:hover {
    border-color: var(--accent-clay);
    background: rgba(200, 138, 117, 0.02);
}

.material-card.active {
    border-color: var(--accent-clay);
    background: rgba(200, 138, 117, 0.08);
    box-shadow: 0 0 10px var(--accent-clay-glow);
}

.material-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: bold;
    color: var(--accent-sand);
}

.material-stats {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
}

/* Designer Canvas Wrapper */
.canvas-wrapper {
    flex: 1;
    position: relative;
    background-color: #0b0e0c;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Drawing grid canvas */
#design-canvas {
    background-color: #0c100d;
    cursor: crosshair;
    box-shadow: 0 20px 60px rgba(0,0,0,0.6);
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.03);
}

/* Control Overlay on top of canvas */
.canvas-controls {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(16, 21, 18, 0.85);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(10px);
    border-radius: 30px;
    padding: 8px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    z-index: 50;
}

.ctrl-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 1rem;
    cursor: pointer;
    padding: 6px 12px;
    border-radius: 20px;
    transition: all 0.3s;
    font-family: var(--font-body);
    font-weight: 600;
}

.ctrl-btn:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.05);
}

.ctrl-btn.active {
    color: var(--accent-sage);
    background: rgba(141, 163, 146, 0.12);
}

/* Solfeggio Tuner Board */
.frequency-tuner {
    display: flex;
    flex-direction: column;
    gap: 15px;
    background: rgba(255, 255, 255, 0.01);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 16px;
    padding: 16px;
}

.room-dimensions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
}

.dim-input {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
    padding: 8px;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: center;
}

.frequency-readout {
    text-align: center;
    background: rgba(141, 163, 146, 0.05);
    border-radius: 12px;
    padding: 12px;
    border: 1px dashed rgba(141, 163, 146, 0.2);
}

.freq-num {
    font-family: var(--font-mono);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--accent-sage);
    text-shadow: 0 0 10px var(--accent-sage-glow);
}

.freq-unit {
    font-size: 0.7rem;
    color: var(--text-muted);
}

/* Checklist diagnostics list */
.checklist {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.check-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.78rem;
    background: rgba(255, 255, 255, 0.01);
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.03);
}

.check-item.alert-item {
    border-left: 3px solid var(--alert);
    background: rgba(226, 109, 92, 0.03);
}

.check-item.success-item {
    border-left: 3px solid var(--success);
    background: rgba(141, 163, 146, 0.03);
}

.check-icon {
    font-size: 1rem;
}

.check-text {
    line-height: 1.4;
}

/* Play button for room frequency space clear */
.play-pulse-btn {
    background: var(--accent-sage);
    color: var(--bg-dark);
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: bold;
    border: none;
    padding: 12px 20px;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

.play-pulse-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px var(--accent-sage-glow);
}

.play-pulse-btn.playing {
    background: var(--accent-clay);
    box-shadow: 0 4px 15px var(--accent-clay-glow);
}
