            font-family: 'Orbitron', sans-serif;
            font-size: 0.85rem;
            letter-spacing: 2px;
            color: var(--accent);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 8px;
            margin-bottom: 4px;
            font-weight: 700;
            text-transform: uppercase;
            transition: color 0.5s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .voice-toggle-btn {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.6rem;
            font-weight: bold;
            letter-spacing: 1px;
            cursor: pointer;
            padding: 3px 8px;
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 4px;
            background: rgba(255,255,255,0.03);
            transition: all 0.3s;
            color: var(--text);
        }
        .voice-toggle-btn.voice-active {
            background: rgba(0,229,255,0.15);
            border-color: var(--highlight);
            color: var(--highlight);
        }

        button {
            background: var(--primary); color: #fff; border: 1.5px solid rgba(255, 255, 255, 0.15); 
            padding: 12px; border-radius: 6px; cursor: pointer; 
            font-family: 'Orbitron', sans-serif; font-weight: bold;
            text-transform: uppercase; letter-spacing: 2px; font-size: 0.75rem;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            width: 100%;
            outline: none;
        }
        button:hover:not(:disabled) { 
            background: var(--accent); color: var(--secondary); 
            box-shadow: 0 0 15px var(--accent-glow);
            transform: translateY(-1px);
        }
        button:active:not(:disabled) {
            transform: translateY(1px);
        }

        /* Time & Logs HUD styling */
        .hud-display {
            display: grid;
            grid-template-columns: 1fr 1.5fr 1fr;
            align-items: center;
            text-align: center;
            max-width: 1300px;
            margin: 0 auto;
            width: 100%;
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(10, 10, 15, 0.45);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 12px;
            padding: 16px 24px;
