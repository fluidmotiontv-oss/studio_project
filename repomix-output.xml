    <!-- Economy Logic Script -->
    <script>
        // Default Local Storage Setups
        let balance = parseFloat(localStorage.getItem('harmony_wallet_balance'));
        if (isNaN(balance)) {
            balance = 10.00;
            localStorage.setItem('harmony_wallet_balance', balance.toFixed(2));
        }

        let upkeepBalance = parseFloat(localStorage.getItem('harmony_upkeep_balance'));
        if (isNaN(upkeepBalance)) {
            upkeepBalance = 0.00;
            localStorage.setItem('harmony_upkeep_balance', upkeepBalance.toFixed(2));
        }

        let totalViews = parseInt(localStorage.getItem('harmony_total_views'));
        if (isNaN(totalViews)) {
            totalViews = 124;
            localStorage.setItem('harmony_total_views', totalViews);
        }

        // Ledger Transactions log
        let ledgerLogs = JSON.parse(localStorage.getItem('harmony_ledger_logs'));
        if (!ledgerLogs) {
            ledgerLogs = [
                { time: "System Init", type: "INIT", desc: "Seed Capital Deposited", amount: 10.00 },
                { time: "System Init", type: "FEE", desc: "Genesis block allocation", amount: 0.00 }
            ];
            localStorage.setItem('harmony_ledger_logs', JSON.stringify(ledgerLogs));
        }

        // Video Repository inside Local Storage
        let communityVideos = JSON.parse(localStorage.getItem('harmony_community_videos'));
        if (!communityVideos) {
            communityVideos = [
                {
                    id: "be-your-light",
                    title: "Be Your Light: A New Zealand Project",
                    creator: "fluidmotiontv (Mary Dwen & Tim Dwen)",
                    duration: 3,
                    desc: "Collaborating on a project like 'Be Your Light' clearly reflects the deep connection you have with your mother, Mary Dwen, and her involvement in the Our New Eden community. Igniting the light in ourselves ignites the light in others.",
                    videoUrl: "https://www.youtube.com/embed/JgKmAs4Xa54",
                    resonance: 3.00
                }
            ];
            localStorage.setItem('harmony_community_videos', JSON.stringify(communityVideos));
        }

        // Updates Displays
        function updateUI() {
            document.getElementById('display-balance').innerText = `◈ ${balance.toFixed(2)}`;
            document.getElementById('upkeep-balance').innerText = `◈ ${upkeepBalance.toFixed(2)}`;
            document.getElementById('views-counter').innerText = totalViews;

            // Render Ledger Logs
            const logBox = document.getElementById('ledger-list-box');
            logBox.innerHTML = '';
            ledgerLogs.slice().reverse().forEach(log => {
                const item = document.createElement('div');
                item.className = 'ledger-item';
                
                let typeClass = 'type-split';
                let typeSign = '';
                if (log.type === 'INIT' || log.type === 'EARN') {
                    typeClass = 'type-add';
                    typeSign = '+';
                } else if (log.type === 'SPEND') {
                    typeClass = 'type-sub';
                    typeSign = '-';
                }

                item.innerHTML = `
                    <div class="meta-row">
                        <span style="color:#fff;">${log.desc}</span>
                        <span class="${typeClass}">${typeSign}◈${log.amount.toFixed(2)}</span>
                    </div>
                    <div class="meta-row" style="color:var(--text-muted); font-size:0.5rem;">
                        <span>${log.time}</span>
                        <span>[${log.type}]</span>
                    </div>
                `;
                logBox.appendChild(item);
            });

            // Render Videos
            renderVideos();
        }

        // Switch Rooms/Tabs
        function switchTab(tabId) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

            event.target.classList.add('active');
            document.getElementById(`tab-${tabId}`).classList.add('active');
        }

        // Add log helper
        function addLog(type, desc, amount) {
            const timeString = new Date().toLocaleTimeString();
            ledgerLogs.push({ time: timeString, type, desc, amount });
            localStorage.setItem('harmony_ledger_logs', JSON.stringify(ledgerLogs));
        }

        // Support Video Split (90/10 Rule)
        function supportVideo(videoId) {
            const supportAmount = 1.00;
            if (balance < supportAmount) {
                alert("Insufficient Harmony Notes in your wallet! Visit 'Promoted Flows' to earn more attention credits.");
                return;
            }

            // Deduct
            balance -= supportAmount;
            localStorage.setItem('harmony_wallet_balance', balance.toFixed(2));
            addLog('SPEND', `Supported Video #${videoId}`, supportAmount);

            // Split Calculations
            const artistShare = supportAmount * 0.90;
            const feeShare = supportAmount * 0.10;

            upkeepBalance += feeShare;
            localStorage.setItem('harmony_upkeep_balance', upkeepBalance.toFixed(2));
            addLog('FEE', `Upkeep hold for #${videoId}`, feeShare);

            // Increment Video Resonance
            const index = communityVideos.findIndex(v => v.id === videoId);
            if (index !== -1) {
                communityVideos[index].resonance += artistShare;
                localStorage.setItem('harmony_community_videos', JSON.stringify(communityVideos));
            }

            // View Increment
            totalViews += 1;
            localStorage.setItem('harmony_total_views', totalViews);

            updateUI();
        }

        // Render Videos in gallery
        function renderVideos() {
            const container = document.getElementById('organic-list');
            container.innerHTML = '';

            communityVideos.forEach(video => {
                const card = document.createElement('div');
                card.className = 'video-card';
                card.innerHTML = `
                    <div class="video-frame-wrapper">
                        <iframe src="${video.videoUrl}" allowfullscreen></iframe>
                    </div>
                    <div class="card-details">
                        <div class="card-title">${video.title}</div>
                        <div class="card-meta">
                            <span>CREATOR: ${video.creator}</span>
                            <span>LENGTH: ${video.duration} MINS</span>
                        </div>
                        <p class="card-desc">${video.desc}</p>
                    </div>
                    <div class="card-actions">
                        <div class="resonance-score">
                            <span>◈ Resonance:</span>
                            <span class="resonance-counter" style="display:inline-block;">◈ ${video.resonance.toFixed(2)}</span>
                        </div>
                        <button class="action-btn" onclick="supportVideo('${video.id}')">Support (◈ 1.00)</button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // Ads Simulation Watch Flow
        let adInterval = null;
        function startAdSimulation() {
            const btn = document.getElementById('btn-watch-ad');
            const timer = document.getElementById('ad-timer');
            const emoji = document.getElementById('ad-status-emoji');

            btn.classList.add('disabled');
            btn.disabled = true;
            timer.style.display = 'block';
            emoji.innerText = '⚡';

            let count = 10;
            timer.innerText = `COUNTDOWN: ${count}s`;

            adInterval = setInterval(() => {
                count--;
                timer.innerText = `COUNTDOWN: ${count}s`;
                
                if (count <= 0) {
                    clearInterval(adInterval);
                    adInterval = null;
                    
                    // Ad completed: pay viewer
                    const viewerEarnings = 0.20;
                    const artistShare = 0.70;
                    const feeShare = 0.10;

                    balance += viewerEarnings;
                    localStorage.setItem('harmony_wallet_balance', balance.toFixed(2));
                    addLog('EARN', 'Watched Promoted Flow ad', viewerEarnings);

                    upkeepBalance += feeShare;
                    localStorage.setItem('harmony_upkeep_balance', upkeepBalance.toFixed(2));
                    addLog('FEE', 'Portal ad revenue split hold', feeShare);

                    emoji.innerText = '✅';
                    timer.innerText = 'EARNED ◈0.20!';
                    
                    btn.classList.remove('disabled');
                    btn.disabled = false;
                    btn.innerText = 'Simulate Watch (Earn ◈0.20)';

                    updateUI();
                }
            }, 1000);
        }

        // Form Submit
        function handleFormSubmit(e) {
            e.preventDefault();

            const urlInput = document.getElementById('inp-url').value;
            const creator = document.getElementById('inp-creator').value;
            const duration = parseInt(document.getElementById('inp-duration').value);
            const desc = document.getElementById('inp-desc').value;

            // Simple YouTube Parser
            let embedUrl = urlInput;
            const youtubeReg = /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/;
            const match = urlInput.match(youtubeReg);
            if (match && match[1]) {
                embedUrl = `https://www.youtube.com/embed/${match[1]}`;
            }

            // Create Video Object
            const newVideo = {
                id: `video-${Date.now()}`,
                title: `Contribution: ${creator} Studio`,
                creator,
                duration,
                desc,
                videoUrl: embedUrl,
                resonance: duration * 1.00 // Baseline effort reward
            };

            communityVideos.push(newVideo);
            localStorage.setItem('harmony_community_videos', JSON.stringify(communityVideos));

            // Reward creator baseline (mocked: artist gets their reward in notes balance)
            addLog('INIT', `Video #${newVideo.id} claimed baseline`, newVideo.resonance);

            document.getElementById('upload-form').reset();
            alert("Video successfully added to the Resonant Gallery!");
            switchTab('organic');
            updateUI();
        }

        // Reset
        function resetWalletStorage() {
            if (confirm("Reset wallet balances, ledger entries, and community videos back to system default?")) {
                localStorage.removeItem('harmony_wallet_balance');
                localStorage.removeItem('harmony_upkeep_balance');
                localStorage.removeItem('harmony_total_views');
                localStorage.removeItem('harmony_ledger_logs');
                localStorage.removeItem('harmony_community_videos');
                location.reload();
            }
        }

        // Init UI
        updateUI();
    </script>
</body>
</html>
</file>

<file path="apps/dragon9/pyro-drummer/index.html">
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pyro-Drummer - 3D Drum Synth & Fireworks</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;600&family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-dark: #020617;
            --glass-bg: rgba(9, 13, 26, 0.65);
            --glass-border: rgba(255, 255, 255, 0.08);
            --text-main: #f8fafc;
            --cyan-glow: #00e5ff;
            --gold-accent: #d4af37;
            --magenta-glow: #ff007f;
            --green-glow: #39ff14;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            overflow: hidden;
            height: 100vh;
            width: 100vw;
        }

        /* Ambient background nebulas */
        .fluid-bg {
            position: absolute;
            top: 0; left: 0; width: 100vw; height: 100vh;
            z-index: 1;
            overflow: hidden;
            pointer-events: none;
        }
        .blob {
            position: absolute;
            border-radius: 50%;
            opacity: 0.25;
            filter: blur(140px);
            animation: float 25s infinite ease-in-out alternate;
        }
        .blob-1 {
            width: 50vw; height: 50vw;
            background: radial-gradient(circle, var(--cyan-glow) 0%, rgba(0,0,0,0) 70%);
            top: -10%; left: 5%;
        }
        .blob-2 {
            width: 45vw; height: 45vw;
            background: radial-gradient(circle, var(--magenta-glow) 0%, rgba(0,0,0,0) 70%);
            bottom: -10%; right: 10%;
            animation-delay: -5s;
        }
        @keyframes float {
            0% { transform: translate(0, 0) scale(1) rotate(0deg); }
            100% { transform: translate(80px, -80px) scale(1.1) rotate(45deg); }
        }

        /* WebGL Canvas */
        #canvas-container {
            position: absolute;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            z-index: 2;
        }

        /* UI Shell Overlays */
        .glass-overlay {
            position: absolute;
            top: 0; left: 0; width: 100vw; height: 100vh;
            z-index: 10;
            pointer-events: none;
            display: grid;
            grid-template-columns: 300px 1fr 300px;
            grid-template-rows: 70px 1fr 190px 45px;
            padding: 15px;
            gap: 15px;
        }

        .interactive-panel {
            pointer-events: auto;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 18px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5), inset 0 0 20px rgba(255,255,255,0.01);
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        header {
            grid-column: 1 / 4;
            grid-row: 1;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: 'Cinzel', serif;
            padding: 0 10px;
        }
        header h1 {
            font-size: 1.4rem;
            letter-spacing: 4px;
            font-weight: 400;
        }
        header h1 span {
            color: var(--magenta-glow);
            font-weight: 700;
            text-shadow: 0 0 15px rgba(255, 0, 127, 0.4);
        }
        .btn-nav {
            color: #94a3b8;
            text-decoration: none;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            letter-spacing: 1.5px;
            padding: 6px 14px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 6px;
            background: rgba(255,255,255,0.01);
            transition: all 0.3s;
            pointer-events: auto;
            cursor: pointer;
        }
        .btn-nav:hover {
            border-color: var(--cyan-glow);
            color: var(--cyan-glow);
            box-shadow: 0 0 10px rgba(0, 229, 255, 0.2);
        }

        /* Sidebars */
        .left-sidebar {
            grid-column: 1;
            grid-row: 2;
            gap: 15px;
        }
        .right-sidebar {
            grid-column: 3;
            grid-row: 2;
            gap: 15px;
        }

        .panel-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.85rem;
            letter-spacing: 2px;
            color: var(--gold-accent);
            text-transform: uppercase;
            border-bottom: 1px solid rgba(212, 175, 55, 0.15);
            padding-bottom: 6px;
            margin-bottom: 10px;
        }

        .control-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .control-label {
            font-size: 0.65rem;
            letter-spacing: 1px;
            color: #94a3b8;
            text-transform: uppercase;
        }

        /* Sliders */
        .slider-container {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .slider-header {
            display: flex;
            justify-content: space-between;
            font-size: 0.65rem;
            color: #cbd5e1;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        input[type="range"] {
            -webkit-appearance: none;
            width: 100%;
            height: 4px;
            background: rgba(255,255,255,0.1);
            border-radius: 2px;
            outline: none;
            pointer-events: auto;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: var(--cyan-glow);
            cursor: pointer;
            box-shadow: 0 0 8px var(--cyan-glow);
            transition: transform 0.1s;
        }
        input[type="range"]::-webkit-slider-thumb:hover {
            transform: scale(1.25);
        }

        /* Buttons & Toggles */
        .toggle-btn {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--glass-border);
            color: #fff;
            padding: 8px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.7rem;
            letter-spacing: 1px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s;
        }
        .toggle-btn:hover {
            border-color: var(--magenta-glow);
            background: rgba(255, 0, 127, 0.05);
        }
        .toggle-btn .indicator {
            width: 8px; height: 8px;
            border-radius: 50%;
