                            originalButton.firstChild.textContent = "📁 SELECT";
                            originalButton.style.pointerEvents = "auto";
                        }, 2000);
                        return;
                    }
                }
                throw new Error("Local backend unavailable or error occurred");
            } catch (err) {
                console.log("Local backend upload failed/unavailable, falling back to offline Base64 embed.", err);
                originalButton.firstChild.textContent = "⌛ ENCODING...";
                
                // Fallback to reading file as Data URL (base64)
                const reader = new FileReader();
                reader.onload = function(e) {
