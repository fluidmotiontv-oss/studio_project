        .label-wrap { position: absolute; width: 100%; top: 12px; display: flex; flex-direction: column; align-items: center; }
        .hour-top { font-size: 16px; font-weight: 700; color: var(--text); font-family: 'Orbitron', sans-serif; text-shadow: 0 0 4px var(--accent-glow); }
        .hour-bottom { font-size: 10px; font-weight: 500; color: var(--accent); opacity: 0.8; font-family: 'Orbitron', sans-serif; transition: color 0.5s ease; }
        
        /* Futuristic Tapered Clock Hands */
        .hand { 
            position: absolute; 
            left: 50%; 
            bottom: 50%; 
            transform-origin: bottom center; 
            border-radius: 10px; 
            filter: drop-shadow(0 0 8px var(--accent-glow)); 
            transition: background 0.5s ease; 
        }
        .hour-hand { 
            width: 8px; 
            height: 85px; 
            background: linear-gradient(to top, var(--secondary), var(--primary)); 
            z-index: 5; 
            border: 1.5px solid rgba(255, 255, 255, 0.15); 
            clip-path: polygon(30% 0%, 70% 0%, 100% 100%, 0% 100%);
        }
        .min-hand { 
            width: 5px; 
            height: 120px; 
            background: linear-gradient(to top, var(--primary), var(--accent)); 
            z-index: 4; 
            clip-path: polygon(35% 0%, 65% 0%, 100% 100%, 0% 100%);
        }
        .sec-hand { 
            width: 2px; 
            height: 135px; 
            background: var(--highlight); 
            z-index: 6; 
            box-shadow: 0 0 12px var(--highlight);
        }
        .hub-center { 
            position: absolute; 
            top: 50%; 
            left: 50%; 
            width: 20px; 
            height: 20px; 
            background: radial-gradient(circle, #fff 20%, var(--highlight) 60%, transparent 100%); 
            border: 2px solid var(--accent); 
            border-radius: 50%; 
            transform: translate(-50%, -50%); 
            z-index: 10; 
            box-shadow: 0 0 15px var(--highlight); 
        }

        /* Repositioned Floating Vortex HUD */
        .vortex-hud {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: min(600px, calc(100vw - 24px));
            max-width: 90%;
            text-align: center; 
            padding: 12px 16px; 
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(10, 10, 10, 0.45); 
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 12px; z-index: 100;
            display: grid; grid-template-columns: 1fr 2fr 1fr; align-items: center;
            gap: 8px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            transition: border 0.5s ease;
        }

        @media (max-width: 768px) {
            .vortex-hud {
                bottom: 10px;
                padding: 10px 12px;
                width: calc(100vw - 20px);
            }
            .digital-stream {
                font-size: 24px;
            }
            .millionths {
                font-size: 12px;
            }
            .root-val {
                font-size: 0.75rem;
            }
        }
        
        .digital-stream { 
            font-size: 38px; 
            color: var(--highlight); 
            font-weight: 700; 
            font-family: 'Share Tech Mono', monospace; 
            letter-spacing: 2px;
            text-shadow: 0 0 8px var(--highlight);
        }
        .millionths { 
            font-size: 16px; 
            color: var(--alert); 
            font-family: 'Share Tech Mono', monospace; 
            opacity: 0.8; 
            margin-left: 4px; 
            text-shadow: 0 0 6px var(--alert);
        }
        .root-val { 
            color: var(--accent); 
            font-size: 0.9rem; 
            font-weight: 700; 
            margin-bottom: 8px; 
            font-family: 'Orbitron', sans-serif;
            letter-spacing: 1px;
            transition: color 0.5s ease;
        }
        .cycle-tracker { display: flex; gap: 6px; justify-content: center; }
        .cycle-dot { 
            width: 8px; height: 8px; border-radius: 50%; 
            border: 1px solid var(--accent); opacity: 0.25; 
            transition: all 0.5s ease;
        }
        .cycle-dot.active { 
            background: var(--accent); opacity: 1; 
            box-shadow: 0 0 10px var(--accent); 
            transform: scale(1.3);
        }

        /* Interactive Tooltip style */
        .tooltip {
            position: absolute;
            background: rgba(5, 5, 5, 0.85);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1.5px solid var(--accent);
            color: var(--text);
            padding: 8px 12px;
            border-radius: 6px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 12px;
            pointer-events: none;
            opacity: 0;
            transform: translate(-50%, -100%) scale(0.9);
            transition: opacity 0.2s ease, transform 0.2s ease;
            z-index: 1000;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
            white-space: nowrap;
        }
        .tooltip.visible {
            opacity: 1;
            transform: translate(-50%, -120%) scale(1);
        }
        .tooltip::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 50%;
            transform: translateX(-50%);
            border-width: 5px 5px 0;
            border-style: solid;
            border-color: var(--accent) transparent transparent;
            display: block;
            width: 0;
        }

        canvas { position: absolute; top: 0; left: 0; z-index: 1; }

        /* Floating Station Network Panel with search container */
        .network-panel {
            position: fixed;
            top: 100px;
            right: -420px;
            width: 380px;
            height: calc(100vh - 220px);
            background: rgba(10, 10, 10, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            z-index: 500;
            padding: 15px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
            transition: right 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .network-panel.open {
            right: 20px;
        }
        .panel-header {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            letter-spacing: 2px;
            color: var(--accent);
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            padding-bottom: 8px;
            margin-bottom: 10px;
        }
        
        #station-search {
            width: 100%; 
            padding: 8px 12px; 
            background: rgba(255,255,255,0.05); 
            border: 1px solid rgba(255,255,255,0.15); 
            border-radius: 6px; 
            color: var(--text); 
            font-family: 'Share Tech Mono', monospace; 
            font-size: 0.75rem; 
            letter-spacing: 1px; 
            outline: none; 
            transition: all 0.3s ease;
        }
        #station-search:focus {
            border-color: var(--accent);
            box-shadow: 0 0 8px var(--accent-glow);
            background: rgba(255,255,255,0.08);
        }

        .close-btn {
            cursor: pointer;
            font-size: 1.2rem;
            opacity: 0.7;
            transition: opacity 0.3s;
        }
        .close-btn:hover {
            opacity: 1;
            color: var(--alert);
        }
        .network-grid {
            flex-grow: 1;
            overflow-y: auto;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 6px;
            padding-right: 4px;
            margin-top: 10px;
        }
        .network-grid::-webkit-scrollbar {
            width: 4px;
        }
        .network-grid::-webkit-scrollbar-track {
            background: transparent;
        }
        .network-grid::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 2px;
        }
        .network-grid::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.3);
        }
        
        .station-cell {
            border: 1px solid rgba(255,255,255,0.04); 
            border-radius: 6px; 
            padding: 8px;
            background: rgba(255, 255, 255, 0.02); 
            display: flex; 
            flex-direction: column; 
            justify-content: space-between;
            transition: all 0.3s ease; 
            opacity: 0.7; 
            cursor: pointer;
            height: 54px;
        }
        .station-cell:hover { 
            opacity: 1; 
            background: rgba(255, 255, 255, 0.05);
            transform: translateY(-1px);
        }
        .station-cell.active-focus {
            border-color: var(--accent) !important;
            background: rgba(255, 255, 255, 0.08);
            opacity: 1;
        }
        .station-cell-info { 
            font-size: 0.55rem; 
            color: var(--text); 
            font-family: 'Orbitron', sans-serif;
            text-transform: uppercase; 
            display: flex; 
            justify-content: space-between; 
            opacity: 0.75;
        }
        .vortex-time { 
            font-size: 0.95rem; 
            font-weight: 700; 
            text-align: right;
            font-family: 'Share Tech Mono', monospace;
            margin-top: 4px;
        }

        /* Workspace Viewport Container */
        .workspace-viewport {
            position: fixed;
            top: 90px;
            left: 20px;
            right: 20px;
            bottom: 90px;
            background: rgba(5, 5, 5, 0.7);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 2px solid var(--accent);
            border-radius: 16px;
            z-index: 400;
            display: flex;
            flex-direction: column;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8), 0 0 30px var(--accent-glow);
            opacity: 0;
            pointer-events: none;
            transform: scale(0.95);
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .workspace-viewport.active {
            opacity: 1;
            pointer-events: auto;
            transform: scale(1);
        }

        .viewport-header {
            background: rgba(15, 15, 15, 0.85);
            border-bottom: 1.5px solid rgba(255, 255, 255, 0.08);
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top-left-radius: 14px;
            border-top-right-radius: 14px;
        }

        .viewport-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--accent);
            letter-spacing: 2px;
        }

        .viewport-controls {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .v-control {
            cursor: pointer;
            font-size: 0.85rem;
            opacity: 0.65;
            transition: all 0.2s ease;
            user-select: none;
        }

        .v-control:hover {
            opacity: 1;
            transform: scale(1.15);
        }

        .v-control.close-btn {
            font-size: 1.25rem;
            color: var(--alert);
        }

        #viewport-iframe {
            flex-grow: 1;
            width: 100%;
            height: 100%;
            border-bottom-left-radius: 14px;
            border-bottom-right-radius: 14px;
            background: transparent;
        }
        
        /* Active nav link style for running workspace */
        .nav-link.active-workspace {
            color: #fff !important;
            border-color: var(--accent) !important;
            box-shadow: 0 0 12px var(--accent-glow) !important;
            background: rgba(255, 255, 255, 0.08) !important;
        }

        /* Quest Game HUD Styles */
        .quest-hud-panel {
            position: fixed;
            top: 75px;
            right: 20px;
            width: 250px;
            background: rgba(13, 13, 20, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(0, 229, 255, 0.25);
            border-radius: 10px;
            padding: 10px 14px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            z-index: 100;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.7rem;
            color: var(--text);
            transition: all 0.3s;
        }
        .quest-hud-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            font-weight: 900;
            color: var(--accent);
            text-shadow: 0 0 5px var(--accent-glow);
        }
        .quest-hud-body {
            margin-top: 8px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            border-top: 1px solid rgba(255,255,255,0.06);
            padding-top: 8px;
        }
        .quest-item {
            display: flex;
            align-items: center;
            gap: 8px;
            opacity: 0.85;
            transition: opacity 0.2s;
        }
        .quest-item.completed {
            opacity: 0.5;
            text-decoration: line-through;
            color: var(--highlight);
        }
        .quest-checkbox {
            color: var(--accent);
            font-size: 0.8rem;
        }
        .quest-item.completed .quest-checkbox {
            color: var(--highlight);
        }

        /* Quest Rewards Modal */
        .quest-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            backdrop-filter: blur(10px);
        }
        .quest-modal-content {
            background: linear-gradient(135deg, rgba(20,20,30,0.95), rgba(5,5,10,0.98));
            border: 2px solid var(--highlight);
            box-shadow: 0 0 35px rgba(212, 175, 55, 0.3);
            border-radius: 16px;
            width: 90%;
            max-width: 480px;
            padding: 30px;
            text-align: center;
            font-family: 'Outfit', sans-serif;
            color: var(--text);
            animation: modalFadeIn 0.4s ease;
        }
        @keyframes modalFadeIn {
            from { transform: scale(0.9); opacity: 0; }
            to { transform: scale(1.0); opacity: 1; }
        }
        .reward-badge {
            font-size: 3rem;
            margin-bottom: 12px;
            animation: float 3s ease-in-out infinite;
        }
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }
    </style>
</head>
