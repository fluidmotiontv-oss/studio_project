            --highlight: #d4af37;
            --text: #f0f2f5;
            --text-muted: rgba(240, 242, 245, 0.6);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            font-family: 'Outfit', sans-serif;
            overflow-x: hidden;
            min-height: 100vh;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(0, 229, 255, 0.03) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(255, 0, 128, 0.03) 0%, transparent 45%);
            position: relative;
        }

        /* Ambient background particle canvas container */
        #bg-canvas-container {
            position: fixed;
