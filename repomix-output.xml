            piha: { name: "Piha", lat: -36.9535, lon: 174.4647 },
            mangawhai: { name: "Mangawhai Heads", lat: -36.0833, lon: 174.5833 },
            mount: { name: "Mount Maunganui", lat: -37.6393, lon: 176.1793 },
            kaikoura: { name: "Kaikoura", lat: -42.4000, lon: 173.6814 }
