<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dragon 9 | Distributed Node Fabric V2</title>
    <!-- Google Fonts Integration -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Orbitron:wght@400;600;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <style>
        :root {
            --gold: #d4af37; --cream: #f4e4bc; --purple-deep: #161020; --purple-mid: #5d4e75;
            --dark: #050505; --cyan: #00e5ff; --magenta: #ff0080; --matrix-green: #00ff41;
            --amber-glow: #ffaa00;
            
            --accent: var(--gold);
            --accent-glow: rgba(212, 175, 55, 0.25);
            --bg: var(--dark);
            --text: var(--cream);
            --primary: var(--purple-mid);
            --secondary: var(--purple-deep);
            --highlight: var(--cyan);
            --alert: var(--magenta);
        }

        .theme-matrix { 
            --accent: var(--matrix-green); --accent-glow: rgba(0, 255, 65, 0.3); 
            --bg: #000000; --text: #00ff41; --primary: #004400; --secondary: #002200; 
            --highlight: #00ff41; --alert: #ffffff; 
        }
        .theme-amber { 
            --accent: var(--amber-glow); --accent-glow: rgba(255, 170, 0, 0.3); 
            --bg: #100a00; --text: #ffcc00; --primary: #884400; --secondary: #442200; 
            --highlight: #ffee00; --alert: #ff4400; 
        }
        .theme-cyber { 
            --accent: var(--cyan); --accent-glow: rgba(0, 229, 255, 0.3); 
            --bg: #050010; --text: #ff00ff; --primary: #0055ff; --secondary: #001144; 
            --highlight: var(--magenta); --alert: #00ffff; 
        }
        .theme-fluid { 
            --accent: var(--cyan); --accent-glow: rgba(0, 229, 255, 0.3); 
            --bg: #00050d; --text: #ffffff; --primary: #00e5ff; --secondary: #001f3f; 
            --highlight: #ff0080; --alert: #00ff41; 
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body { 
            background: var(--bg); color: var(--text); 
            font-family: 'Inter', sans-serif; 
            padding: 20px; min-height: 100vh; display: flex; flex-direction: column;
            transition: background 0.8s ease, color 0.5s ease;
            position: relative;
            overflow-x: hidden;
        }

        /* Scanline Overlay for retro sci-fi themes */
        body::after {
            content: " ";
            display: block;
            position: fixed;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), 
                        linear-gradient(90deg, rgba(255, 0, 0, 0.04), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.04));
            z-index: 9999;
            background-size: 100% 4px, 6px 100%;
            pointer-events: none;
            opacity: 0.12;
            transition: opacity 0.5s ease;
        }

        .header {
            padding: 16px 28px; 
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(10, 10, 10, 0.45); 
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 12px; margin-bottom: 24px; z-index: 50;
            display: flex; justify-content: space-between; align-items: center;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.25);
            transition: border 0.5s ease;
            flex-wrap: wrap;
            gap: 15px;
        }

        .nav-links {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .nav-btn {
            text-decoration: none;
            color: inherit;
            font-size: 0.65rem;
            opacity: 0.75;
            font-family: 'Orbitron', sans-serif;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 32px;
            padding: 0 12px;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
            font-weight: 700;
            letter-spacing: 1px;
        }
        .nav-btn:hover {
            opacity: 1;
            background: rgba(255, 255, 255, 0.12);
            border-color: var(--accent);
            box-shadow: 0 0 10px var(--accent-glow);
            transform: translateY(-1px);
        }
        .nav-btn.active-tab {
            opacity: 1;
            border-color: var(--accent);
            background: rgba(255, 255, 255, 0.1);
            box-shadow: 0 0 10px var(--accent-glow);
        }

        .theme-switcher { display: flex; gap: 8px; align-items: center; }
        .theme-btn { 
            width: 18px; height: 18px; border-radius: 50%; 
            border: 1.5px solid rgba(255, 255, 255, 0.4); 
            cursor: pointer; opacity: 0.6; 
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
        }
        .theme-btn:hover { opacity: 1; transform: scale(1.25); }
        .theme-btn.active { opacity: 1; border-color: #fff; transform: scale(1.15); box-shadow: 0 0 10px var(--accent); }
        
        .btn-classic { background: var(--gold); }
        .btn-matrix { background: var(--matrix-green); }
        .btn-amber { background: var(--amber-glow); }
        .btn-cyber { background: var(--cyan); }
        .btn-fluid { background: linear-gradient(45deg, #00e5ff, #ff0080); }

        .dashboard-grid {
            display: grid;
            grid-template-columns: 320px 1fr 340px;
            gap: 20px;
            flex-grow: 1;
            max-width: 1600px;
            margin: 0 auto;
            width: 100%;
            margin-bottom: 20px;
        }

        @media (max-width: 1200px) {
            .dashboard-grid {
                grid-template-columns: 1fr;
            }
        }

        .panel {
            background: rgba(10, 10, 10, 0.45);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
            transition: border-color 0.5s ease;
        }

        .panel-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.85rem;
            letter-spacing: 2px;
            color: var(--accent);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 10px;
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 700;
        }

        .clock-overlay {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.03);
            border: 1px dashed rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 12px;
            margin-bottom: 15px;
        }

        .clock-time {
            font-family: 'Share Tech Mono', monospace;
            font-size: 1.8rem;
            color: var(--highlight);
            text-shadow: 0 0 8px var(--highlight);
        }
        .clock-milli {
            font-size: 0.9rem;
            color: var(--alert);
            opacity: 0.85;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 8px;
            padding: 12px;
            margin-bottom: 10px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .stat-label {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text);
            opacity: 0.6;
        }

        .stat-value {
            font-family: 'Share Tech Mono', monospace;
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--text);
        }

        .stat-bar-outer {
            width: 100%;
            height: 4px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 2px;
            overflow: hidden;
            margin-top: 6px;
        }
        .stat-bar-inner {
            height: 100%;
            background: var(--accent);
            width: 0%;
            transition: width 0.5s ease;
            box-shadow: 0 0 8px var(--accent);
        }

        /* SVG Network Map Pane */
        .fabric-map-container {
            position: relative;
            width: 100%;
            height: 500px;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .fabric-svg {
            width: 100%;
            height: 100%;
        }

        .svg-link {
            stroke: var(--primary);
            stroke-width: 1.5;
            stroke-opacity: 0.35;
            transition: all 0.3s;
        }
        .svg-link.active-pulse {
            stroke: var(--accent);
            stroke-opacity: 0.8;
            stroke-dasharray: 5;
            animation: dash 5s linear infinite;
        }
        .svg-link.relax-pulse {
            stroke: var(--amber-glow);
            stroke-opacity: 0.5;
        }

        @keyframes dash {
            to {
                stroke-dashoffset: -100;
            }
        }

        .svg-node {
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .svg-node circle {
            fill: var(--bg);
            stroke: var(--accent);
            stroke-width: 2;
            transition: all 0.3s;
        }
        .svg-node:hover circle {
            stroke: #fff;
            stroke-width: 3.5;
            filter: drop-shadow(0 0 8px var(--accent));
        }
        .svg-node.offline circle {
            stroke: #555 !important;
            fill: #111 !important;
        }
        .svg-node.desynced circle {
            stroke: var(--alert) !important;
            filter: drop-shadow(0 0 6px var(--alert));
        }
        .svg-node.focused circle {
            stroke: var(--highlight) !important;
            stroke-width: 3;
            filter: drop-shadow(0 0 10px var(--highlight));
        }

        .node-label {
            font-family: 'Share Tech Mono', monospace;
            font-size: 8px;
            fill: var(--text);
            pointer-events: none;
            opacity: 0.65;
            text-anchor: middle;
            transition: opacity 0.3s, font-size 0.3s;
        }
        .svg-node:hover + .node-label, .svg-node.focused + .node-label {
            opacity: 1;
            font-size: 10px;
            font-weight: 600;
        }

        /* Control Board */
        .btn-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-top: 15px;
        }
        .action-btn {
            background: rgba(255, 255, 255, 0.05);
