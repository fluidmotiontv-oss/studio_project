            </button>

            <div style="font-family:'Share Tech Mono'; font-size:0.6rem; color:var(--text-muted); line-height: 1.4; border: 1px dashed rgba(255,255,255,0.06); padding: 10px; border-radius: 6px; margin-top: 10px;">
                <span style="color:var(--accent);">INFO:</span> Charged plasma responds to electromagnetic fields. Toggle the Magnetic Steer to curl filaments into containment spirals.
            </div>
        </div>

        <!-- Center: Interactive Plasma Globe -->
        <div class="canvas-container">
            <div class="clock-sync-indicator" id="clock-indicator">
                <div class="sync-dot" id="indicator-dot"></div>
                <span id="indicator-text">D9 CLOCK: ACTIVE (FOCUS)</span>
            </div>
            <button id="fullscreen-toggle" class="fullscreen-btn" onclick="toggleFullscreen()">📺 Fullscreen</button>
            <canvas id="plasma-canvas"></canvas>
        </div>

        <!-- Right Sidebar: Sound & Arcs Parameters -->
        <div class="sidebar sidebar-right">
            <div class="panel-title">3. Physical Arcs</div>
            
            <div class="control-group">
                <div class="control-label">Voltage / Arc Count <span class="value" id="val-arcs">12</span></div>
                <input type="range" class="slider" id="slider-arcs" min="1" max="32" value="12" oninput="updateParam('arcs', this.value)">
