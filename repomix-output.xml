    <style>
        :root {
            --bg: #070709;
            --panel-bg: rgba(13, 13, 20, 0.45);
            --border: rgba(255, 255, 255, 0.08);
            --accent: #00e5ff;
            --accent-glow: rgba(0, 229, 255, 0.3);
            --secondary: #ff0080;
