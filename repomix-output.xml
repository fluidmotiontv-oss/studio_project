<script>
// --- Holographic Infinity Flow Carousel (3D Ring) ---
(function() {
    const track = document.getElementById('holo-carousel-track');
    if (!track) return;

    const apps = [
        { name: 'DIAL', icon: '⏱️', url: 'dial/landing.html' },
        { name: 'GRID', icon: '🌐', url: 'apps.html' },
        { name: 'ALBUM', icon: '💿', url: 'album-builder/landing.html' },
        { name: 'CRATE', icon: '🎵', url: 'stemcrate_landing.html' },
        { name: 'BRIDGE', icon: '🌉', url: 'universalbridge/landing.html' },
        { name: 'EXCHANGE', icon: '🎼', url: 'apps.html' },
        { name: 'GALLERY', icon: '🎨', url: 'vision.html#exhibition' },
        { name: 'SHIELD', icon: '🛡️', url: 'kiterider/landing.html' },
        { name: 'LOTUS', icon: '🌸', url: 'sound.html#lotus' },
        { name: 'PYRO', icon: '🎆', url: 'sound.html#pyro' },
        { name: 'FABRIC', icon: '🕸️', url: 'nodefabric/landing.html' },
        { name: 'VDO4N6', icon: '📹', url: 'vdo4n6/landing.html' },
        { name: 'EDITOR', icon: '🎬', url: 'apps.html' },
        { name: 'RIDER', icon: '🕹️', url: 'apps.html' },
        { name: 'ARTIST', icon: '🌊', url: 'vision.html#artist' },
        { name: 'GARDEN', icon: '🌱', url: 'nature.html#garden' },
        { name: 'TUNER', icon: '🎸', url: 'sound.html#tuner' },
        { name: 'HEALER', icon: '🧘', url: 'sound.html#healer' },
        { name: 'PIANOLA', icon: '🎹', url: 'sound.html#pianola' },
        { name: 'UKULELE', icon: '🎸', url: 'sound.html#ukulele' },
        { name: 'SEQUENCER', icon: '🎛️', url: 'sound.html#sequencer' },
        { name: 'SHOP', icon: '🛒', url: 'shop.html' },
        { name: 'APPS', icon: '💻', url: 'apps.html' }
    ];

    const totalUnits = 54;
    const spacing = Math.floor(totalUnits / apps.length);
    let appIndex = 0;
    const radius = 650;
    const unitElements = [];
    
    // Create the 54 fundamental units
    for (let i = 0; i < totalUnits; i++) {
        const unit = document.createElement('a');
        unit.className = 'holo-unit';
        
        if (i % spacing === 0 && appIndex < apps.length) {
            const app = apps[appIndex];
            unit.classList.add('active-node');
            unit.href = app.url;
            unit.target = '_blank';
            unit.innerHTML = `<div class="holo-icon">${app.icon}</div><div class="holo-label">${app.name}</div>`;
            appIndex++;
        } else {
            unit.classList.add('dormant');
            unit.innerHTML = `<div class="core-light"></div>`;
        }
        
        // Calculate base angle
        const angle = (i / totalUnits) * 360;
        unit.dataset.angle = angle;
        
        track.appendChild(unit);
        unitElements.push(unit);
    }
    
    let isDragging = false;
    let startX = 0;
    let currentRotation = 0;
    let targetRotation = 0;
    let velocity = 0;
    let hasDragged = false;
    
    const onDown = (clientX) => {
        isDragging = true;
        hasDragged = false;
        startX = clientX;
        velocity = 0;
        track.style.cursor = 'grabbing';
    };
    
    const onMove = (clientX) => {
        if (!isDragging) return;
        hasDragged = true;
        const deltaX = clientX - startX;
        startX = clientX;
        targetRotation += deltaX * 0.25;
        velocity = deltaX * 0.25;
    };
    
    const onUp = () => {
        isDragging = false;
        track.style.cursor = 'grab';
    };

    track.addEventListener('mousedown', e => onDown(e.clientX));
    window.addEventListener('mouseup', onUp);
    window.addEventListener('mousemove', e => onMove(e.clientX));
    
    track.addEventListener('touchstart', e => onDown(e.touches[0].clientX), {passive:true});
    window.addEventListener('touchend', onUp);
    window.addEventListener('touchmove', e => onMove(e.touches[0].clientX), {passive:true});

    // Prevent clicks if dragged
    track.addEventListener('click', e => {
        if (hasDragged) {
            e.preventDefault();
        }
    });
    track.addEventListener('dragstart', e => e.preventDefault());

    function updateLoop() {
        if (!isDragging) {
            targetRotation += velocity;
            velocity *= 0.94; // Ethereal friction
            
            // Auto-rotation (ambient)
            if (Math.abs(velocity) < 0.02) {
                targetRotation += 0.08; 
            }
        }
        
        currentRotation += (targetRotation - currentRotation) * 0.12; // Smooth interpolation
        
        track.style.transform = `rotateY(${currentRotation}deg)`;
        
        // Transform units
        for(let i = 0; i < unitElements.length; i++) {
            const item = unitElements[i];
            const angle = parseFloat(item.dataset.angle);
            
            // Calculate absolute angle in world space to determine depth/opacity
            let worldAngle = (angle + currentRotation) % 360;
            if (worldAngle < 0) worldAngle += 360;
            
            // worldAngle 0 is right, 90 is back, 180 is left, 270 is front
            // To get front facing = 1, back = -1
            // A unit is at front when its worldAngle is 270 degrees.
            const zDist = -Math.cos(worldAngle * Math.PI / 180); // Using standard rotation where 270 is front isn't quite right for cos. 
            // Wait, rotateY(0) means item at angle 0 is at (R, 0, 0). 
            // Better to calculate exact position:
            const rad = worldAngle * Math.PI / 180;
            // X = Math.sin(rad) * R
            // Z = Math.cos(rad) * R
            // So if Z > 0, it's in front. Depth is Z/R, from -1 to 1.
            const depth = Math.cos(rad);
            
            const scale = 0.6 + (0.4 * ((depth + 1) / 2)); // 0.6 to 1.0
            const opacity = 0.2 + (0.8 * ((depth + 1) / 2));
            
            item.style.transform = `translate(-50%, -50%) rotateY(${angle}deg) translateZ(${radius}px) scale(${scale})`;
            item.style.opacity = opacity;
            
            if (depth > 0) {
                item.style.pointerEvents = 'auto';
                item.style.zIndex = Math.floor(depth * 100);
            } else {
                item.style.pointerEvents = 'none';
                item.style.zIndex = 1;
            }
        }
        
        requestAnimationFrame(updateLoop);
    }
    updateLoop();
})();
</script>
