            padding: 6px 10px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.75rem;
            outline: none;
            cursor: pointer;
        }

        .world-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            max-width: 1600px;
            margin: 0 auto;
            z-index: 10;
            position: relative;
            margin-bottom: 30px;
        }

        .station { 
            border: 1px solid var(--border-color); 
