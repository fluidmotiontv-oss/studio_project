        let currentLat = -35.1685;
        let currentLon = 173.1368;
        let activeNodeName = "AHIPARA NODE";

        // Leaflet Mapping
        let map;
        let marker;

        function initMap() {
            try {
                if (typeof L !== 'undefined') {
                    map = L.map('map', {
                        zoomControl: true,
                        attributionControl: false
