<script>
    let registeredAlbums = [];
    let selectedCatalogAlbum = null;

    function syncThemeToIframe() {
        const iframe = document.getElementById('viewport-iframe');
        if (!iframe || !iframe.contentWindow) return;
        try {
            const theme = document.body.className || '';
            iframe.contentWindow.postMessage({ type: 'dragon-theme-sync', theme }, '*');
        } catch (err) {
            console.warn('Theme sync to iframe skipped:', err);
        }
    }

    window.triggerGithubTimeSync = async function() {
        const indicator = document.getElementById('gh-sync-indicator');
        if (indicator) indicator.textContent = 'GH-SYNC: WAIT';
        try {
            const response = await fetch('https://timeapi.io/api/Time/current/zone?timeZone=UTC');
            if (!response.ok) throw new Error('Clock sync failed');
            const data = await response.json();
            const now = new Date(data.dateTime);
            const clockEl = document.getElementById('header-standard-clock');
            if (clockEl) clockEl.textContent = now.toISOString().slice(11, 19) + ' UTC';
            if (indicator) indicator.textContent = 'GH-SYNC: OK';
        } catch (err) {
            console.warn('GitHub time sync unavailable:', err);
            if (indicator) indicator.textContent = 'GH-SYNC: OFFLINE';
        }
    };

    function toggleShopCatalogModal() {
        const modal = document.getElementById('catalog-modal');
        if (modal) {
            const isVisible = modal.style.display === 'flex';
            modal.style.display = isVisible ? 'none' : 'flex';
            if (!isVisible) {
                loadShopCatalog();
            }
        }
    }

    async function loadShopCatalog() {
        const container = document.getElementById('catalog-list');
        if (!container) return;
        container.innerHTML = '<div style="color: var(--text-muted); font-family: \'Share Tech Mono\'; font-size: 0.7rem; text-align: center; padding: 15px;">Retrieving registered vault nodes...</div>';

        try {
            const response = await fetch('/api/get-shop-albums');
            if (response.ok) {
                const res = await response.json();
                registeredAlbums = res.albums || [];
                renderShopCatalog();
            } else {
                container.innerHTML = '<div style="color: var(--alert); font-family: \'Share Tech Mono\'; font-size: 0.7rem; text-align: center; padding: 15px;">Failed to retrieve cooperative registry.</div>';
            }
        } catch (err) {
            const localList = JSON.parse(localStorage.getItem('d9_local_registered_albums') || '[]');
            registeredAlbums = localList;
            renderShopCatalog();
        }
    }

    function renderShopCatalog() {
        const container = document.getElementById('catalog-list');
        if (!container) return;

        if (registeredAlbums.length === 0) {
            container.innerHTML = '<div style="color: var(--text-muted); font-family: \'Share Tech Mono\'; font-size: 0.7rem; text-align: center; padding: 15px;">No independent albums registered yet.</div>';
            return;
        }

        container.innerHTML = '';
        registeredAlbums.forEach((album, idx) => {
            const item = document.createElement('div');
            item.style.padding = '8px';
            item.style.borderBottom = '1px solid rgba(255, 255, 255, 0.05)';
            item.style.display = 'flex';
            item.style.justifyContent = 'space-between';
            item.style.alignItems = 'center';
            item.style.gap = '10px';

            const info = document.createElement('div');
            info.style.flexGrow = '1';
            info.style.fontFamily = "'Share Tech Mono', monospace";
            info.style.fontSize = '0.7rem';
            info.innerHTML = `
                <div style="color: #fff; font-weight: bold; font-family: 'Orbitron'; font-size: 0.75rem;">${album.title.toUpperCase()}</div>
                <div style="color: var(--accent);">Artist: ${album.artist} | Listed Price: ${album.price}</div>
                <div style="color: var(--text-muted); font-size: 0.6rem; margin-top: 2px;">${album.description || ''}</div>
            `;

            const btn = document.createElement('button');
            btn.innerText = 'BUY VAULT';
            btn.style.fontFamily = "'Orbitron', sans-serif";
            btn.style.fontSize = '0.55rem';
            btn.style.padding = '4px 8px';
            btn.style.border = '1px solid var(--highlight)';
            btn.style.borderRadius = '4px';
            btn.style.color = '#fff';
            btn.style.background = 'rgba(0, 229, 255, 0.15)';
            btn.style.cursor = 'pointer';
            btn.onclick = () => openCheckoutSplit(idx);

            item.appendChild(info);
            item.appendChild(btn);
            container.appendChild(item);
        });
    }

    async function registerCatalogAlbumDirect() {
        const title = document.getElementById('reg-album-title').value.trim();
        const artist = document.getElementById('reg-album-artist').value.trim();
        const url = document.getElementById('reg-album-url').value.trim();
        const price = document.getElementById('reg-album-price').value.trim() || '$10.00 USD';
        const payment = document.getElementById('reg-album-payment').value.trim() || 'D9_LOVE';
        const description = document.getElementById('reg-album-desc').value.trim() || 'Sovereign cloud-hosted portfolio release.';

        if (!title || !artist || !url) {
            alert('⚠️ Please fill in Title, Artist, and Cloud URL!');
            return;
        }

        try {
            const response = await fetch('/api/register-shop-album', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title, artist, url, price, payment, description })
            });

            if (response.ok) {
                alert('🚀 Album successfully registered to Dragon 9 Cooperative Shop Catalog!');
                document.getElementById('reg-album-title').value = '';
                document.getElementById('reg-album-artist').value = '';
                document.getElementById('reg-album-url').value = '';
                document.getElementById('reg-album-price').value = '';
                document.getElementById('reg-album-payment').value = '';
                document.getElementById('reg-album-desc').value = '';
                loadShopCatalog();
            } else {
                const err = await response.json();
                alert('⚠️ Failed to register album: ' + err.message);
            }
        } catch (err) {
            const localList = JSON.parse(localStorage.getItem('d9_local_registered_albums') || '[]');
            if (!localList.some(a => a.url === url)) {
                localList.push({ title, artist, url, price, payment, description, timestamp: Math.floor(Date.now() / 1000) });
                localStorage.setItem('d9_local_registered_albums', JSON.stringify(localList));
                alert('🚀 Registered local test album (offline simulation mode).');
                loadShopCatalog();
            } else {
                alert('⚠️ Duplicate URL registered locally.');
            }
        }
    }

    function openCheckoutSplit(idx) {
        selectedCatalogAlbum = registeredAlbums[idx];
        if (!selectedCatalogAlbum) return;

        document.getElementById('split-item-name').innerText = selectedCatalogAlbum.title;
        document.getElementById('split-item-artist').innerText = selectedCatalogAlbum.artist;
        document.getElementById('split-item-price').innerText = selectedCatalogAlbum.price;

        let numVal = 10.0;
        let isHNotes = false;
        let unit = 'USD';

        if (selectedCatalogAlbum.price.toLowerCase().includes('h-notes')) {
            numVal = parseFloat(selectedCatalogAlbum.price) || 10;
            isHNotes = true;
            unit = 'H-Notes';
        } else {
            const matches = selectedCatalogAlbum.price.match(/[\d.]+/);
            if (matches) {
                numVal = parseFloat(matches[0]);
            }
        }

        const salesCount = selectedCatalogAlbum.sales_count || 0;
        const hasFee = salesCount >= 54;
        const platformCut = hasFee ? numVal * 0.01 : 0;
        const artistCut = hasFee ? numVal * 0.99 : numVal;

        // Update labels dynamically
        const labelArtist = hasFee ? "99% Direct support to Artist" : "100% Direct support to Artist (Intro Wave)";
        const labelPlatform = hasFee ? "1% Co-op Commission to Dragon 9" : "0% Co-op Commission (Waived for first 54 sales!)";
        
        document.getElementById('label-artist-split').innerText = labelArtist;
        document.getElementById('label-platform-split').innerText = labelPlatform;

        const noteEl = document.getElementById('split-checkout-note');
        if (noteEl) {
            if (hasFee) {
                noteEl.innerText = "By completing this purchase, you support off-grid local nodes directly while routing 1% to the platform node framework for offline PWA operations.";
            } else {
                noteEl.innerText = `By completing this purchase, 100% of the payment goes directly to the artist. The 1% platform commission is waived (Album sales: ${salesCount}/54).`;
            }
        }

        if (isHNotes) {
            document.getElementById('split-artist-amount').innerText = `${artistCut.toFixed(2)} H-Notes`;
            document.getElementById('split-platform-amount').innerText = `${platformCut.toFixed(2)} H-Notes`;
        } else {
            document.getElementById('split-artist-amount').innerText = `$${artistCut.toFixed(2)} USD`;
            document.getElementById('split-platform-amount').innerText = `$${platformCut.toFixed(2)} USD`;
        }

        const completeBtn = document.getElementById('btn-complete-split-purchase');
        completeBtn.onclick = () => executeSplitPurchase(isHNotes, artistCut, platformCut, hasFee, salesCount);

        const modal = document.getElementById('checkout-split-modal');
        if (modal) modal.style.display = 'flex';
    }

    function closeCheckoutSplitModal() {
        const modal = document.getElementById('checkout-split-modal');
        if (modal) modal.style.display = 'none';
    }

    function executeSplitPurchase(isHNotes, artistCut, platformCut, hasFee, salesCount) {
        if (!selectedCatalogAlbum) return;

        // Record sale counter to server
        fetch('/api/record-album-sale', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url: selectedCatalogAlbum.url })
        }).then(res => {
            if (res.ok) {
                console.log("Album sale recorded on server.");
            }
        }).catch(() => {
            console.log("Recorded album sale offline.");
        });

        // Offline local update fallback
        const localList = JSON.parse(localStorage.getItem('d9_local_registered_albums') || '[]');
        const localAlbum = localList.find(a => a.url === selectedCatalogAlbum.url);
        if (localAlbum) {
            localAlbum.sales_count = (localAlbum.sales_count || 0) + 1;
            localStorage.setItem('d9_local_registered_albums', JSON.stringify(localList));
        }

        if (isHNotes) {
            if (hasFee) {
                alert(`💳 Double-Entry Ledger Transaction:\n\nRouted ${artistCut.toFixed(2)} H-Notes to artist wallet address: ${selectedCatalogAlbum.payment || 'D9_LOVE'}.\nRouted ${platformCut.toFixed(2)} H-Notes (1% Platform fee) to Dragon 9 Co-op.`);
            } else {
                alert(`💳 Double-Entry Ledger Transaction (Intro Wave):\n\nRouted ${artistCut.toFixed(2)} H-Notes (100% payout) to artist wallet address: ${selectedCatalogAlbum.payment || 'D9_LOVE'}.\n0% Platform fee applied (Album sales: ${salesCount}/54).`);
            }
        } else {
            const paypalArtist = `https://www.paypal.com/cgi-bin/webscr?cmd=_xclick&business=${encodeURIComponent(selectedCatalogAlbum.payment || 'fluidmotion.tv@gmail.com')}&item_name=Artist+Payout+for+${encodeURIComponent(selectedCatalogAlbum.title)}&amount=${artistCut.toFixed(2)}&currency_code=USD`;
            
            if (hasFee) {
                const paypalCoop = `https://www.paypal.com/cgi-bin/webscr?cmd=_xclick&business=fluidmotion.tv%40gmail.com&item_name=Platform+Commission+for+${encodeURIComponent(selectedCatalogAlbum.title)}&amount=${platformCut.toFixed(2)}&currency_code=USD`;

                alert(`🔗 Open PayPal Checkout Split:\n\nFirst transaction: $${artistCut.toFixed(2)} USD goes to the artist.\nSecond transaction: $${platformCut.toFixed(2)} USD (1% platform fee) supports Dragon 9 platform maintenance.\n\nPress OK to open the artist transaction.`);
                window.open(paypalArtist, '_blank');
                setTimeout(() => {
                    window.open(paypalCoop, '_blank');
                }, 1000);
            } else {
                alert(`🔗 Open PayPal Checkout (Intro Wave):\n\n100% of payment ($${artistCut.toFixed(2)} USD) goes to the artist. Platform fee is waived.\n\nPress OK to proceed to PayPal.`);
                window.open(paypalArtist, '_blank');
            }
        }

        alert(`🎉 Purchase completed successfully!\n\nOpen Cloud Hosted Album: ${selectedCatalogAlbum.url}`);
        window.open(selectedCatalogAlbum.url, '_blank');
        closeCheckoutSplitModal();
        toggleShopCatalogModal();
    }
</script>
