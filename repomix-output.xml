import * as THREE from '../three.module.min.js';

// --- GAME STATE ---
const state = {
    // Gameplay
    score: 0,
    highScore: parseInt(localStorage.getItem('d9_racer_highscore') || '0', 10),
    shield: 100,
    speedMultiplier: 1.0,
