            color: var(--accent-gold);
            text-shadow: 0 0 8px rgba(212, 175, 55, 0.4);
        }

        /* Shield Indicator Bar */
        .shield-bar-container {
            width: 100px;
            height: 6px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 3px;
