            balance -= price;
            localStorage.setItem('d9_user_hnotes', balance.toString());
            document.getElementById('user-hnotes-balance').innerText = balance;

            // Save purchased track URL
            const purchased = JSON.parse(localStorage.getItem('d9_purchased_tracks') || '[]');
            if (!purchased.includes(track.url)) {
                purchased.push(track.url);
                localStorage.setItem('d9_purchased_tracks', JSON.stringify(purchased));
            }

            // Notify server about purchase to route H-Notes to artist
            try {
                await fetch('/api/record-purchase', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        artist: currentSettings.artistName || "Unknown Artist",
