                <button class="pro-upgrade-btn" id="pro-upgrade-action-btn" style="background: rgba(255,255,255,0.05); color: var(--accent); border: 1px solid var(--border-color); box-shadow: none;">ACTIVATE SESSION FOR FREE / DONATOR</button>
