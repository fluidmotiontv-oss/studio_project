    <!-- QRious QR Code Generator -->
    <script src="../lib/qrious.min.js"></script>
    <style>
        :root {
            --red: #ff2200;
            --red-glow: rgba(255, 34, 0, 0.3);
            --bg-dark: #0a0505;
            --panel-bg: rgba(20, 10, 10, 0.75);
            --text-color: #ffcccc;
            --accent: #ff2200;
            --highlight: #00ff41; /* Matrix green */
            --amber: #ffaa00;
            --blue: #00e5ff;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body { 
            background: var(--bg-dark); 
            color: var(--text-color); 
