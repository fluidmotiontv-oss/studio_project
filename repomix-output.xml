<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dragon 9 | Systems Suite Hub</title>
    <!-- Google Fonts Integration -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="scripts/night_fish.css">
    <style>
        :root {
            --bg-color: #020205;
            --accent: #d4af37;
            --accent-glow: rgba(212, 175, 55, 0.25);
            --highlight: #00e5ff;
            --highlight-glow: rgba(0, 229, 255, 0.25);
            --text-main: #f4e4bc;
            --text-muted: #6b5c82;
            --card-bg: rgba(10, 10, 15, 0.7);
            --border-color: rgba(0, 229, 255, 0.15);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            overflow-y: auto;
            position: relative;
            padding: 40px 20px;
        }

        /* Ambient scanline grids */
        body::before {
            content: " ";
            display: block;
            position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.3) 50%), 
                        linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px),
                        linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px);
            z-index: 1;
            background-size: 100% 4px, 30px 30px, 30px 30px;
            pointer-events: none;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            position: relative;
            z-index: 10;
        }

        /* Header design */
        header {
            text-align: center;
            margin-bottom: 30px;
            padding: 40px;
            background: rgba(5, 5, 8, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.9), 0 0 25px var(--highlight-glow);
            position: relative;
        }

        .hub-switch-link {
            position: absolute;
            top: 20px;
            right: 20px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.7rem;
            letter-spacing: 1px;
            color: var(--text-muted);
            text-decoration: none;
            padding: 8px 16px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.02);
            transition: all 0.3s ease;
            text-transform: uppercase;
        }

        .hub-switch-link:hover {
            border-color: var(--highlight);
            color: var(--highlight);
            box-shadow: 0 0 10px var(--highlight-glow);
        }

        .header-title {
