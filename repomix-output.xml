            }

            const paymentDest = document.getElementById('new-video-payment').value.trim() || currentSettings.vaultKey || "D9_LOVE";
            const confirmCash = confirm(`💸 Cash Out Earnings?\n\nYou are converting ${balance} H-Notes to $${(balance * 0.10).toFixed(2)} USD.\nFunds will be wired to your direct payment address:\n\n"${paymentDest}"\n\nClick OK to confirm.`);
            if (!confirmCash) return;

            try {
                const response = await fetch('/api/artist-cashout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        artist: artistName,
                        amount: balance
                    })
                });
                if (!response.ok) throw new Error("Backend cashout failed");
            } catch (err) {
                const localWithdrawals = JSON.parse(localStorage.getItem('d9_artist_local_withdrawals') || '{}');
                localWithdrawals[artistName] = (localWithdrawals[artistName] || 0) + balance;
                localStorage.setItem('d9_artist_local_withdrawals', JSON.stringify(localWithdrawals));
            }

            alert("🎉 Cash-out request submitted successfully!\n\nYour H-Notes are now being processed by the Dragon 9 off-grid ledger network. Payment will arrive at your address shortly.");
            loadArtistEarnings();
