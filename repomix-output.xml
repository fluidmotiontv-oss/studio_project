            text-shadow: 0 0 10px var(--gold-glow);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo span {
            color: var(--gold);
        }

        .nav-group {
            display: flex;
            align-items: center;
            gap: 15px;
