            localStorage.setItem('d9_listening_hours', hours.toFixed(1));
            document.getElementById('user-listening-hours').innerText = hours.toFixed(1);

            const fbShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(refLink)}`;

            alert(`🤝 Collaboration Message Copied for ${name.trim()}!\n\nMessage:\n"${message}"\n\nReferral bonus of +2.0 Listening Hours credited! Press OK to open Facebook to send it to them.`);
            window.open(fbShareUrl, '_blank');
        }

        function openCommentModal() {
            const comment = prompt("💬 Submit Track Feedback / Review:\n\nType your comment below to support this artist and boost your hours!");
            if (!comment || !comment.trim()) return;

            let hours = parseFloat(localStorage.getItem('d9_listening_hours') || '0.0');
            hours += 2.0;
            localStorage.setItem('d9_listening_hours', hours.toFixed(1));
            document.getElementById('user-listening-hours').innerText = hours.toFixed(1);

            alert("💬 Comment Submitted!\n\nSocial engagement bonus of +2.0 Listening Hours credited to your ledger.");
        }

        function openBuyNotesModal() {
            const amount = prompt("🔋 Top Up H-Notes Wallet:\n\nChoose a pack to buy:\n1. 50 H-Notes ($5.00 USD)\n2. 120 H-Notes ($10.00 USD)\n3. 300 H-Notes ($20.00 USD)\n\nEnter the pack number (1, 2, or 3):");
            if (!amount) return;

            let addNotes = 0;
            let cost = 0;
            if (amount === '1') { addNotes = 50; cost = 5.00; }
            else if (amount === '2') { addNotes = 120; cost = 10.00; }
            else if (amount === '3') { addNotes = 300; cost = 20.00; }
            else {
                alert("Invalid selection.");
                return;
            }

            const payConfirm = confirm(`Secure Gateway Checkout:\n\nCharge $${cost.toFixed(2)} USD to your card/wallet for ${addNotes} H-Notes?\n\nPress OK to authorize payment.`);
            if (!payConfirm) return;

            let balance = parseInt(localStorage.getItem('d9_user_hnotes') || '50');
            balance += addNotes;
            localStorage.setItem('d9_user_hnotes', balance.toString());
            document.getElementById('user-hnotes-balance').innerText = balance;

            alert(`🔋 Wallet Top-up Successful!\n\nCredited ${addNotes} H-Notes. New Wallet Balance: ${balance} H-Notes.`);
        }

        let originalTracksBackup = null;

        function switchStreamFunnel() {
            const selectEl = document.getElementById('stream-funnel');
            const funnel = selectEl.value;
            
            if (funnel === 'clear_blank') {
                selectEl.value = 'album';
                resetToBlankAlbumTemplate();
                return;
            }
            
            if (!originalTracksBackup) {
                originalTracksBackup = [...currentSettings.tracks];
            }

            if (funnel === 'album') {
                currentSettings.tracks = [...originalTracksBackup];
            } else if (funnel === 'hot26') {
                const shuffled = [...originalTracksBackup].sort(() => 0.5 - Math.random());
                currentSettings.tracks = [];
                for (let i = 0; i < 26; i++) {
                    const trackTemplate = shuffled[i % shuffled.length];
                    if (trackTemplate.url !== "night-fish-holo") {
                        currentSettings.tracks.push({
                            title: `[TOP ${i+1}] ${trackTemplate.title}`,
                            url: trackTemplate.url,
                            desc: `Trending Hot 26 Stream Segment #${i+1}. Loops continuously.`,
                            price: 0
                        });
                    }
                }
                window.location.href = "radio/index.html";
                return;
            }

            renderAlbumTracks();
        }

        // Real-time listening hour credit tracker
        setInterval(() => {
            let isPlaying = false;
            const audios = document.querySelectorAll('audio');
            audios.forEach(aud => {
                if (!aud.paused && !aud.ended) isPlaying = true;
            });
            const videos = document.querySelectorAll('video');
            videos.forEach(vid => {
                if (!vid.paused && !vid.ended) isPlaying = true;
            });

            if (isPlaying) {
                let hours = parseFloat(localStorage.getItem('d9_listening_hours') || '0.0');
                const mult = parseFloat(localStorage.getItem('d9_boost_multiplier') || '1.0');
                
                hours += (0.005 * mult);
                localStorage.setItem('d9_listening_hours', hours.toFixed(1));
                
                const hoursEl = document.getElementById('user-listening-hours');
                if (hoursEl) hoursEl.innerText = hours.toFixed(1);
            }
        }, 10000);

        // Sync ledger stats on load
        setTimeout(() => {
            const hnotesBal = localStorage.getItem('d9_user_hnotes') || '50';
            localStorage.setItem('d9_user_hnotes', hnotesBal);
            const userBalEl = document.getElementById('user-hnotes-balance');
            if (userBalEl) userBalEl.innerText = hnotesBal;

            const listHours = localStorage.getItem('d9_listening_hours') || '0.0';
            localStorage.setItem('d9_listening_hours', listHours);
            const userHoursEl = document.getElementById('user-listening-hours');
            if (userHoursEl) userHoursEl.innerText = listHours;

            const boostMult = localStorage.getItem('d9_boost_multiplier') || '1.0';
            localStorage.setItem('d9_boost_multiplier', boostMult);
            const userBoostEl = document.getElementById('user-boost-multiplier');
            if (userBoostEl) userBoostEl.innerText = `${boostMult}x`;

            const artistNameInput = document.getElementById('artist-name');
            if (artistNameInput) {
                artistNameInput.addEventListener('input', loadArtistEarnings);
                artistNameInput.addEventListener('change', loadArtistEarnings);
            }
        }, 200);

        // Initialize Settings
        loadAdminSettings();

        // Check for collaboration invite query parameter
        const urlParams = new URLSearchParams(window.location.search);
        const collabName = urlParams.get('collab');
        if (collabName) {
            setTimeout(() => {
                alert(`🤝 Welcome to the Sovereign Album Builder!\n\nYou've been invited by a fellow artist to collaborate on a portable, password-secured digital music release.\n\nUse the tools here to customize tracks, edit descriptions, and build your shared release vault!`);
            }, 1500);
        }

        // --- INTERACTIVE FLUID CANVAS ---
        const canvas = document.createElement('canvas');
        canvas.style.position = 'fixed';
        canvas.style.top = '0';
        canvas.style.left = '0';
        canvas.style.width = '100vw';
        canvas.style.height = '100vh';
        canvas.style.zIndex = '1';
        canvas.style.pointerEvents = 'none';
        document.body.prepend(canvas);

        const ctx = canvas.getContext('2d');
        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

        const particles = [];
        for (let i = 0; i < 40; i++) {
            particles.push({
                x: Math.random() * width,
                y: Math.random() * height,
                vx: (Math.random() - 0.5) * 0.4,
                vy: (Math.random() - 0.5) * 0.4,
                radius: Math.random() * 2 + 1,
                alpha: Math.random() * 0.5 + 0.1
            });
        }

        function drawParticles() {
            ctx.clearRect(0, 0, width, height);
            
            // Draw gradient background flow
            const grad = ctx.createRadialGradient(width/2, height/2, 10, width/2, height/2, width*0.8);
            grad.addColorStop(0, '#0a0a14');
            grad.addColorStop(1, '#020205');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, width, height);

            const accentColor = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#d4af37';
            ctx.strokeStyle = accentColor;
            ctx.fillStyle = accentColor;

            particles.forEach((p, idx) => {
                p.x += p.vx;
                p.y += p.vy;

                if (p.x < 0 || p.x > width) p.vx *= -1;
                if (p.y < 0 || p.y > height) p.vy *= -1;

                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(212, 175, 55, ${p.alpha})`;
                ctx.fill();

                for (let j = idx + 1; j < particles.length; j++) {
                    const p2 = particles[j];
                    const dist = Math.hypot(p.x - p2.x, p.y - p2.y);
                    if (dist < 180) {
                        ctx.beginPath();
                        ctx.moveTo(p.x, p.y);
                        ctx.lineTo(p2.x, p2.y);
                        ctx.strokeStyle = `rgba(212, 175, 55, ${(1 - dist/180) * 0.08})`;
                        ctx.stroke();
                    }
                }
            });
            requestAnimationFrame(drawParticles);
        }
        drawParticles();

        function handleKey(e) {
            if (e.key === 'Enter') {
                attemptDecrypt();
            }
        }

        function attemptDecrypt() {
            const val = document.getElementById('vault-pass').value.trim();
            const err = document.getElementById('error-alert');
            const lock = document.getElementById('lock-screen');
            const portal = document.getElementById('portal-view');

            const key = currentSettings.vaultKey || "D9_LOVE";

            if (val === key || val.toLowerCase() === key.toLowerCase()) {
                err.classList.remove('visible');
                lock.style.opacity = '0';
                lock.style.transform = 'translateY(-100vh)';
                
                setTimeout(() => {
                    lock.style.display = 'none';
                    portal.style.display = 'flex';
                    initInfinityScroll();
                }, 800);
            } else {
                err.classList.add('visible');
                setTimeout(() => { err.classList.remove('visible'); }, 3000);
            }
        }

        // --- 3D PERSPECTIVE COVERFLOW EFFECTS ---
        function update3DCardEffects() {
            const menu = document.getElementById('flow-menu');
            if (!menu) return;
            const cards = menu.querySelectorAll('.track-card');
            const menuCenter = menu.scrollLeft + menu.offsetWidth / 2;

            cards.forEach(card => {
                const cardCenter = card.offsetLeft + card.offsetWidth / 2;
                const distance = cardCenter - menuCenter;
                const absDistance = Math.abs(distance);
                
                const maxDistance = 450; 
                const factor = Math.min(1, absDistance / maxDistance);
                
                const scale = 1 - factor * 0.15; 
                const rotateY = -distance * 0.04; 
                const translateZ = -factor * 120; 
                const opacity = 1 - factor * 0.45; 

                card.style.transform = `scale(${scale}) rotateY(${Math.max(-25, Math.min(25, rotateY))}deg) translateZ(${translateZ}px)`;
                card.style.opacity = opacity;
                card.style.zIndex = Math.round(100 - factor * 10);
            });

            // Update dot indicators
            const dots = document.querySelectorAll('.carousel-dot');
            if (dots.length > 0) {
                let closestDotIndex = -1;
                let minDistance = Infinity;

                // Find the original track card closest to center
                const originalCards = Array.from(cards).filter(c => !c.classList.contains('clone'));
                if (originalCards.length > 0) {
                    originalCards.forEach((card, index) => {
                        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
                        const distance = Math.abs(cardCenter - menuCenter);
                        if (distance < minDistance) {
                            minDistance = distance;
                            closestDotIndex = index;
                        }
                    });
                } else {
                    cards.forEach((card, index) => {
                        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
                        const distance = Math.abs(cardCenter - menuCenter);
                        if (distance < minDistance) {
                            minDistance = distance;
                            closestDotIndex = index % dots.length;
                        }
                    });
                }

                if (closestDotIndex >= 0 && closestDotIndex < dots.length) {
                    dots.forEach((dot, idx) => {
                        if (idx === closestDotIndex) {
                            dot.style.background = 'var(--accent)';
                            dot.style.boxShadow = '0 0 10px var(--accent-glow)';
                            dot.style.transform = 'scale(1.25)';
                            dot.style.width = '16px';
                            dot.style.borderRadius = '5px';
                        } else {
                            dot.style.background = 'rgba(255, 255, 255, 0.2)';
                            dot.style.boxShadow = 'none';
                            dot.style.transform = 'scale(1)';
                            dot.style.width = '10px';
                            dot.style.borderRadius = '50%';
                        }
                    });
                }
            }
        }

        // --- INFINITY LOOPING SCROLL ---
        function initInfinityScroll() {
            const menu = document.getElementById('flow-menu');
            if (!menu) return;
            
            // Clean up any cloned nodes first to start fresh and avoid duplicate clones
            const originalCards = Array.from(menu.querySelectorAll('.track-card:not(.clone)'));
            if (originalCards.length === 0) return;
            
            // Re-render clean list of originals
            menu.innerHTML = '';
            originalCards.forEach(card => {
                card.classList.remove('clone');
                menu.appendChild(card);
            });

            // Clone before and after
            originalCards.forEach(card => {
                const cloneBefore = card.cloneNode(true);
                cloneBefore.classList.add('clone');
                const cloneAfter = card.cloneNode(true);
                cloneAfter.classList.add('clone');
                menu.insertBefore(cloneBefore, menu.firstChild);
                menu.appendChild(cloneAfter);
            });

            const cardWidth = originalCards[0].offsetWidth + 50; 
            const totalOriginalWidth = originalCards.length * cardWidth;
            menu.scrollLeft = totalOriginalWidth;

            if (!menu.dataset.listenerBound) {
                menu.addEventListener('scroll', () => {
                    if (menu.scrollLeft <= 50) {
                        menu.scrollLeft += totalOriginalWidth;
                    } else if (menu.scrollLeft >= totalOriginalWidth * 2 - 100) {
                        menu.scrollLeft -= totalOriginalWidth;
                    }
                    update3DCardEffects();
                });

                menu.addEventListener('wheel', (e) => {
                    if (e.deltaY !== 0) {
                        e.preventDefault();
                        menu.scrollLeft += e.deltaY;
                    }
                }, { passive: false });

                menu.dataset.listenerBound = 'true';
            }

            // Initial calculation
            setTimeout(update3DCardEffects, 250);
        }

        // --- CAROUSEL NAVIGATION HELPERS ---
        function scrollCarousel(direction) {
            const menu = document.getElementById('flow-menu');
            if (!menu) return;
            const cards = menu.querySelectorAll('.track-card');
            if (cards.length === 0) return;
            
            const cardWidth = cards[0].offsetWidth + 50; // card width + gap
            menu.scrollBy({
                left: direction * cardWidth,
                behavior: 'smooth'
            });
        }

        function scrollToTrack(index) {
            const menu = document.getElementById('flow-menu');
            if (!menu) return;
            const originalCards = Array.from(menu.querySelectorAll('.track-card:not(.clone)'));
            if (originalCards.length === 0) return;

            const targetCard = originalCards[index];
            if (!targetCard) return;

            const targetScrollLeft = targetCard.offsetLeft - (menu.offsetWidth - targetCard.offsetWidth) / 2;
            menu.scrollTo({
                left: targetScrollLeft,
                behavior: 'smooth'
            });
        }
    </script>
    <!-- Immersive Video Theater Screen -->
    <div id="theater-overlay" onclick="closeTheaterMode()">
        <div class="theater-close-btn" onclick="closeTheaterMode()">&times;</div>
        <div class="theater-container" onclick="event.stopPropagation()">
            <div id="theater-video-wrap" style="width:100%; height:100%;"></div>
        </div>
    </div>

    <!-- Direct Checkout & Support Modal -->
    <div id="checkout-modal" onclick="closeCheckout()">
        <div class="checkout-card" onclick="event.stopPropagation()">
            <div style="font-size: 1.3rem; margin-bottom: 12px; color: var(--accent); font-family:'Orbitron'; font-weight:bold;">Direct Support Checkout</div>
            <div style="font-size: 0.8rem; margin-bottom: 20px; line-height: 1.4; color: #fff;">
                You are purchasing direct download access for:<br>
                <strong id="checkout-track-title" style="color: var(--highlight);">Track Title</strong>
            </div>
            <div style="background: rgba(0,0,0,0.5); padding: 12px; border-radius: 8px; margin-bottom: 20px; text-align: left; font-size: 0.75rem;">
                <div>Direct Price: <strong id="checkout-track-price" style="color: var(--accent);">5 H-Notes</strong></div>
                <div style="margin-top: 6px;">Artist Address:</div>
                <div id="checkout-track-payment" style="color: #888; font-size: 0.65rem; word-break: break-all; font-family: monospace;">direct_address</div>
            </div>
            <div style="display: flex; gap: 8px; justify-content: center;">
                <button class="admin-save-btn" onclick="confirmPurchase()" style="margin: 0; background: rgba(0, 229, 255, 0.15); border: 1.5px solid var(--accent); color: #fff; cursor:pointer;">CONFIRM & DECRYPT</button>
                <button class="admin-save-btn" onclick="closeCheckout()" style="margin: 0; background: rgba(255,255,255,0.05); color: #888; border: 1px solid rgba(255,255,255,0.1); cursor:pointer;">CANCEL</button>
            </div>
        </div>
    </div>

    <script type="module" src="scripts/night_fish_assistant.js"></script>
</body>
