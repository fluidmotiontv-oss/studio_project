            height: 380px;
            border-radius: 12px;
            background: rgba(0, 0, 0, 0.45);
            border: 1px solid var(--border);
            overflow: hidden;
            position: relative;
            cursor: grab;
        }

        #carousel-3d-container:active {
            cursor: grabbing;
        }

        /* Action button styles */
        .action-btn {
            background: rgba(0, 229, 255, 0.04);
            border: 1px solid rgba(0, 229, 255, 0.3);
            color: var(--text);
            padding: 8px 18px;
            border-radius: 6px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            cursor: pointer;
            transition: all 0.2s;
            outline: none;
        }

        .action-btn:hover {
            background: rgba(0, 229, 255, 0.1);
            border-color: var(--accent);
            box-shadow: 0 0 10px var(--accent-glow);
        }

        /* Lightbox modal style */
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(5, 5, 8, 0.9);
            backdrop-filter: blur(12px);
            z-index: 1000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

        .modal.open {
            display: flex;
        }

        .modal-content {
            max-width: 1100px;
            width: 100%;
            background: #0d0d12;
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            display: grid;
            grid-template-columns: 1.3fr 1fr;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
            position: relative;
        }

        @media (max-width: 850px) {
            .modal-content {
                grid-template-columns: 1fr;
                height: 85vh;
                overflow-y: auto;
            }
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 2rem;
            color: var(--text);
            cursor: pointer;
            z-index: 10;
            transition: color 0.2s;
        }

        .modal-close:hover {
            color: var(--secondary);
        }

        .modal-image-panel {
            background: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            max-height: 600px;
        }

        .modal-image-panel img {
            max-width: 100%;
            max-height: 500px;
            object-fit: contain;
            border-radius: 4px;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
        }

        .modal-info-panel {
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border-left: 1px solid var(--border);
        }

        @media (max-width: 850px) {
            .modal-info-panel {
                border-left: none;
                border-top: 1px solid var(--border);
            }
        }

        .modal-header h2 {
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: 2px;
            background: linear-gradient(45deg, var(--accent), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .modal-telemetry-box {
            background: rgba(0,0,0,0.3);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 15px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.75rem;
            line-height: 1.8;
            margin: 20px 0;
        }

        .telemetry-row {
            display: flex;
            justify-content: space-between;
        }

        .telemetry-row span:first-child {
            color: var(--text-muted);
        }

        .telemetry-row span:last-child {
            color: var(--accent);
        }

        .modal-footer {
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.5;
        }

        /* Projector Mode Styles */
        .projector-slot {
            position: absolute;
            width: 72px;
            height: 72px;
            border: 1px dashed rgba(255, 255, 255, 0.25);
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            background: rgba(10, 10, 15, 0.85);
            transform: translate(-50%, -50%);
            z-index: 10;
        }
        .projector-slot:hover {
            border: 1.5px solid var(--accent);
            box-shadow: 0 0 15px var(--accent-glow);
            transform: translate(-50%, -50%) scale(1.1);
        }
        .projector-slot.active-slot {
            border: 2px solid var(--accent);
            background: rgba(0, 229, 255, 0.15);
            box-shadow: 0 0 20px var(--accent-glow);
            animation: slotPulse 2.5s infinite;
        }
        .projector-slot-title {
            font-size: 0.45rem;
            text-align: center;
            color: var(--text);
            margin-top: 4px;
            font-family: 'Share Tech Mono', monospace;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            width: 65px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .projector-wireframe-icon {
            font-size: 1.1rem;
            animation: spin-slow 12s linear infinite;
        }
        
        @keyframes spin-slow {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        @keyframes slotPulse {
            0% { border-color: var(--accent); box-shadow: 0 0 10px var(--accent-glow); }
            50% { border-color: var(--secondary); box-shadow: 0 0 20px var(--secondary-glow); }
            100% { border-color: var(--accent); box-shadow: 0 0 10px var(--accent-glow); }
        }
        .projector-slot.active-slot .projector-img-wrapper {
            border-color: var(--accent) !important;
            box-shadow: 0 0 12px var(--accent-glow);
        }
    </style>
</head>
<body>

