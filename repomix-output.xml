                    })
                });
            } catch (err) {
                console.log("Local purchase recorded (offline mode).");
                const localLedger = JSON.parse(localStorage.getItem('d9_artist_local_ledger') || '{}');
                const artistKey = (currentSettings.artistName || "Unknown Artist").toLowerCase().trim();
                localLedger[artistKey] = (localLedger[artistKey] || 0) + price;
                localStorage.setItem('d9_artist_local_ledger', JSON.stringify(localLedger));
            }

            // Boost stats
            let hours = parseFloat(localStorage.getItem('d9_listening_hours') || '0.0');
            hours += 10.0;
            localStorage.setItem('d9_listening_hours', hours.toFixed(1));
            document.getElementById('user-listening-hours').innerText = hours.toFixed(1);

            alert(`🎉 Track Successfully Unlocked!\n\nDirect support price of ${price} H-Notes transferred to the artist's address.\nDownload button unlocked on the track card!`);
            closeCheckout();
            renderAlbumTracks();
        }

        async function loadArtistEarnings() {
            const artistName = (document.getElementById('artist-name').value || currentSettings.artistName || "Corey").toLowerCase().trim();
            let earnings = 0;
            let withdrawals = 0;

            try {
                const response = await fetch(`/api/get-artist-earnings?crew=${encodeURIComponent(artistName)}`);
                if (response.ok) {
                    const data = await response.json();
                    earnings = data.earnings || 0;
                    withdrawals = data.withdrawals || 0;
                }
