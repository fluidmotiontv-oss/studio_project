            cGroup = new THREE.Group();
            cScene.add(cGroup);

            // Lighting
            const ambient = new THREE.AmbientLight(0xffffff, 0.75);
            cScene.add(ambient);
            const point = new THREE.PointLight(0xffffff, 1.2, 20);
            point.position.set(0, 2, 4);
            cScene.add(point);

            // Create glowing wireframe track line
            const trackPoints = [];
            for (let i = 0; i <= 100; i++) {
                const t = (i / 100) * 2 * Math.PI;
                trackPoints.push(getLemniscatePosition(t, 2.0));
            }
            const trackGeo = new THREE.BufferGeometry().setFromPoints(trackPoints);
            const trackMat = new THREE.LineBasicMaterial({ 
                color: 0x00e5ff, 
                transparent: true, 
                opacity: 0.15,
                linewidth: 2
            });
            const trackLine = new THREE.LineLoop(trackGeo, trackMat);
            cGroup.add(trackLine);

            // Setup card geometry
            const cardGeometry = new THREE.PlaneGeometry(0.7, 0.48);

            // Create 54 visual placeholder cards
            carouselItems.forEach((item, idx) => {
                const canvas = document.createElement('canvas');
                canvas.width = 128;
                canvas.height = 80;
                const ctx = canvas.getContext('2d');

                // Tech grid pattern background
                const grad = ctx.createLinearGradient(0, 0, 0, 80);
                grad.addColorStop(0, '#0d0d18');
                grad.addColorStop(1, '#040409');
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, 128, 80);

                // Tech borders
                ctx.strokeStyle = 'rgba(0, 229, 255, 0.2)';
                ctx.lineWidth = 2;
                ctx.strokeRect(1, 1, 126, 78);

                // Tech circles
                ctx.strokeStyle = 'rgba(255, 0, 128, 0.15)';
                ctx.beginPath();
                ctx.arc(64, 40, 25, 0, Math.PI * 2);
                ctx.stroke();

                // Track Number
                ctx.fillStyle = '#d4af37';
                ctx.font = 'bold 13px "Share Tech Mono", monospace';
                ctx.textAlign = 'center';
                ctx.fillText(`FMTV-${String(idx + 1).padStart(2, '0')}`, 64, 28);

                // Small dynamic audio bar design
                ctx.fillStyle = 'rgba(0, 229, 255, 0.6)';
                for (let b = 0; b < 6; b++) {
                    const h = Math.abs(Math.sin(idx * 0.5 + b)) * 14 + 4;
                    ctx.fillRect(40 + b * 8, 56 - h, 5, h);
                }

                const texture = new THREE.CanvasTexture(canvas);
                const cardMat = new THREE.MeshBasicMaterial({
                    map: texture,
                    side: THREE.DoubleSide,
                    transparent: true,
                    opacity: 0.6
                });

                const cardMesh = new THREE.Mesh(cardGeometry, cardMat);
                cardMesh.userData = { index: idx };
                cGroup.add(cardMesh);
                carouselCards.push(cardMesh);
            });

            // Drag listeners
            carouselContainer.addEventListener('mousedown', (e) => {
                isCarouselDragging = true;
                prevCarouselMouseX = e.clientX;
            });

            window.addEventListener('mousemove', (e) => {
                if (isCarouselDragging) {
                    const deltaX = e.clientX - prevCarouselMouseX;
                    carouselScrollOffset -= deltaX * 0.0012; // dragging speed
                    prevCarouselMouseX = e.clientX;
                }
            });

            window.addEventListener('mouseup', () => {
                isCarouselDragging = false;
            });

            // Touch support for mobile/trackpad swipe
            carouselContainer.addEventListener('touchstart', (e) => {
                isCarouselDragging = true;
                prevCarouselMouseX = e.touches[0].clientX;
            });

            window.addEventListener('touchmove', (e) => {
                if (isCarouselDragging) {
                    const deltaX = e.touches[0].clientX - prevCarouselMouseX;
                    carouselScrollOffset -= deltaX * 0.0015;
                    prevCarouselMouseX = e.touches[0].clientX;
                }
            });

            window.addEventListener('touchend', () => {
                isCarouselDragging = false;
            });

            // Double Click to open lightbox
            carouselContainer.addEventListener('click', (e) => {
                const rect = carouselContainer.getBoundingClientRect();
                const cMouse = new THREE.Vector2();
                cMouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
                cMouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

                const cRay = new THREE.Raycaster();
                cRay.setFromCamera(cMouse, cCamera);
                const intersects = cRay.intersectObjects(carouselCards);

                if (intersects.length > 0) {
                    const clickedIdx = intersects[0].object.userData.index;
                    // If clicked node is the center active one, open lightbox
                    if (clickedIdx === lastActiveIdx) {
                        window.openLightbox(clickedIdx);
                    } else {
                        // Else, scroll to align click node to center front (t = 0.5 * Math.PI)
                        const currentT = (clickedIdx / 54) * 2 * Math.PI;
                        // solve offset to bring clicked card to t = 0.5 * PI
                        const targetOffset = (0.25 - (clickedIdx / 54));
                        carouselScrollOffset = targetOffset;
                    }
                }
            });

            window.addEventListener('resize', () => {
                if (!cRenderer || !cCamera) return;
                const w = carouselContainer.clientWidth;
                const h = carouselContainer.clientHeight;
                cCamera.aspect = w / h;
                cCamera.updateProjectionMatrix();
                cRenderer.setSize(w, h);
            });

            animateCarousel();
        }

        function updateActiveCarouselItemUI(idx) {
            const art = carouselItems[idx];
            if (!art) return;

            document.getElementById('active-item-title').innerText = art.title;
            document.getElementById('active-item-desc').innerText = `Sequence: ${art.core} // ${art.tag} // Parallax: ${art.parallax}`;
            document.getElementById('active-counter').innerText = `PIECE ${idx + 1} OF 54`;
        }

        function animateCarousel() {
            requestAnimationFrame(animateCarousel);

            // Interpolate current scroll position smoothly
            currentCarouselScrollOffset += (carouselScrollOffset - currentCarouselScrollOffset) * 0.15;

            // Position 54 cards along Lemniscate path
            carouselCards.forEach((card, idx) => {
                const ratio = idx / 54;
                // Add scroll offset to animate movement
                const t = ratio * 2 * Math.PI + currentCarouselScrollOffset * 2 * Math.PI;
                
                const pos = getLemniscatePosition(t, 2.0);
                card.position.set(pos.x, pos.y, pos.z);
                
                // Cards face camera
                card.lookAt(cCamera.position);
            });

            // Find card closest to front camera (z axis maximum, closest to cCamera.position)
            let closestIdx = -1;
            let minDistance = Infinity;
            carouselCards.forEach(card => {
                const dist = card.position.distanceTo(cCamera.position);
                if (dist < minDistance) {
                    minDistance = dist;
                    closestIdx = card.userData.index;
                }
            });

            // Highlight closest card and dim others
            if (closestIdx !== -1) {
                carouselCards.forEach((card, idx) => {
                    if (idx === closestIdx) {
                        card.material.opacity = 1.0;
                        card.scale.set(1.25, 1.25, 1.25);
                    } else {
                        card.material.opacity = 0.35; // dim background cards
                        card.scale.set(1.0, 1.0, 1.0);
                    }
                });

                if (closestIdx !== lastActiveIdx) {
                    lastActiveIdx = closestIdx;
                    updateActiveCarouselItemUI(closestIdx);
                }
            }

            // Continuous background rotation
            cGroup.rotation.y = Math.sin(performance.now() * 0.0001) * 0.12;

            cRenderer.render(cScene, cCamera);
        }

        window.openActiveCarouselItem = function() {
            if (currentProjectorMode === 'projector') {
                openLightbox(projectorActiveIdx);
            } else {
                if (lastActiveIdx !== -1) {
                    window.openLightbox(lastActiveIdx);
                }
            }
        };

        // --- CIRCLE VIDEO PROJECTOR LOGIC ---
        let currentProjectorMode = 'carousel';
        let projectorActiveIdx = 0;

        window.switchGalleryView = function(mode) {
            currentProjectorMode = mode;
            const carouselContainer = document.getElementById('carousel-3d-container');
            const projectorContainer = document.getElementById('projector-view-container');
            const inspectBtn = document.getElementById('inspect-active-btn');
            
            const btnCarousel = document.getElementById('btn-view-carousel');
            const btnProjector = document.getElementById('btn-view-projector');
            const titleEl = document.getElementById('gallery-view-mode-title');
            
            if (mode === 'projector') {
                carouselContainer.style.display = 'none';
                projectorContainer.style.display = 'block';
                titleEl.innerText = "Circle Video Projector";
                btnCarousel.classList.remove('active-layer');
                btnProjector.classList.add('active-layer');
                inspectBtn.innerText = "🔬 DECODE PROJECTED TELEMETRY";
                initProjectorUI();
            } else {
                carouselContainer.style.display = 'block';
                projectorContainer.style.display = 'none';
                titleEl.innerText = "Infinity Carousel Train";
                btnCarousel.classList.add('active-layer');
                btnProjector.classList.remove('active-layer');
                inspectBtn.innerText = "🔬 DECODE TELEMETRY";
                if (lastActiveIdx !== -1) {
                    updateActiveCarouselItemUI(lastActiveIdx);
                }
            }
        };

        function initProjectorUI() {
            const slotsContainer = document.getElementById('projector-slots-container');
            const svg = document.getElementById('projector-svg');
            if (!slotsContainer || !svg) return;
            
            slotsContainer.innerHTML = '';
            svg.innerHTML = '';
            
            const rect = slotsContainer.getBoundingClientRect();
            const cx = rect.width / 2 || 190;
            const cy = rect.height / 2 || 190;
            const radius = 125;
            
            // Draw Concentric Orbit Rings in SVG
            for (let r = 50; r <= 150; r += 45) {
                const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                circle.setAttribute('cx', cx);
                circle.setAttribute('cy', cy);
                circle.setAttribute('r', r);
                circle.setAttribute('fill', 'none');
                circle.setAttribute('stroke', 'rgba(0, 229, 255, 0.08)');
                circle.setAttribute('stroke-width', '1');
                if (r === 95) {
                    circle.setAttribute('stroke-dasharray', '4, 4');
                }
                svg.appendChild(circle);
            }

            // Draw Sweep Radar Line
            const radarLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            radarLine.setAttribute('x1', cx);
            radarLine.setAttribute('y1', cy);
            radarLine.setAttribute('x2', cx + radius);
            radarLine.setAttribute('y2', cy);
            radarLine.setAttribute('stroke', 'rgba(0, 229, 255, 0.25)');
            radarLine.setAttribute('stroke-width', '1.5');
            
            const anim = document.createElementNS('http://www.w3.org/2000/svg', 'animateTransform');
            anim.setAttribute('attributeName', 'transform');
            anim.setAttribute('type', 'rotate');
            anim.setAttribute('from', `0 ${cx} ${cy}`);
            anim.setAttribute('to', `360 ${cx} ${cy}`);
            anim.setAttribute('dur', '10s');
            anim.setAttribute('repeatCount', 'indefinite');
            radarLine.appendChild(anim);
            
            svg.appendChild(radarLine);
            
            // Generate slots for the 6 artworkSeeds
            artworkSeeds.forEach((seed, idx) => {
                const angle = (idx / artworkSeeds.length) * Math.PI * 2 - Math.PI / 2;
                const sx = cx + Math.cos(angle) * radius;
                const sy = cy + Math.sin(angle) * radius;
                
                // 1. Create Div Slot Node
                const slot = document.createElement('div');
                slot.className = `projector-slot ${idx === projectorActiveIdx ? 'active-slot' : ''}`;
                slot.style.left = `${sx}px`;
                slot.style.top = `${sy}px`;
                slot.setAttribute('data-idx', idx);
                
                slot.innerHTML = `
                    <div class="projector-img-wrapper" style="width: 44px; height: 44px; border-radius: 50%; overflow: hidden; border: 1.5px solid rgba(0, 229, 255, 0.25); display: flex; align-items: center; justify-content: center; background: #000; box-shadow: 0 0 8px rgba(0, 229, 255, 0.1); transition: all 0.3s ease;">
                        <img src="${seed.img}" style="width: 100%; height: 100%; object-fit: cover;" />
                    </div>
                    <span class="projector-slot-title" style="margin-top: 6px;">${seed.title.split(' - ')[0]}</span>
                `;
                
                slot.addEventListener('click', () => selectProjectorSlot(idx));
                slotsContainer.appendChild(slot);
                
                // 2. Draw Connector Line (Default low opacity)
                const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                line.setAttribute('id', `projector-ray-${idx}`);
                line.setAttribute('x1', cx);
                line.setAttribute('y1', cy);
                line.setAttribute('x2', sx);
                line.setAttribute('y2', sy);
                line.setAttribute('stroke', idx === projectorActiveIdx ? 'rgba(0,229,255,0.6)' : 'rgba(255,255,255,0.06)');
                line.setAttribute('stroke-width', idx === projectorActiveIdx ? '2' : '1');
                if (idx === projectorActiveIdx) {
                    line.setAttribute('stroke-dasharray', '3, 3');
                }
                svg.appendChild(line);
            });
            
            selectProjectorSlot(projectorActiveIdx, false);
        }

        window.selectProjectorSlot = function(idx, playSound = true) {
            projectorActiveIdx = idx;
            localStorage.setItem('quest_projector_calibrated', 'completed');
            
            // Highlight Slot in HTML
            document.querySelectorAll('.projector-slot').forEach(slot => {
                if (parseInt(slot.getAttribute('data-idx')) === idx) {
                    slot.classList.add('active-slot');
                } else {
                    slot.classList.remove('active-slot');
                }
            });
            
            // Highlight Ray in SVG
            const slotsContainer = document.getElementById('projector-slots-container');
            if (slotsContainer) {
                const rect = slotsContainer.getBoundingClientRect();
                const cx = rect.width / 2 || 190;
                const cy = rect.height / 2 || 190;
                
                artworkSeeds.forEach((_, i) => {
                    const line = document.getElementById(`projector-ray-${i}`);
                    if (line) {
                        if (i === idx) {
                            line.setAttribute('stroke', 'var(--accent)');
                            line.setAttribute('stroke-width', '2');
                            line.setAttribute('stroke-dasharray', '2, 2');
                        } else {
                            line.setAttribute('stroke', 'rgba(255,255,255,0.06)');
                            line.setAttribute('stroke-width', '1');
                            line.removeAttribute('stroke-dasharray');
                        }
                    }
                });
            }
            
            // Sync with Player
            if (playSound) {
                selectTrack(idx);
            }
            
            // Update Carousel HUD Telemetry Overlay
            const seed = artworkSeeds[idx];
            document.getElementById('active-item-title').innerText = `PROJECTED: ${seed.title.toUpperCase()}`;
            document.getElementById('active-item-desc').innerText = `[Calibrated Holographic Mode] ` + seed.desc;
            document.getElementById('active-counter').innerText = `PROJECTOR SLOT #${idx + 1}`;
        };

        window.pulseProjector = function() {
            localStorage.setItem('quest_projector_calibrated', 'completed');
            const lens = document.getElementById('projector-core-lens');
            if (lens) {
                lens.style.boxShadow = '0 0 45px var(--accent)';
                setTimeout(() => {
                    lens.style.boxShadow = '0 0 25px var(--accent-glow)';
                }, 3000);
            }
            if (audioCtx) {
                playArpeggioTrack();
            }
        };

        window.addEventListener('resize', () => {
            if (currentProjectorMode === 'projector') {
                initProjectorUI();
            }
        });

        // Initialize WebGL scenes
        selectTrack(0);
        
        setTimeout(() => {
            init3DVisualizerMenu();
            init3DBg();
            init3DCarousel();
        }, 100);
    </script>
</body>
