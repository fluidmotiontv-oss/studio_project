    <script>
        const canvas = document.getElementById('aurora');
        const ctx = canvas.getContext('2d');
        let width = 0;
        let height = 0;
        let frame = 0;

        function resize() {
            width = canvas.width = window.innerWidth * devicePixelRatio;
            height = canvas.height = window.innerHeight * devicePixelRatio;
            ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
        }

        function draw() {
            const w = window.innerWidth;
            const h = window.innerHeight;
            ctx.clearRect(0, 0, w, h);

            const gradient = ctx.createRadialGradient(w * 0.25, h * 0.2, 40, w * 0.25, h * 0.2, 360);
            gradient.addColorStop(0, 'rgba(255, 179, 71, 0.18)');
            gradient.addColorStop(1, 'rgba(255, 179, 71, 0)');
            ctx.fillStyle = gradient;
            ctx.beginPath();
            ctx.arc(w * 0.25, h * 0.2, 360, 0, Math.PI * 2);
            ctx.fill();

            const gradient2 = ctx.createRadialGradient(w * 0.78, h * 0.14, 30, w * 0.78, h * 0.14, 320);
            gradient2.addColorStop(0, 'rgba(61, 220, 255, 0.22)');
            gradient2.addColorStop(1, 'rgba(61, 220, 255, 0)');
            ctx.fillStyle = gradient2;
            ctx.beginPath();
            ctx.arc(w * 0.78, h * 0.14, 320, 0, Math.PI * 2);
            ctx.fill();

            ctx.strokeStyle = 'rgba(255,255,255,0.06)';
            ctx.lineWidth = 1;
            for (let i = 0; i < 7; i++) {
                const y = (h / 8) * (i + 1);
                ctx.beginPath();
                ctx.moveTo(0, y + Math.sin(frame / 40 + i) * 20);
                ctx.quadraticCurveTo(w * 0.25, y + Math.cos(frame / 55 + i) * 18, w * 0.5, y + Math.sin(frame / 70 + i) * 12);
                ctx.quadraticCurveTo(w * 0.75, y + Math.cos(frame / 45 + i) * 16, w, y + Math.sin(frame / 60 + i) * 15);
                ctx.stroke();
            }

            frame += 1;
            requestAnimationFrame(draw);
        }

        const portals = [
            { key: 'creative', label: 'Creative', url: 'creative.html', line: '// Creative gateway selected<br>// Instrument and visual paths online' },
            { key: 'systems', label: 'Systems', url: 'systems.html', line: '// Systems bridge selected<br>// Ledger and telemetry paths online' },
            { key: 'radio', label: 'Radio', url: 'radio/index.html', line: '// Broadcast node selected<br>// Live signal routing engaged' }
        ];

        const moodProfiles = {
            Luminous: { signal: 98, latency: 14, line: '// Atmosphere tuned to luminous<br>// Signal lattice recalibrated<br>// Motion vectors harmonized', accent: '#ffb347', accent2: '#ff4d6d', cyan: '#3ddcff', green: '#58f5a4', harmonic: '0.93', resonance: '1.12', bridge: 'Stable' },
            Radiant: { signal: 94, latency: 18, line: '// Radiant field active<br>// Glow channels widened<br>// Horizons aligned', accent: '#ffe066', accent2: '#ff66c4', cyan: '#00f7ff', green: '#8ef7c1', harmonic: '0.96', resonance: '1.08', bridge: 'Bright' },
            Sovereign: { signal: 96, latency: 12, line: '// Sovereign pulse online<br>// Core nodes synchronized<br>// Broadcast authority stable', accent: '#7cf0ff', accent2: '#6f7dff', cyan: '#77f0ff', green: '#8effc1', harmonic: '0.98', resonance: '1.15', bridge: 'Locked' }
        };

        let currentMood = 'Luminous';
        let activePortal = 'creative';

        function applyTheme(profile) {
            document.documentElement.style.setProperty('--accent', profile.accent);
            document.documentElement.style.setProperty('--accent-2', profile.accent2);
            document.documentElement.style.setProperty('--cyan', profile.cyan);
            document.documentElement.style.setProperty('--green', profile.green);
            document.getElementById('statusChip').style.borderColor = `rgba(255,255,255,0.12)`;
        }

        function renderBars(profile) {
            const container = document.getElementById('signalBars');
            if (!container) return;
            container.innerHTML = '';
            for (let i = 0; i < 12; i++) {
                const bar = document.createElement('div');
                bar.className = 'signal-bar';
                const height = 16 + ((i + 1) % 5) * 12 + Math.sin((i + 1) * 0.7 + Date.now() / 500) * 8;
                bar.style.height = `${Math.max(16, height)}%`;
                bar.style.opacity = `${0.65 + (i % 4) * 0.08}`;
                container.appendChild(bar);
            }
        }

        function renderPortalSwitcher() {
            const container = document.getElementById('portalSwitcher');
            if (!container) return;
            container.innerHTML = '';
            portals.forEach(portal => {
                const button = document.createElement('button');
                button.className = `portal-pill${portal.key === activePortal ? ' active' : ''}`;
                button.textContent = portal.label;
                button.onclick = () => switchPortal(portal.key);
                container.appendChild(button);
            });
        }

        function switchPortal(key) {
            activePortal = key;
            const portal = portals.find(item => item.key === key);
            if (portal) {
                document.getElementById('coreReadout').innerHTML = portal.line;
                document.getElementById('bridgeMetric').textContent = portal.label;
                document.getElementById('statusChip').textContent = portal.label.toUpperCase();
                renderPortalSwitcher();
            }
        }

        function renderState(profile) {
            document.getElementById('signalValue').textContent = `${profile.signal}%`;
            document.getElementById('latencyValue').textContent = `${profile.latency}ms`;
            document.getElementById('moodValue').textContent = currentMood;
            document.getElementById('coreReadout').innerHTML = profile.line;
            document.getElementById('harmonicMetric').textContent = profile.harmonic;
            document.getElementById('resonanceMetric').textContent = profile.resonance;
            document.getElementById('bridgeMetric').textContent = profile.bridge;
            applyTheme(profile);
            renderBars(profile);
            renderPortalSwitcher();
        }

        function setMood(value) {
            currentMood = value;
            renderState(moodProfiles[value] || moodProfiles.Luminous);
        }

        function activateModule(module) {
            const profile = moodProfiles[currentMood] || moodProfiles.Luminous;
            document.getElementById('coreReadout').innerHTML = `// ${module} module engaged<br>// ${currentMood} field active<br>// Experience flow accelerated`;
            document.getElementById('signalValue').textContent = `${Math.min(profile.signal + 2, 100)}%`;
            document.getElementById('latencyValue').textContent = `${Math.max(profile.latency - 1, 8)}ms`;
            renderBars(profile);
        }

        setInterval(() => {
            const keys = Object.keys(moodProfiles);
            const next = keys[(keys.indexOf(currentMood) + 1) % keys.length];
            currentMood = next;
            renderState(moodProfiles[next]);
        }, 6000);

        window.addEventListener('resize', resize);
        resize();
        draw();
        renderState(moodProfiles.Luminous);
        renderPortalSwitcher();
    </script>
</body>
</html>
</file>

