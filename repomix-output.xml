    <!-- Physics & Sound Script -->
    <script>
        const canvas = document.getElementById('plasma-canvas');
        const ctx = canvas.getContext('2d');

        // Parameters
        let params = {
            arcs: 12,
            complexity: 4,
            width: 1.5,
            glow: 12,
            colorHue: 190, // Blue Godzilla default
            colorSat: 100,
            colorLight: 50,
            emf: false,
            clockSync: true,
            audioSync: false,
            audioLevel: 0,
            mascot: false
        };

        // Presets configuration
        const presets = {
            godzilla: { arcs: 14, complexity: 4, width: 1.5, colorHue: 190, colorSat: 100, colorLight: 50, name: 'Godzilla Atomic Blue' },
            dragon: { arcs: 10, complexity: 3, width: 2.0, colorHue: 25, colorSat: 100, colorLight: 50, name: 'Dragon Fire Amber' },
            kong: { arcs: 8, complexity: 5, width: 1.2, colorHue: 285, colorSat: 100, colorLight: 50, name: 'Kong Primal Violet' }
        };

        // State variables
        let mouse = { x: 0, y: 0, isDown: false, inside: false };
        let sphere = { x: 0, y: 0, radius: 220, innerRadius: 28 };
        let rotationTime = 0;

        // Web Audio components
        let audioCtx = null;
        let analyser = null;
        let microphone = null;
        let oscillator = null;
        let oscGain = null;
        let audioDataArray = null;

        // Auto-sizing & Fullscreen Mode State
        let isFullscreen = false;

        function resizeCanvas() {
            const container = canvas.parentElement;
            const maxVal = isFullscreen ? 1200 : 500;
            const size = Math.min(container.clientWidth - 40, container.clientHeight - 40, maxVal);
            canvas.width = size;
            canvas.height = size;
            sphere.x = size / 2;
            sphere.y = size / 2;
            sphere.radius = size * 0.44;
            sphere.innerRadius = size * 0.06;
        }

        function toggleFullscreen() {
            const container = document.querySelector('.canvas-container');
            isFullscreen = !isFullscreen;

            if (isFullscreen) {
                container.classList.add('fullscreen-mode');
                document.getElementById('fullscreen-toggle').textContent = "📺 Normal";
                if (container.requestFullscreen) {
                    container.requestFullscreen().catch(() => {});
                }
            } else {
                container.classList.remove('fullscreen-mode');
                document.getElementById('fullscreen-toggle').textContent = "📺 Fullscreen";
                if (document.exitFullscreen && document.fullscreenElement) {
                    document.exitFullscreen().catch(() => {});
                }
            }
            setTimeout(resizeCanvas, 60);
        }

        document.addEventListener('fullscreenchange', () => {
            const container = document.querySelector('.canvas-container');
            if (!document.fullscreenElement) {
                isFullscreen = false;
                container.classList.remove('fullscreen-mode');
                document.getElementById('fullscreen-toggle').textContent = "📺 Fullscreen";
                resizeCanvas();
            }
        });

        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // Mouse tracking
        function getMousePos(e) {
            const rect = canvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            mouse.x = clientX - rect.left;
            mouse.y = clientY - rect.top;
            
            // Check distance
            const dx = mouse.x - sphere.x;
            const dy = mouse.y - sphere.y;
            const dist = Math.sqrt(dx*dx + dy*dy);
            mouse.inside = dist <= sphere.radius + 15;
        }

        canvas.addEventListener('mousemove', getMousePos);
        canvas.addEventListener('mousedown', (e) => { mouse.isDown = true; getMousePos(e); });
        window.addEventListener('mouseup', () => { mouse.isDown = false; });
        
        canvas.addEventListener('touchmove', getMousePos);
        canvas.addEventListener('touchstart', (e) => { mouse.isDown = true; getMousePos(e); });
        window.addEventListener('touchend', () => { mouse.isDown = false; });

        // Preset Apply
        function applyPreset(type) {
            const preset = presets[type];
            if (!preset) return;

            document.querySelectorAll('.preset-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById(`preset-${type}`).classList.add('active');

            params.arcs = preset.arcs;
            params.complexity = preset.complexity;
            params.width = preset.width;
            params.colorHue = preset.colorHue;
            params.colorSat = preset.colorSat;
            params.colorLight = preset.colorLight;

            // Update DOM sliders
            document.getElementById('slider-arcs').value = preset.arcs;
            document.getElementById('val-arcs').innerText = preset.arcs;
            document.getElementById('slider-complexity').value = preset.complexity;
            document.getElementById('val-complexity').innerText = preset.complexity;
            document.getElementById('slider-width').value = preset.width;
            document.getElementById('val-width').innerText = preset.width;

            // Apply custom accent theme variables to document
            const accentVal = `hsl(${preset.colorHue}, ${preset.colorSat}%, ${preset.colorLight}%)`;
            const glowVal = `hsla(${preset.colorHue}, ${preset.colorSat}%, ${preset.colorLight}%, 0.25)`;
            document.documentElement.style.setProperty('--accent', accentVal);
            document.documentElement.style.setProperty('--accent-glow', glowVal);
        }

        function updateParam(name, val) {
            params[name] = parseFloat(val);
            document.getElementById(`val-${name}`).innerText = val;
        }

        // Toggles
        function toggleEMF() {
            params.emf = !params.emf;
            const btn = document.getElementById('emf-toggle');
            btn.classList.toggle('active', params.emf);
            document.getElementById('emf-status').innerText = params.emf ? 'ON' : 'OFF';
        }

        function toggleClockSync() {
            params.clockSync = !params.clockSync;
            const btn = document.getElementById('clock-sync-toggle');
            btn.classList.toggle('active', params.clockSync);
            document.getElementById('sync-status').innerText = params.clockSync ? 'ON' : 'OFF';
            document.getElementById('clock-indicator').style.display = params.clockSync ? 'flex' : 'none';
        }

        function toggleMascot() {
            params.mascot = !params.mascot;
            const btn = document.getElementById('mascot-toggle');
            btn.classList.toggle('active', params.mascot);
            document.getElementById('mascot-status').innerText = params.mascot ? 'ON' : 'OFF';
        }

        // D9 Clock checks
        function getDragonNineMode() {
            const date = new Date();
            // Let's assume global parent synchronization if running inside workspace iframe
            let drift = 0;
            try {
                if (window.parent && window.parent.timeDriftOffset) {
                    drift = window.parent.timeDriftOffset;
                }
            } catch (e) {}

            const utc = date.getTime() + drift + (date.getTimezoneOffset() * 60000);
            const nzTime = new Date(utc + (3600000 * 12)); // NZ standard offset
            const totalSeconds = (nzTime.getHours() * 3600) + (nzTime.getMinutes() * 60) + nzTime.getSeconds();
            const isRelax = (totalSeconds < 540) || (totalSeconds >= 42660 && totalSeconds < 43740) || (totalSeconds >= 85860);
            return isRelax ? 'relax' : 'active';
        }

        // Fractal recursive lightning builder
        function drawFractalLine(x1, y1, x2, y2, displace, minSize, ctx, upwardBias) {
            if (displace < minSize) {
                ctx.lineTo(x2, y2);
            } else {
                const mid_x = (x1 + x2) / 2;
                const mid_y = (y1 + y2) / 2 - (upwardBias * displace * 0.15); // Add slight drift upward
                
                // Shift perpendicular
                const dx = x2 - x1;
                const dy = y2 - y1;
                const len = Math.sqrt(dx * dx + dy * dy);
                const nx = -dy / len;
                const ny = dx / len;
                const offset = (Math.random() - 0.5) * displace;
                
                const mx = mid_x + nx * offset;
                const my = mid_y + ny * offset;
                
                drawFractalLine(x1, y1, mx, my, displace / 2, minSize, ctx, upwardBias);
                drawFractalLine(mx, my, x2, y2, displace / 2, minSize, ctx, upwardBias);
            }
        }

        // Render loop
        function draw() {
            // Check D9 time sync modulation
            let currentMode = 'active';
            if (params.clockSync) {
                currentMode = getDragonNineMode();
                const indicator = document.getElementById('clock-indicator');
                const dot = document.getElementById('indicator-dot');
                const label = document.getElementById('indicator-text');
                
                if (currentMode === 'relax') {
                    label.innerText = 'D9 CLOCK: RELAX MODE';
                    dot.style.background = '#ffaa00';
                    indicator.style.borderColor = '#ffaa00';
                    indicator.style.boxShadow = '0 0 10px rgba(255, 170, 0, 0.25)';
                } else {
                    label.innerText = 'D9 CLOCK: ACTIVE (FOCUS)';
                    dot.style.background = 'var(--accent)';
                    indicator.style.borderColor = 'var(--accent)';
                    indicator.style.boxShadow = '0 0 10px var(--accent-glow)';
                }
            }

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Read audio analyser data if active
            let audioAmp = 0;
            if (params.audioSync && analyser) {
                analyser.getByteFrequencyData(audioDataArray);
                let sum = 0;
                for (let i = 0; i < audioDataArray.length; i++) {
                    sum += audioDataArray[i];
                }
                audioAmp = sum / audioDataArray.length / 255; // Normalized amplitude 0 to 1
            }

            // Draw outer glass sphere boundary
            ctx.strokeStyle = currentMode === 'relax' ? 'rgba(255, 170, 0, 0.2)' : 'rgba(0, 229, 255, 0.15)';
            ctx.lineWidth = 2;
            ctx.shadowBlur = 8;
            ctx.shadowColor = currentMode === 'relax' ? '#ffaa00' : 'var(--accent)';
            ctx.beginPath();
            ctx.arc(sphere.x, sphere.y, sphere.radius, 0, Math.PI * 2);
            ctx.stroke();
            ctx.shadowBlur = 0;

            // Draw Central Electrode Core
            const coreGrad = ctx.createRadialGradient(sphere.x, sphere.y, 2, sphere.x, sphere.y, sphere.innerRadius);
            const coreHue = currentMode === 'relax' ? 35 : params.colorHue;
            coreGrad.addColorStop(0, '#ffffff');
            coreGrad.addColorStop(0.3, `hsl(${coreHue}, 100%, 75%)`);
            coreGrad.addColorStop(1, `hsl(${coreHue}, 100%, 25%)`);
            ctx.fillStyle = coreGrad;
            ctx.beginPath();
            ctx.arc(sphere.x, sphere.y, sphere.innerRadius, 0, Math.PI * 2);
            ctx.fill();

            // Modulate parameters based on D9 clock mode
            let targetArcs = params.arcs;
            let targetComplexity = params.complexity;
            let targetDisplacement = 60 + (audioAmp * 120);
            
            if (currentMode === 'relax') {
                targetArcs = Math.max(1, Math.floor(params.arcs * 0.2)); // few filaments
                targetComplexity = Math.max(2, params.complexity - 1); // simpler arcing
                targetDisplacement = 40; // lower activity
            }

            // Draw Filaments
            rotationTime += params.emf ? 0.015 : 0.003;

            for (let i = 0; i < targetArcs; i++) {
                // Angle and target boundaries
                const baseAngle = (i * (Math.PI * 2) / targetArcs) + rotationTime;
                
                let targetX, targetY;
                let converge = false;

                // Mouse influence converges arcs to mouse coordinate if inside globe
                if (mouse.inside && (mouse.isDown || Math.random() < 0.6)) {
                    const mouseDx = mouse.x - sphere.x;
                    const mouseDy = mouse.y - sphere.y;
                    const mouseDist = Math.sqrt(mouseDx*mouseDx + mouseDy*mouseDy);
                    
                    // Converge arcing to the outer edge closest to the mouse pointer
                    const targetAngle = Math.atan2(mouseDy, mouseDx);
                    
                    // Distribute targets slightly around mouse location
                    const spread = (Math.random() - 0.5) * 0.15;
                    targetX = sphere.x + sphere.radius * Math.cos(targetAngle + spread);
                    targetY = sphere.y + sphere.radius * Math.sin(targetAngle + spread);
                    converge = true;
                } else {
                    targetX = sphere.x + sphere.radius * Math.cos(baseAngle);
                    targetY = sphere.y + sphere.radius * Math.sin(baseAngle);
                }

                // Emitter start point
                const startX = sphere.x + sphere.innerRadius * Math.cos(baseAngle);
                const startY = sphere.y + sphere.innerRadius * Math.sin(baseAngle);

                // Setup arcing path
                ctx.beginPath();
                ctx.moveTo(startX, startY);

                // Midpoint displacement arcing
                const minSegSize = 10 - targetComplexity;
                const displace = targetDisplacement;

                // Upward convection/drift bias
                const upwardBias = 0.5; 

                // Draw arcing line path
                if (params.emf) {
                    // Spiral/containment math: generate midpoints along a curve
                    const steps = 10;
                    let lastX = startX;
                    let lastY = startY;
                    for (let j = 1; j <= steps; j++) {
                        const t = j / steps;
                        
                        // Linear interpolation
                        let lx = startX + (targetX - startX) * t;
                        let ly = startY + (targetY - startY) * t;
                        
                        // Apply spiral swirl rotation offset
                        const spiralOffset = Math.sin(t * Math.PI) * 28 * Math.cos(rotationTime * 1.5);
                        const angleOffset = Math.atan2(ly - sphere.y, lx - sphere.x) + (t * 0.45);
                        const rad = Math.sqrt((lx - sphere.x)**2 + (ly - sphere.y)**2);
                        
                        lx = sphere.x + rad * Math.cos(angleOffset);
                        ly = sphere.y + rad * Math.sin(angleOffset);

                        // Add small electrical jiggle
                        lx += (Math.random() - 0.5) * 6;
                        ly += (Math.random() - 0.5) * 6;

                        ctx.lineTo(lx, ly);
                        lastX = lx;
                        lastY = ly;
                    }
                } else {
                    drawFractalLine(startX, startY, targetX, targetY, displace, minSegSize, ctx, upwardBias);
                }

                // Draw outer filament glow line
                const filamentHue = currentMode === 'relax' ? 30 + (i*10) : params.colorHue + (i * 2);
                ctx.strokeStyle = `hsla(${filamentHue}, ${params.colorSat}%, ${params.colorLight}%, 0.35)`;
                ctx.lineWidth = params.width * (converge ? 2 : 1.2) + (audioAmp * 4);
                ctx.shadowBlur = params.glow + (audioAmp * 10);
                ctx.shadowColor = `hsl(${filamentHue}, 100%, 50%)`;
                ctx.stroke();

                // Draw inner bright core filament line
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = params.width * 0.35 + (audioAmp * 0.5);
                ctx.shadowBlur = 0;
                ctx.stroke();

                // Terminating outer discharge spark point
                ctx.fillStyle = `hsl(${filamentHue}, 100%, 65%)`;
                ctx.beginPath();
                ctx.arc(targetX, targetY, 3 + Math.random() * 3, 0, Math.PI * 2);
                ctx.fill();
            }

            requestAnimationFrame(draw);
        }

        // Initialize Loop
        draw();

        // Web Audio Utilities
        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                analyser = audioCtx.createAnalyser();
                analyser.fftSize = 256;
                audioDataArray = new Uint8Array(analyser.frequencyBinCount);
            }
        }

        function toggleAudioInput() {
            initAudio();
            const btn = document.getElementById('audio-input-toggle');

            if (!params.audioSync) {
                navigator.mediaDevices.getUserMedia({ audio: true, video: false })
                    .then(stream => {
                        microphone = audioCtx.createMediaStreamSource(stream);
                        microphone.connect(analyser);
                        params.audioSync = true;
                        btn.classList.add('active');
                        btn.querySelector('span').innerText = 'ON';
                    })
                    .catch(err => {
                        alert("Microphone access denied or unavailable.");
                        console.error(err);
                    });
            } else {
                if (microphone) {
                    microphone.disconnect();
                    microphone = null;
                }
                params.audioSync = false;
                btn.classList.remove('active');
                btn.querySelector('span').innerText = 'OFF';
            }
        }

        function toggleSynthTone() {
            initAudio();
            const btn = document.getElementById('tone-btn');
            const controls = document.getElementById('synth-controls');

            if (!oscillator) {
                oscillator = audioCtx.createOscillator();
                oscGain = audioCtx.createGain();
                
                oscillator.type = 'sine';
                oscillator.frequency.value = parseFloat(document.getElementById('slider-freq').value);
                
                oscGain.gain.setValueAtTime(0.04, audioCtx.currentTime); // low volume
                
                oscillator.connect(oscGain);
                oscGain.connect(analyser);
                oscGain.connect(audioCtx.destination);
                
                oscillator.start();
                
                btn.innerText = "🔊 Disable Test Frequency";
                btn.style.borderColor = "var(--highlight)";
                btn.style.boxShadow = "0 0 10px var(--highlight-glow)";
                controls.style.display = "block";
            } else {
                oscillator.stop();
                oscillator.disconnect();
                oscillator = null;
                oscGain.disconnect();
                oscGain = null;
                
                btn.innerText = "🔊 Enable Test Frequency";
                btn.style.borderColor = "rgba(255,255,255,0.08)";
                btn.style.boxShadow = "none";
                controls.style.display = "none";
            }
        }

        function updateToneFreq(val) {
            if (oscillator) {
                oscillator.frequency.value = parseFloat(val);
            }
            document.getElementById('val-freq').innerText = `${val} Hz`;
        }
    </script>
</body>
</html>
