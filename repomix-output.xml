                <span style="font-size:0.55rem; color:var(--gold);">90/10 RULE</span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-family:'Share Tech Mono'; font-size:0.58rem; border-bottom:1px solid rgba(255,255,255,0.06); padding-bottom:12px;">
                <div>PORTAL UPKEEP FEE:<br><span style="font-size:0.8rem; color:#fff;" id="upkeep-balance">◈ 0.00</span></div>
                <div>ECO SYSTEM VIEWS:<br><span style="font-size:0.8rem; color:#fff;" id="views-counter">124</span></div>
            </div>

            <div class="ledger-list" id="ledger-list-box">
                <!-- Log entries populated by JS -->
            </div>

            <button class="action-btn" style="background:transparent; border: 1px solid rgba(255,255,255,0.1); color:var(--text-muted); font-size:0.55rem;" onclick="resetWalletStorage()">Reset Ledger Data</button>
        </div>

