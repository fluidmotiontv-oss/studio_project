        body.play-mode-active .left-sidebar {
            transform: translateX(-120%);
            opacity: 0;
            pointer-events: none;
        }
        body.play-mode-active .right-sidebar {
            transform: translateX(120%);
            opacity: 0;
            pointer-events: none;
        }
        body.play-mode-active .sequencer-panel {
            transform: translateY(120%);
            opacity: 0;
            pointer-events: none;
        }
        body.play-mode-active .bottom-bar {
            transform: translateY(140%);
            opacity: 0;
            pointer-events: none;
        }
        body.play-mode-active .btn-play-mode {
            bottom: 30px; /* reposition close to bottom */
        }
        @keyframes pulse-red {
            0% { box-shadow: 0 0 4px rgba(255, 0, 127, 0.2); }
            50% { box-shadow: 0 0 12px rgba(255, 0, 127, 0.6); }
            100% { box-shadow: 0 0 4px rgba(255, 0, 127, 0.2); }
        }
        .recording-pulse {
            animation: pulse-red 1.2s infinite;
        }

        /* PRO Modal Styling */
        .pro-modal {
            display: none;
            position: fixed;
            z-index: 99999;
            left: 0;
            top: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(2, 6, 23, 0.85);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            justify-content: center;
            align-items: center;
            pointer-events: auto;
        }
        .pro-modal-content {
            background: rgba(9, 13, 26, 0.9);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 20px;
            padding: 40px;
            max-width: 500px;
            width: 90%;
            text-align: center;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.8), 0 0 40px rgba(212, 175, 55, 0.2);
            position: relative;
            animation: modal-zoom 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes modal-zoom {
            from { transform: scale(0.9); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
        .pro-close {
            position: absolute;
            top: 15px;
            right: 20px;
            color: #94a3b8;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
            transition: color 0.3s;
        }
        .pro-close:hover {
            color: #fff;
        }
        .pro-modal h2 {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.8rem;
            color: #fff;
            margin-bottom: 10px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        .pro-modal h2 span {
            color: var(--gold-accent);
            text-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
        }
        .pro-upgrade-btn {
            font-family: 'Orbitron', sans-serif;
            font-weight: 700;
            letter-spacing: 1.5px;
            background: linear-gradient(135deg, var(--gold-accent), #b48a1d);
            color: #020617;
            border: none;
            padding: 14px 28px;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 20px;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
            width: 100%;
        }
        .pro-upgrade-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(212, 175, 55, 0.5);
            background: #fff;
            color: #000;
        }
    </style>
</head>
<body>
    <!-- Fluid background glow blobs -->
    <div class="fluid-bg">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
    </div>

    <!-- WebGL Canvas -->
    <div id="canvas-container"></div>

    <!-- Koha / Donate Modal -->
    <div id="pro-modal" class="pro-modal">
        <div class="pro-modal-content">
            <span class="pro-close" id="pro-close-btn">&times;</span>
            <h2>🎆 SUPPORT VIA <span>KOHA / DONATION</span></h2>
            <p style="margin: 15px 0; font-family: 'Inter', sans-serif; font-size: 0.85rem; color: #94a3b8; line-height: 1.6;">
                Unlock extra features to load custom samples, shape fireworks, and control master effects as a thank you for your support.
            </p>
            <ul style="text-align: left; margin: 15px auto; max-width: 380px; color: #cbd5e1; font-family: 'Inter', sans-serif; font-size: 0.8rem; display: flex; flex-direction: column; gap: 10px; list-style-type: none; padding-left: 0;">
                <li style="display: flex; gap: 10px; align-items: center;">📂 <span><strong>Custom Sample Loading</strong>: Load your own .wav/.mp3 beats into any pad.</span></li>
                <li style="display: flex; gap: 10px; align-items: center;">✨ <span><strong>Advanced Fireworks</strong>: Unlock Ghost Nebula and Supernova Flash styles.</span></li>
                <li style="display: flex; gap: 10px; align-items: center;">🎛️ <span><strong>High-Pass & Resonant Filters</strong>: Shape sweeps with advanced bandpass engines.</span></li>
