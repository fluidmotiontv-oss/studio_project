        function triggerShareLink() {
            const refLink = `${window.location.origin}${window.location.pathname}?ref=share_${Date.now()}`;
            navigator.clipboard.writeText(refLink);

            let hours = parseFloat(localStorage.getItem('d9_listening_hours') || '0.0');
