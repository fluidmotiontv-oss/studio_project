  AUDIO_BPM_CHANGE: 'audio:bpm:change',
  AUDIO_BEAT: 'audio:beat',
  AUDIO_PATTERN_CHANGE: 'audio:pattern:change',
  AUDIO_VOLUME_CHANGE: 'audio:volume:change',
