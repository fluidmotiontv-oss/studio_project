            border-radius: 6px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.65rem;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s;
        }
        .seq-btn:hover {
            border-color: var(--cyan-glow);
            color: var(--cyan-glow);
        }
        .seq-btn.active {
            background: rgba(0, 229, 255, 0.15);
            border-color: var(--cyan-glow);
            color: var(--cyan-glow);
