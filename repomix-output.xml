        let bgScene, bgCamera, bgRenderer, bgParticles1, bgParticles2;
        const bgContainer = document.getElementById('bg-canvas-container');
        const count = 160;
        const pOffsets1 = Array.from({length: count}, () => Math.random());
        const pOffsets2 = Array.from({length: count}, () => Math.random());

        function init3DBg() {
            bgScene = new THREE.Scene();
            bgCamera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 100);
            bgCamera.position.z = 8;

            bgRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            bgRenderer.setSize(window.innerWidth, window.innerHeight);
            bgRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            bgContainer.appendChild(bgRenderer.domElement);

            const makeGlowTexture = (colorStr) => {
                const canvas = document.createElement('canvas');
                canvas.width = 16;
                canvas.height = 16;
                const ctx = canvas.getContext('2d');
                const grad = ctx.createRadialGradient(8, 8, 0, 8, 8, 8);
                grad.addColorStop(0, '#fff');
                grad.addColorStop(0.3, colorStr);
                grad.addColorStop(1, 'transparent');
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, 16, 16);
                return new THREE.CanvasTexture(canvas);
            };

            const texCyan = makeGlowTexture('rgba(0, 229, 255, 0.6)');
            const texPink = makeGlowTexture('rgba(255, 0, 128, 0.6)');

            const geo1 = new THREE.BufferGeometry();
            const geo2 = new THREE.BufferGeometry();
            
            const positions1 = new Float32Array(count * 3);
            const positions2 = new Float32Array(count * 3);
            
            geo1.setAttribute('position', new THREE.BufferAttribute(positions1, 3));
            geo2.setAttribute('position', new THREE.BufferAttribute(positions2, 3));

            const mat1 = new THREE.PointsMaterial({
                size: 0.5,
                map: texCyan,
                transparent: true,
                blending: THREE.AdditiveBlending,
                depthWrite: false
            });

            const mat2 = new THREE.PointsMaterial({
                size: 0.5,
                map: texPink,
                transparent: true,
                blending: THREE.AdditiveBlending,
                depthWrite: false
            });

            bgParticles1 = new THREE.Points(geo1, mat1);
            bgParticles2 = new THREE.Points(geo2, mat2);
            
            bgScene.add(bgParticles1);
            bgScene.add(bgParticles2);

            window.addEventListener('resize', () => {
                if (!bgRenderer || !bgCamera) return;
                bgCamera.aspect = window.innerWidth / window.innerHeight;
                bgCamera.updateProjectionMatrix();
                bgRenderer.setSize(window.innerWidth, window.innerHeight);
            });

            animateBg3D();
        }

        function updateLemniscatePositions(offsets, positions, scale, isOffsetPhase) {
            const scaleX = scale * 1.5;
            const scaleY = scale * 0.7;
            const scaleZ = scale * 0.8;
            
            for (let i = 0; i < count; i++) {
                offsets[i] = (offsets[i] + 0.0004) % 1;
                
                const t = offsets[i] * 2 * Math.PI + (isOffsetPhase ? Math.PI : 0);
                const denom = 1 + Math.sin(t) * Math.sin(t);
                
                const x = (scaleX * Math.cos(t)) / denom;
                const z = (scaleZ * Math.sin(t) * Math.cos(t)) / denom;
                const y = Math.sin(t * 2) * scaleY;
                
                positions[i * 3] = x;
                positions[i * 3 + 1] = y;
                positions[i * 3 + 2] = z;
            }
        }

        function animateBg3D() {
            requestAnimationFrame(animateBg3D);

            const posAttr1 = bgParticles1.geometry.attributes.position;
            const posAttr2 = bgParticles2.geometry.attributes.position;

            updateLemniscatePositions(pOffsets1, posAttr1.array, 6.0, false);
            updateLemniscatePositions(pOffsets2, posAttr2.array, 6.0, true);

            posAttr1.needsUpdate = true;
            posAttr2.needsUpdate = true;

            const time = performance.now() * 0.00015;
            bgCamera.position.x = Math.sin(time) * 1.2;
            bgCamera.position.y = Math.cos(time * 0.7) * 1.2;
            bgCamera.lookAt(0, 0, 0);

            bgParticles1.rotation.y = time * 0.1;
            bgParticles2.rotation.y = time * 0.1;

            bgRenderer.render(bgScene, bgCamera);
        }


