            transition: all 0.3s;
        }
        .toggle-btn.active .indicator {
            background: var(--magenta-glow);
            box-shadow: 0 0 8px var(--magenta-glow);
        }

        /* Visual mappings */
        .key-map-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--glass-border);
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 0.7rem;
        }
        .key-badge {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: var(--cyan-glow);
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 700;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.65rem;
            box-shadow: 0 0 5px rgba(0, 229, 255, 0.15);
        }

        /* Sequencer (Bottom) */
        .sequencer-panel {
            grid-column: 1 / 4;
            grid-row: 3;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .seq-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .seq-title {
            font-family: 'Orbitron', sans-serif;
